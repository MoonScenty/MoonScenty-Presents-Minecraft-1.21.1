{
	chapter.1F13D457ABCA8E5A.title: "Tutorial"

quest.20A4AA9E260BD193.title: "So This Is Minecraft"
	quest.20A4AA9E260BD193.quest_desc: ["Welcome to MoonScenty Presents Minecraft. This book teaches the route without locking content."]

	quest.2848CD423C444B56.title: "Check Your Pockets"
	quest.2848CD423C444B56.quest_desc: ["Open the inventory with E and identify the armor slots, crafting grid and JEI item list."]

	quest.24BD4D58549E2AB9.title: "Quests Are Only a Guide"
	quest.24BD4D58549E2AB9.quest_desc: ["Quests explain goals and systems. Recipes and technology eras are controlled separately."]

	quest.21438F602D0CA906.title: "Look Up and Look Around"
	quest.21438F602D0CA906.quest_desc: ["Move with WASD, turn with the mouse and jump with Space."]

	quest.2B067B1F677E454B.title: "Start Punching Things"
	quest.2B067B1F677E454B.quest_desc: ["Hold the attack button until any block breaks."]

	quest.2D6274C3059DF1F6.title: "You Broke It, You Place It"
	quest.2D6274C3059DF1F6.quest_desc: ["Select a block on the hotbar and use it on a solid face."]

	quest.26ACDF5E4D0DBBB0.title: "When in Doubt, Ask JEI"
	quest.26ACDF5E4D0DBBB0.quest_desc: ["Use JEI to search items, recipes and uses. Check the configured recipe and usage keys."]

quest.23223152350FFF50.title: "Punching Trees Is a Feature"
	quest.23223152350FFF50.quest_desc: ["Break a tree and obtain any log. Bare hands are the intended opening tool."]

	quest.243E44363E4506BD.title: "Log Normalization"
	quest.243E44363E4506BD.quest_desc: ["Turn logs into at least four planks."]

	quest.2DD9C2FBCAD2FB64.title: "A Crafter Starts with a Table"
	quest.2DD9C2FBCAD2FB64.quest_desc: ["Craft a crafting table for the full crafting grid."]

	quest.2EC3C2890801629B.title: "Do Not Blame the Tool Yet"
	quest.2EC3C2890801629B.quest_desc: ["Craft a wooden pickaxe to obtain the first stone."]

	quest.29525BE6E014E9E8.title: "Stone, Returned"
	quest.29525BE6E014E9E8.quest_desc: ["Mine at least three cobblestone."]

	quest.28AE2D2D8046D748.title: "Qualified Lumberjack"
	quest.28AE2D2D8046D748.quest_desc: ["Craft a wooden axe for wood and early combat."]

	quest.26AFB3538EBB1ABB.title: "Professional Digging"
	quest.26AFB3538EBB1ABB.quest_desc: ["Craft a wooden shovel for dirt, sand and gravel."]

	quest.2C68BC2D558E0EF4.title: "Ready to Farm"
	quest.2C68BC2D558E0EF4.quest_desc: ["Craft a wooden hoe for farmland and organic blocks."]

	quest.25E74183A8B96E75.title: "Strictly Self-Defense"
	quest.25E74183A8B96E75.quest_desc: ["Craft a wooden sword if night comes before better materials."]

quest.28714DC98AC69692.title: "A Stone-Cold Upgrade"
	quest.28714DC98AC69692.quest_desc: ["Craft a stone pickaxe. It can mine iron ore."]

	quest.24CEDEA6921DB89F.title: "Negotiations Have Ended"
	quest.24CEDEA6921DB89F.quest_desc: ["Prepare either a stone sword or a stone axe."]

	quest.2B2542E435DBE263.title: "Can I Borrow a Fire?"
	quest.2B2542E435DBE263.quest_desc: ["Craft a furnace to cook food and smelt ore."]

	quest.247BF94E4EAD98F8.title: "Black Fuel Matters"
	quest.247BF94E4EAD98F8.quest_desc: ["Obtain coal or charcoal for fuel and torches."]

	quest.2C4AECE8B3560B0D.title: "Let There Be Light"
	quest.2C4AECE8B3560B0D.quest_desc: ["Craft torches and light the shelter and mine."]

	quest.2FB316E5CA0968CA.title: "An Army Marches on Its Stomach"
	quest.2FB316E5CA0968CA.quest_desc: ["Prepare cooked food before a long expedition."]

	quest.253986523F8632C9.title: "Look Before You Sleep"
	quest.253986523F8632C9.quest_desc: ["Craft any bed to skip night and set a respawn point."]

	quest.214BC51A55318E70.title: "First Night, Done Right"
	quest.214BC51A55318E70.quest_desc: ["Sleep in a bed or otherwise make it safely through the night."]

	quest.2B8D6AF946E6A047.title: "The Dream of Home Ownership"
	quest.2B8D6AF946E6A047.quest_desc: ["Build a small shelter with walls, roof and lighting."]

	quest.276210F28C8CD376.title: "Lock the Door"
	quest.276210F28C8CD376.quest_desc: ["Craft a door so the entrance can close safely."]

	quest.2AAAA6367C6F6333.title: "A Place for Everything"
	quest.2AAAA6367C6F6333.quest_desc: ["Craft a chest and store valuables before exploring."]

	quest.2BF79498183370C6.title: "Twice the Storage"
	quest.2BF79498183370C6.quest_desc: ["Place two compatible chests side by side and open the large chest."]

	quest.2ED76AED88E4D480.title: "A Room with a View"
	quest.2ED76AED88E4D480.quest_desc: ["Smelt sand into glass for a safe window."]

	quest.2DFA570C709DACC6.title: "Home Is Where the Waypoint Is"
	quest.2DFA570C709DACC6.quest_desc: ["Record the coordinates or create a Xaero waypoint."]

quest.2C95D7D3C915C4DE.title: "Too Hungry to Think"
	quest.2C95D7D3C915C4DE.quest_desc: ["Hunger limits sprinting and natural healing. Keep food on the hotbar."]

	quest.2843C8BB0B6A8C51.title: "Better When Cooked"
	quest.2843C8BB0B6A8C51.quest_desc: ["Carry a useful reserve of cooked food."]

	quest.29E0F676B8EDF5D4.title: "Food Is Medicine"
	quest.29E0F676B8EDF5D4.quest_desc: ["Natural regeneration consumes saturation and hunger."]

	quest.2D1F854A134D5D8B.title: "I Want to Go Home"
	quest.2D1F854A134D5D8B.quest_desc: ["Sleep again to confirm how a bed sets the respawn point."]

	quest.23C8FD0BE2812004.title: "Try Again, with a Corpse"
	quest.23C8FD0BE2812004.quest_desc: ["Corpse stores dropped inventory after death. Return prepared and recover it."]

	quest.28AA7B0C8DAB164A.title: "Never Dig Straight Down"
	quest.28AA7B0C8DAB164A.quest_desc: ["Use a staircase or safe two-block method to avoid lava and falls."]

	quest.2F679B2A0765D2ED.title: "Small Seed, Large Harvest"
	quest.2F679B2A0765D2ED.quest_desc: ["Obtain wheat seeds from grass or mature wheat."]

	quest.2C053EE4B2ADEA38.title: "Turn Over a New Leaf"
	quest.2C053EE4B2ADEA38.quest_desc: ["Use a hoe on dirt or grass to create farmland."]

	quest.25D50AE10F56F9F3.title: "Home-Grown Wheat"
	quest.25D50AE10F56F9F3.quest_desc: ["Grow and harvest mature wheat."]

	quest.282D4717D7E2BE05.title: "Let Them Eat Bread"
	quest.282D4717D7E2BE05.quest_desc: ["Craft bread from three wheat."]

	quest.2C58BD6BC3CA0781.title: "Water Knows the Answer"
	quest.2C58BD6BC3CA0781.quest_desc: ["Water hydrates farmland within four horizontal blocks."]

	quest.216D61608B2F3189.title: "Many Thanks, Potato"
	quest.216D61608B2F3189.quest_desc: ["Grow both potatoes and carrots, and replant part of the harvest."]

	quest.24A49531A3B800D3.title: "A Sweet Future"
	quest.24A49531A3B800D3.quest_desc: ["Grow sugar cane next to water for paper and rockets."]

	quest.2C77C6A1BBD32107.title: "Waste Not"
	quest.2C77C6A1BBD32107.quest_desc: ["Use a composter to convert spare plants into bone meal."]

	quest.24FBDB0B19577067.title: "When Two Become Three"
	quest.24FBDB0B19577067.quest_desc: ["Feed two compatible animals their breeding food."]

	quest.21C9C5409FFB45FA.title: "A Close Shave"
	quest.21C9C5409FFB45FA.quest_desc: ["Use shears on a sheep to collect wool safely."]

	quest.2FCCC58DED59D45D.title: "Which Came First?"
	quest.2FCCC58DED59D45D.quest_desc: ["Chickens follow seeds and lay eggs over time."]

	quest.2AC0124A99F9493D.title: "Best Friends Forever"
	quest.2AC0124A99F9493D.quest_desc: ["Tame a wolf with bones. A collar confirms success."]

	quest.2B1867CE61AF1D8B.title: "Chosen by a Cat"
	quest.2B1867CE61AF1D8B.quest_desc: ["Tame a cat with raw cod or salmon while approaching slowly."]

	quest.235BA25F1595D62F.title: "A Reel Commitment"
	quest.235BA25F1595D62F.quest_desc: ["Craft a fishing rod and find open water."]

	quest.2C376CB348F22EEF.title: "The Catch of the Day"
	quest.2C376CB348F22EEF.quest_desc: ["Catch a fish with a fishing rod."]

quest.24996CB1BB5861FC.title: "Irony Underground"
	quest.24996CB1BB5861FC.quest_desc: ["Mine raw iron with a stone pickaxe or better."]

	quest.24B94048DAF82D77.title: "Some Like It Hot"
	quest.24B94048DAF82D77.quest_desc: ["Smelt raw iron into an iron ingot."]

	quest.2F4B0C83900ACB1B.title: "A More Mature Pickaxe"
	quest.2F4B0C83900ACB1B.quest_desc: ["Craft an iron pickaxe for diamond, redstone and gold."]

	quest.2362E2130A0AA510.title: "Not Steel, Still Strong"
	quest.2362E2130A0AA510.quest_desc: ["Craft an iron sword or iron axe."]

	quest.2BC365D93204FE70.title: "Nope, Blocked"
	quest.2BC365D93204FE70.quest_desc: ["Craft a shield and raise it before an attack lands."]

	quest.243B6C84F095ED17.title: "Anything, Within Reason"
	quest.243B6C84F095ED17.quest_desc: ["Craft a bucket for water, lava and milk."]

	quest.24126090A651A73F.title: "Water Solves Problems"
	quest.24126090A651A73F.quest_desc: ["Fill a bucket with water for lava, fire and fall safety."]

	quest.28F9EF64615A116B.title: "Dress for Impact"
	quest.28F9EF64615A116B.quest_desc: ["Craft at least one piece of iron armor."]

	quest.2AD72E75FF8F6967.title: "Ironclad"
	quest.2AD72E75FF8F6967.quest_desc: ["Prepare all four pieces of iron armor."]

	quest.271398FBD71A64FF.title: "A Cutting Remark"
	quest.271398FBD71A64FF.quest_desc: ["Craft shears for wool, leaves, vines and cobwebs."]

	quest.2DE6A40EE28846B2.title: "Save the Fire for the Nether"
	quest.2DE6A40EE28846B2.quest_desc: ["Craft flint and steel and keep it away from wooden buildings."]

	quest.2D7ED308AB1B6F9F.title: "Items Enter Here"
	quest.2D7ED308AB1B6F9F.quest_desc: ["Craft a hopper and observe the direction of its narrow end."]

	quest.26742BC73BBEE275.title: "Anvil You Learn"
	quest.26742BC73BBEE275.quest_desc: ["Craft an anvil for repairing, renaming and combining enchantments."]

	quest.2F44CF391D9858AF.title: "This Does Not Point Home"
	quest.2F44CF391D9858AF.quest_desc: ["A normal compass points to world spawn, not your bed."]

quest.2FC5F85EF66E9EA5.title: "Those Who Go Down, Go Down"
	quest.2FC5F85EF66E9EA5.quest_desc: ["Descend into deepslate layers with food, wood, blocks and light."]

	quest.25656C93E2338354.title: "A Copper Opportunity"
	quest.25656C93E2338354.quest_desc: ["Mine raw copper."]

	quest.22950F6504A97B79.title: "Red Dust, Big Ideas"
	quest.22950F6504A97B79.quest_desc: ["Mine redstone dust with an iron pickaxe or better."]

	quest.2368BEE635B9841E.title: "Blue Stone, Blue Magic"
	quest.2368BEE635B9841E.quest_desc: ["Mine lapis lazuli for enchanting."]

	quest.2BE0706CBF280953.title: "All That Glitters"
	quest.2BE0706CBF280953.quest_desc: ["Mine raw gold for important recipes and Nether use."]

	quest.29904C30882B35A7.title: "Diamonds Are Forever"
	quest.29904C30882B35A7.quest_desc: ["Find and mine a diamond."]

	quest.25643C8D1C65D677.title: "This Pickaxe Is Mine Now"
	quest.25643C8D1C65D677.quest_desc: ["Craft a diamond pickaxe so obsidian becomes obtainable."]

	quest.2683A9B7D4981410.title: "Dark and Difficult"
	quest.2683A9B7D4981410.quest_desc: ["Mine ten obsidian for a minimal Nether portal."]

	quest.22A3B5DF4D7A6DD6.title: "A Prepared Miner Survives"
	quest.22A3B5DF4D7A6DD6.quest_desc: ["Carry food, torches, wood, blocks and spare tools."]

	quest.257C737E46060DAA.title: "Darkness Spawns Problems"
	quest.257C737E46060DAA.quest_desc: ["Light routes and work areas so mobs do not appear behind you."]

	quest.217F6E6E0699E7AA.title: "Please Look Up"
	quest.217F6E6E0699E7AA.quest_desc: ["Gravel and sand fall when unsupported. Mine from a safe angle."]

	quest.29A05C6E6619C14A.title: "Hot Means Dangerous"
	quest.29A05C6E6619C14A.quest_desc: ["Keep a water bucket ready near lava."]

	quest.272150786C755A60.title: "Know the Way Back"
	quest.272150786C755A60.quest_desc: ["Mark intersections consistently and close explored dead ends."]

	quest.202C90D93C50325D.title: "There Are Levels to This"
	quest.202C90D93C50325D.quest_desc: ["Low-tier tools can destroy blocks without receiving their drops."]

	quest.212E128CD01ECBC6.title: "Fortune or Finesse"
	quest.212E128CD01ECBC6.quest_desc: ["Fortune increases drops; Silk Touch preserves the block. They are incompatible."]

	quest.2170D74C4D3986AE.title: "Abandoned, Yet Crowded"
	quest.2170D74C4D3986AE.quest_desc: ["Find an abandoned mineshaft and watch for broken floors."]

	quest.248B0FAD159182E9.title: "The Room Has Too Many Owners"
	quest.248B0FAD159182E9.quest_desc: ["Find a dungeon with a spawner and loot chests."]

	quest.2047E917AA9C6508.title: "Small, Fast and Venomous"
	quest.2047E917AA9C6508.quest_desc: ["Defeat a cave spider and learn to control its spawner area."]

	quest.2753315078FF303B.title: "Twinkle, Twinkle, Giant Geode"
	quest.2753315078FF303B.quest_desc: ["Find a geode and obtain an amethyst shard without breaking budding amethyst."]

quest.29A696583A463B4F.title: "Timing Is Everything"
	quest.29A696583A463B4F.quest_desc: ["Java Edition attacks deal full damage only after the attack indicator refills."]

	quest.2F02AB8F15F0A9B9.title: "Sword or Axe?"
	quest.2F02AB8F15F0A9B9.quest_desc: ["Swords attack quickly and sweep; axes hit harder but recover slowly."]

	quest.27922FE1A280A8C4.title: "Blocked, Allegedly"
	quest.27922FE1A280A8C4.quest_desc: ["Raise a shield before the hit. Axes can temporarily disable shields."]

	quest.2AEE5B8FF0F8FF8B.title: "Personal Space, Please"
	quest.2AEE5B8FF0F8FF8B.quest_desc: ["Craft a bow for threats that should not be approached."]

	quest.2D8BC747D4EE1B8F.title: "Bring More Arrows"
	quest.2D8BC747D4EE1B8F.quest_desc: ["Carry enough arrows for the entire expedition."]

	quest.260F77B06A848314.title: "Dress Before Getting Hit"
	quest.260F77B06A848314.quest_desc: ["Armor reduces damage but loses durability. Awareness still matters."]

	quest.20B5D3891DED4F1A.title: "Falling with Style"
	quest.20B5D3891DED4F1A.quest_desc: ["A properly timed falling attack deals a critical hit."]

	quest.2B8F4A77FC29123F.title: "Retreat Is a Strategy"
	quest.2B8F4A77FC29123F.quest_desc: ["Create distance, block a doorway and recover when a fight turns bad."]

	quest.2776ED94E843D970.title: "Past the Expiration Date"
	quest.2776ED94E843D970.quest_desc: ["Defeat a zombie and watch for reinforcements."]

	quest.23288AD59515CF31.title: "A Bone to Pick"
	quest.23288AD59515CF31.quest_desc: ["Defeat a skeleton using cover or a shield."]

	quest.2521BC6F34305CB4.title: "An Explosive Relationship"
	quest.2521BC6F34305CB4.quest_desc: ["Defeat a creeper without letting it remodel the area."]

	quest.2857C49A2D0D7EEB.title: "The Spider Climbed the Wall"
	quest.2857C49A2D0D7EEB.quest_desc: ["Defeat a spider and remember that it can climb."]

	quest.28FF9EEBA1168340.title: "Do Not Make Eye Contact"
	quest.28FF9EEBA1168340.quest_desc: ["Defeat an Enderman. A two-block-high shelter is a reliable defense."]

quest.22A5D7A1985AA779.title: "Paper-Thin Progress"
	quest.22A5D7A1985AA779.quest_desc: ["Craft paper from sugar cane."]

	quest.2C20759677319158.title: "People Make Books; Books Make Gear"
	quest.2C20759677319158.quest_desc: ["Craft a book from paper and leather."]

	quest.294EB5CFB6162D85.title: "Gear Is Magic"
	quest.294EB5CFB6162D85.quest_desc: ["Craft an enchanting table from a book, diamonds and obsidian."]

	quest.2EB85E962D885638.title: "Knowledge Is Power"
	quest.2EB85E962D885638.quest_desc: ["Place fifteen bookshelves with a one-block air gap around the table."]

	quest.25DB3CB1BB52DB62.title: "The Dignity of Level 30"
	quest.25DB3CB1BB52DB62.quest_desc: ["Maximum offers require fifteen valid bookshelves and thirty levels."]

	quest.2A5750050800C247.title: "Your Enchantment Is Ready"
	quest.2A5750050800C247.quest_desc: ["Enchant an item using lapis and experience levels."]

	quest.2723F8E14746A659.title: "I Learned It from a Book"
	quest.2723F8E14746A659.quest_desc: ["Obtain an enchanted book for later anvil work."]

	quest.2D959C6A688B2451.title: "Stronger Together"
	quest.2D959C6A688B2451.quest_desc: ["Use an anvil to combine compatible equipment or books."]

	quest.240F2D33718F37EA.title: "Make That Enchantment Disappear"
	quest.240F2D33718F37EA.quest_desc: ["Use a grindstone to remove most non-curse enchantments."]

	quest.264FB21F62CC57A3.title: "Repair, Reuse, Repeat"
	quest.264FB21F62CC57A3.quest_desc: ["Mending converts collected experience into durability on held or equipped gear."]

quest.2FB23CA24FE081C9.title: "Signs of Civilization"
	quest.2FB23CA24FE081C9.quest_desc: ["Find any village and avoid damaging villagers or their workstations."]

	quest.27E94D31418A7BE8.title: "No Haggling Allowed"
	quest.27E94D31418A7BE8.quest_desc: ["Complete a trade with a villager."]

	quest.20DA9946A9EA27AC.title: "Every Job Needs a Workstation"
	quest.20DA9946A9EA27AC.quest_desc: ["Unemployed villagers claim nearby job-site blocks during work time."]

	quest.242DB03DB309BF1B.title: "The Farmer Knows"
	quest.242DB03DB309BF1B.quest_desc: ["Trade with a farmer. Crops are a reliable source of emeralds."]

	quest.274EC933EFDB9616.title: "Well Read"
	quest.274EC933EFDB9616.quest_desc: ["Trade with a librarian for bookshelves, glass or enchanted books."]

	quest.2656558113183F41.title: "Let the Villager Handle the Gear"
	quest.2656558113183F41.quest_desc: ["Trade with an armorer, toolsmith or weaponsmith."]

	quest.289C47C1AAA8FE2E.title: "Back in Stock"
	quest.289C47C1AAA8FE2E.quest_desc: ["Villagers restock when they can reach their workstation during work time."]

	quest.2FF3AB0A5AD0A84A.title: "Word Travels Fast"
	quest.2FF3AB0A5AD0A84A.quest_desc: ["Helping or harming villagers changes prices and gossip spreads."]

	quest.21BAC370613B26D5.title: "Village Population Recovery"
	quest.21BAC370613B26D5.quest_desc: ["Provide valid beds and food so willing villagers can breed."]

	quest.2359FA621F618BAB.title: "A Cure Is Needed"
	quest.2359FA621F618BAB.quest_desc: ["Use Weakness and a golden apple on a safely contained zombie villager."]

	quest.2CAEAF1A82769DD1.title: "Defend the Village"
	quest.2CAEAF1A82769DD1.quest_desc: ["Win a raid only after the village and your equipment are prepared."]

quest.22B0838FF51C4311.title: "The World Is Large; Maps Are Small"
	quest.22B0838FF51C4311.quest_desc: ["Craft an empty map and use it in the area you want to chart."]

	quest.2EC0EDF6A91A18E4.title: "Let Us Zoom Out"
	quest.2EC0EDF6A91A18E4.quest_desc: ["Use a cartography table or crafting grid to expand a filled map."]

	quest.2004FC52B8DAE583.title: "Comedy at a Distance"
	quest.2004FC52B8DAE583.quest_desc: ["Craft a spyglass from copper and an amethyst shard."]

	quest.236DE6C0D99A80C8.title: "Numbers Do Not Lie"
	quest.236DE6C0D99A80C8.quest_desc: ["X and Z are horizontal coordinates; Y is height."]

	quest.2C1D7FBBA08584DA.title: "The Freedom to Get Lost"
	quest.2C1D7FBBA08584DA.quest_desc: ["Create and name a Xaero waypoint for home."]

	quest.2132FA6E4DCC8228.title: "Treasure in the Desert"
	quest.2132FA6E4DCC8228.quest_desc: ["Find a desert pyramid and disarm the pressure plate before looting."]

	quest.2437A17A242F5910.title: "The Jungle Trap"
	quest.2437A17A242F5910.quest_desc: ["Find a jungle pyramid and inspect its tripwires."]

	quest.2EC71B725222CD97.title: "The Ship Went Under"
	quest.2EC71B725222CD97.quest_desc: ["Find a shipwreck and search its different chest rooms."]

	quest.25FEE6AE3F6725C0.title: "X Marks the Block"
	quest.25FEE6AE3F6725C0.quest_desc: ["Follow a treasure map and dig around the marked chunk."]

	quest.2E9F0C91454CA38D.title: "Once Upon a Time Underwater"
	quest.2E9F0C91454CA38D.quest_desc: ["Find warm or cold ocean ruins and watch your air."]

	quest.2BF93C6AFE19E58C.title: "I See a Banner"
	quest.2BF93C6AFE19E58C.quest_desc: ["Find a pillager outpost and handle ominous bottles carefully."]

	quest.2DDC0F516A0532CF.title: "A Big House with a Story"
	quest.2DDC0F516A0532CF.quest_desc: ["Find a woodland mansion and clear it room by room."]

	quest.25C82B207FAFE817.title: "Time for Some Brushing"
	quest.25C82B207FAFE817.quest_desc: ["Find trail ruins and brush suspicious gravel carefully."]

	quest.23C71F33BF655C03.title: "Who Rules the Ocean?"
	quest.23C71F33BF655C03.quest_desc: ["Find an ocean monument with water breathing, milk and good tools."]

quest.2782CA9338D0A483.title: "Red-Flavored Power"
	quest.2782CA9338D0A483.quest_desc: ["Use a lever to power redstone dust and a lamp."]

	quest.261C3E67E4E6AE43.title: "A Fading Relationship"
	quest.261C3E67E4E6AE43.quest_desc: ["Redstone wire carries strength 15 and weakens by one per block."]

	quest.2BACB4531F23C29D.title: "Could You Repeat That?"
	quest.2BACB4531F23C29D.quest_desc: ["A repeater restores strength, adds delay and enforces direction."]

	quest.27C76242FD357969.title: "No Comparison"
	quest.27C76242FD357969.quest_desc: ["A comparator compares signals and reads container fullness."]

	quest.22B5455EE6BFD457.title: "I Saw That"
	quest.22B5455EE6BFD457.quest_desc: ["An observer watches from its face and pulses from its rear."]

	quest.26ADAD408D6777B0.title: "A Gentle Push"
	quest.26ADAD408D6777B0.quest_desc: ["Power a piston to push movable blocks."]

	quest.22EF93EA655A2A86.title: "Push and Pull"
	quest.22EF93EA655A2A86.quest_desc: ["A sticky piston can pull many blocks back."]

	quest.29AEAD149607137A.title: "Logistics Has a Direction"
	quest.29AEAD149607137A.quest_desc: ["Connect hoppers while checking every nozzle direction."]

	quest.20DD84B712A72F16.title: "Time Goes in Circles"
	quest.20DD84B712A72F16.quest_desc: ["Build a small redstone clock with a shutoff switch."]

	quest.2E7D5645B6FFD030.title: "Next Stop: Automation"
	quest.2E7D5645B6FFD030.quest_desc: ["Craft powered rails and test powered and unpowered sections."]

	quest.2A06ACA38C008EA7.title: "Time to Turn the Cogs"
	quest.2A06ACA38C008EA7.quest_desc: ["Continue with the separate Create technology quest line for mechanical power."]

quest.22EF3880460138CE.title: "Prepare for Another World"
	quest.22EF3880460138CE.quest_desc: ["Build a rectangular Nether portal frame with at least ten obsidian."]

	quest.2358BCD118403516.title: "The Door Is Open"
	quest.2358BCD118403516.quest_desc: ["Ignite the inside of the portal frame with flint and steel."]

	quest.24422C192DBE3B20.title: "Where Am I?"
	quest.24422C192DBE3B20.quest_desc: ["Enter the Nether and wait for the terrain to load before moving."]

	quest.2C23B6617E2E2977.title: "Did You Record the Portal?"
	quest.2C23B6617E2E2977.quest_desc: ["Record the Nether-side portal coordinates before exploring."]

	quest.25125955795DC581.title: "Gold-Plated Diplomacy"
	quest.25125955795DC581.quest_desc: ["Wear at least one piece of gold armor so ordinary Piglins remain neutral."]

	quest.256971872A1E56B7.title: "White Stone with a Purpose"
	quest.256971872A1E56B7.quest_desc: ["Mine Nether quartz for comparators, observers and experience."]

	quest.213FAB5695AACB9D.title: "The Fortress Is Missing"
	quest.213FAB5695AACB9D.quest_desc: ["Find a Nether fortress and mark a safe route back."]

	quest.2BCD814B11C9795E.title: "Please Put Out the Fire"
	quest.2BCD814B11C9795E.quest_desc: ["Defeat a Blaze while using cover against its fireballs."]

	quest.23C9E89B45435A41.title: "Acquire Fire Stick"
	quest.23C9E89B45435A41.quest_desc: ["Obtain a Blaze rod. Keep several for brewing and Eyes of Ender."]

	quest.270A46992DCED9E2.title: "The Red Nether Crop"
	quest.270A46992DCED9E2.quest_desc: ["Obtain Nether wart from fortress gardens or bastion loot."]

	quest.2B1ED371A9BBD195.title: "Ground to a Fine Powder"
	quest.2B1ED371A9BBD195.quest_desc: ["Craft Blaze powder from a Blaze rod."]

	quest.2283ECD69DC3610E.title: "The Water Is Not Working"
	quest.2283ECD69DC3610E.quest_desc: ["Normal water cannot be placed in the Nether. Cauldrons are a limited exception."]

	quest.278FD162EC9890DE.title: "Sleeping Is a Blast"
	quest.278FD162EC9890DE.quest_desc: ["Beds explode in the Nether. Never test one near the portal or factory."]

	quest.29DA17247C728116.title: "The Eightfold Shortcut"
	quest.29DA17247C728116.quest_desc: ["One Nether block corresponds to eight Overworld blocks horizontally."]

	quest.23A2306BA3721F9E.title: "Dress Code: Gold"
	quest.23A2306BA3721F9E.quest_desc: ["Gold armor pacifies ordinary Piglins, but opening containers can still anger them."]

	quest.289AA3B5E7DC9007.title: "Hoglins Do Not Care About Fashion"
	quest.289AA3B5E7DC9007.quest_desc: ["Hoglins attack regardless of gold armor. Warped fungus repels them."]

	quest.29EE7D960C576326.title: "The Floor Is Lava"
	quest.29EE7D960C576326.quest_desc: ["Carry fire resistance and blocks, and avoid digging directly downward."]

	quest.2069A8472126117D.title: "Let Gold Do the Talking"
	quest.2069A8472126117D.quest_desc: ["Give gold ingots to an adult Piglin and collect the bartered item."]

	quest.2FE081C7B890AA53.title: "Even Obsidian Cries"
	quest.2FE081C7B890AA53.quest_desc: ["Obtain crying obsidian from barter, ruined portals or bastions."]

	quest.29638C6B24B2BDC3.title: "Hot Brothers"
	quest.29638C6B24B2BDC3.quest_desc: ["Obtain fire resistance from a potion, barter or another source."]

	quest.29C6D3A5C0AAACAF.title: "Remember the Bastion"
	quest.29C6D3A5C0AAACAF.quest_desc: ["Find a bastion remnant. Gold armor does not pacify Piglin Brutes."]

	quest.2E6961D7675948D1.title: "This One Will Not Negotiate"
	quest.2E6961D7675948D1.quest_desc: ["Avoid or defeat Piglin Brutes with shields, terrain and ranged attacks."]

	quest.226CB1D23CE3AC5F.title: "Old Things Are Strong"
	quest.226CB1D23CE3AC5F.quest_desc: ["Mine ancient debris with a diamond pickaxe or better."]

	quest.28A9066994CC950D.title: "An Upgrade Worth Making"
	quest.28A9066994CC950D.quest_desc: ["Produce a Netherite ingot and use the upgrade template carefully."]

quest.2BFC92150F5DF38C.title: "Today I Am an Alchemist"
	quest.2BFC92150F5DF38C.quest_desc: ["Craft a brewing stand from a Blaze rod and stone."]

	quest.254E86B7542E4BA1.title: "Add a Little Fire"
	quest.254E86B7542E4BA1.quest_desc: ["Supply Blaze powder to the brewing stand fuel slot."]

	quest.2F0C3875995B9CB2.title: "An Awkward Beginning"
	quest.2F0C3875995B9CB2.quest_desc: ["Brew water bottles with Nether wart to make Awkward Potions."]

	quest.2B9FCC1CCBA7FE65.title: "Make It Last"
	quest.2B9FCC1CCBA7FE65.quest_desc: ["Redstone dust extends many potion durations."]

	quest.2F3D4CEF6F117BCF.title: "Make It Strong"
	quest.2F3D4CEF6F117BCF.quest_desc: ["Glowstone dust strengthens many effects while shortening them."]

	quest.241233BC1ACE1C04.title: "Throwing Is Faster Than Drinking"
	quest.241233BC1ACE1C04.quest_desc: ["Gunpowder converts many drinkable potions into splash potions."]

	quest.2162A265A74861B3.title: "Fireproof, Temporarily"
	quest.2162A265A74861B3.quest_desc: ["Brew a Fire Resistance Potion with magma cream."]

	quest.2D967FE90D2E9C7A.title: "Falling, but Slowly"
	quest.2D967FE90D2E9C7A.quest_desc: ["Brew a Slow Falling Potion with a phantom membrane."]

	quest.2D5DC1F047F7FC82.title: "Strength in a Bottle"
	quest.2D5DC1F047F7FC82.quest_desc: ["Brew a Strength Potion with Blaze powder."]

	quest.2E32E40B77AEBA19.title: "One Sip, One Recovery"
	quest.2E32E40B77AEBA19.quest_desc: ["Brew a Healing Potion with a glistering melon slice."]

quest.2B1F6B8CE7BC3902.title: "A Pearl, Not a Tear"
	quest.2B1F6B8CE7BC3902.quest_desc: ["Obtain Ender pearls from Endermen, Piglin barter or another source."]

	quest.2722B782024D7FA3.title: "An Eye for an Eye"
	quest.2722B782024D7FA3.quest_desc: ["Craft Eyes of Ender from Ender pearls and Blaze powder."]

	quest.234FA47BF87CD9E5.title: "Ask the Eye for Directions"
	quest.234FA47BF87CD9E5.quest_desc: ["Use an Eye of Ender in the Overworld and follow its flight."]

	quest.2EB38E8623FD1AC3.title: "Always Bring Spares"
	quest.2EB38E8623FD1AC3.quest_desc: ["Eyes can shatter and the portal may have empty frames. Carry extras."]

	quest.207692C488E36AC5.title: "Found the Stronghold... Probably"
	quest.207692C488E36AC5.quest_desc: ["Follow the Eyes downward and locate a stronghold."]

	quest.2609D1E1916E037F.title: "Welcome to the Underground Library"
	quest.2609D1E1916E037F.quest_desc: ["Find a stronghold library and collect useful books and cobwebs."]

	quest.2EEFE6DBCB6451A7.title: "At the Door at Last"
	quest.2EEFE6DBCB6451A7.quest_desc: ["Locate and secure the End portal room."]

	quest.266EA9A8485ED99A.title: "Why Are There Bugs in the Stone?"
	quest.266EA9A8485ED99A.quest_desc: ["Control the silverfish spawner without letting the room become overrun."]

	quest.229D7172C2C1D7ED.title: "Twelve Eyes Are Watching"
	quest.229D7172C2C1D7ED.quest_desc: ["Fill every empty frame and activate the End portal."]

quest.2DEB7AC25A6BAE43.title: "One Reliable Weapon"
	quest.2DEB7AC25A6BAE43.quest_desc: ["Bring a strong, repaired melee weapon."]

	quest.2894465774576B89.title: "Distance Is Life"
	quest.2894465774576B89.quest_desc: ["Bring a bow or crossbow for End crystals and the flying dragon."]

	quest.28C0D79B888A8041.title: "More Arrows Are Better"
	quest.28C0D79B888A8041.quest_desc: ["Bring a generous supply of arrows."]

	quest.2A77350D551791D2.title: "Armor Does Not Betray You"
	quest.2A77350D551791D2.quest_desc: ["Bring a complete, repaired armor set."]

	quest.2F8BD40FB53BF0AD.title: "So Much to Build, So Little Time"
	quest.2F8BD40FB53BF0AD.quest_desc: ["Bring several stacks of disposable solid blocks."]

	quest.28A69A83D01944B2.title: "One Bucket, Many Miracles"
	quest.28A69A83D01944B2.quest_desc: ["Bring a water bucket for Endermen, falls and tower descents."]

	quest.205DAB6369C76AC6.title: "Emergency Teleport Insurance"
	quest.205DAB6369C76AC6.quest_desc: ["Bring Ender pearls for recovery from dangerous falls."]

	quest.278293B9205CDD1B.title: "Fighting on a Full Stomach"
	quest.278293B9205CDD1B.quest_desc: ["Bring high-quality food for the whole fight."]

	quest.2E62538D25B2BA1A.title: "A Potion-Shaped Parachute"
	quest.2E62538D25B2BA1A.quest_desc: ["Slow Falling is strongly recommended for the first dragon fight."]

	quest.2ED272F9C13587AB.title: "Respawn at the Door"
	quest.2ED272F9C13587AB.quest_desc: ["Set a safe respawn point near, but not inside, the portal room."]

	quest.2391E50928ECF945.title: "Plan B Is in the Chest"
	quest.2391E50928ECF945.quest_desc: ["Store replacement gear and food near the portal."]

	quest.2CEF9C2C322EF548.title: "No Sleeping in the End"
	quest.2CEF9C2C322EF548.quest_desc: ["Beds explode in the End. Bed tactics are optional and extremely dangerous."]

quest.2C455DE030CB7353.title: "Into the End"
	quest.2C455DE030CB7353.quest_desc: ["Enter the End only after checking your equipment and respawn point."]
	quest.2E9207295388974C.title: "Make Landfall"
	quest.2E9207295388974C.quest_desc: ["Reach the main island safely; bridge carefully if the entry platform is isolated."]
	quest.2D2897D8C814E32D.title: "Do Not Make Eye Contact"
	quest.2D2897D8C814E32D.quest_desc: ["Keep your crosshair away from Endermen and use water or a low roof if they attack."]
	quest.26492CCC83A0441F.title: "The Dragon Has Wi-Fi"
	quest.26492CCC83A0441F.quest_desc: ["End crystals heal the dragon. Destroying them is the first phase of the battle."]
	quest.2D84BC10F51093E9.title: "Cancel the Subscription"
	quest.2D84BC10F51093E9.quest_desc: ["Destroy the exposed End crystals with ranged attacks while keeping away from explosions."]
	quest.2D8AFCE4D8F7A60F.title: "Some Assembly Required"
	quest.2D8AFCE4D8F7A60F.quest_desc: ["Climb or shoot through a gap to destroy crystals protected by iron cages."]
	quest.2E4A07D835841C3D.title: "Purple Is Not a Healthy Color"
	quest.2E4A07D835841C3D.quest_desc: ["Dragon breath lingers and deals heavy damage. Leave the cloud immediately."]
	quest.2E9EEB3C8E75E9F1.title: "Now It Is Personal"
	quest.2E9EEB3C8E75E9F1.quest_desc: ["When the dragon perches, attack its head and avoid standing in front of it."]
	quest.2FC0FBEB5C3B3E55.title: "The Credits Were Only the Beginning"
	quest.2FC0FBEB5C3B3E55.quest_desc: ["Defeat the Ender Dragon."]
	quest.2AED3403409C973C.title: "Take the Way Home"
	quest.2AED3403409C973C.quest_desc: ["Use the exit portal and return to the Overworld when you are ready."]
	quest.2627CC14E83E02BC.title: "Breath in a Bottle"
	quest.2627CC14E83E02BC.quest_desc: ["Optional: scoop a breath cloud into an empty glass bottle."]
	quest.23CF33578CCDEC88.title: "The Most Expensive Decoration"
	quest.23CF33578CCDEC88.quest_desc: ["Optional: move the Dragon Egg with a piston or make it drop using a torch."]
	quest.2B671527AF5A73CB.title: "New Game Plus"
	quest.2B671527AF5A73CB.quest_desc: ["Optional: place four End crystals around the exit portal to respawn the dragon."]
	quest.2261DE13E8ECCEC6.title: "We Have Done This Before"
	quest.2261DE13E8ECCEC6.quest_desc: ["Optional: defeat the Ender Dragon a second time."]

quest.21CF78563D572C07.title: "A Tiny New Door"
	quest.21CF78563D572C07.quest_desc: ["Find the End gateway created after the dragon's defeat."]
	quest.287DB19021C0B223.title: "Pearl Delivery Service"
	quest.287DB19021C0B223.quest_desc: ["Throw an Ender pearl into the gateway to reach the outer islands."]
	quest.2FA9650FD1A71516.title: "Fruit with Side Effects"
	quest.2FA9650FD1A71516.quest_desc: ["Collect chorus fruit; eating it teleports you a short distance."]
	quest.23E97717160E9740.title: "Purple Real Estate"
	quest.23E97717160E9740.quest_desc: ["Locate an End city among the outer islands."]
	quest.28969B87B3D90E53.title: "Box with an Attitude"
	quest.28969B87B3D90E53.quest_desc: ["Defeat a Shulker while using cover against its homing projectiles."]
	quest.2B2A7A64850EC6B2.title: "Falling Upward"
	quest.2B2A7A64850EC6B2.quest_desc: ["Shulker bullets cause Levitation. Get under a roof before the effect ends."]
	quest.28223A99A5DD3016.title: "Shell Company"
	quest.28223A99A5DD3016.quest_desc: ["Collect two Shulker shells."]
	quest.2350D6F6680B35CD.title: "Inventory Expansion Pack"
	quest.2350D6F6680B35CD.quest_desc: ["Craft a Shulker Box that keeps its contents when broken."]
	quest.299073A0221D05B5.title: "The Ship That Never Sailed"
	quest.299073A0221D05B5.quest_desc: ["Find an End ship attached to an End city and board it carefully."]
	quest.2C389C7A2762CD20.title: "Now We Are Flying"
	quest.2C389C7A2762CD20.quest_desc: ["Claim the Elytra from the item frame inside an End ship."]
	quest.2A7B892355827F39.title: "Rocket Fuel, Technically"
	quest.2A7B892355827F39.quest_desc: ["Craft Firework Rockets without explosion stars for safe Elytra propulsion."]
	quest.225607A20E1F38D8.title: "First Class Is Outside"
	quest.225607A20E1F38D8.quest_desc: ["Glide at least ten metres with an Elytra."]
	quest.203FD34AD0697ACD.title: "Tutorial Complete, World Not Included"
	quest.203FD34AD0697ACD.quest_desc: ["The main vanilla journey is complete. Deep Dark and Wither expeditions are now optional postgame routes."]

quest.2231512688E7D895.title: "The Quiet Route"
	quest.2231512688E7D895.quest_desc: ["This optional expedition is about stealth, recovery and escape. The Warden is not a boss objective."]
	quest.2CD0E7DBD00FCBA6.title: "Where the Music Stops"
	quest.2CD0E7DBD00FCBA6.quest_desc: ["Find a Deep Dark biome beneath mountainous regions."]
	quest.2174D20E9E35FDBD.title: "Urban Exploration, Very Ancient Edition"
	quest.2174D20E9E35FDBD.quest_desc: ["Locate an Ancient City without triggering too many Sculk Shriekers."]
	quest.2745E1F6DCD67D4D.title: "Loot Quietly"
	quest.2745E1F6DCD67D4D.quest_desc: ["Open an Ancient City chest only after planning a silent escape route."]
	quest.2E62B60378C29777.title: "An Echo of Something Valuable"
	quest.2E62B60378C29777.quest_desc: ["Recover an Echo Shard from Ancient City loot."]
	quest.2CAFFF7AA4EEA2D1.title: "It Points to Regret"
	quest.2CAFFF7AA4EEA2D1.quest_desc: ["Craft a Recovery Compass from Echo Shards and a compass."]
	quest.2343A2F304005C7E.title: "Running Is a Valid Strategy"
	quest.2343A2F304005C7E.quest_desc: ["Escape the city alive. Do not stay to fight a Warden."]
	quest.2CF9DF9E80FDC356.title: "No Heroics Required"
	quest.2CF9DF9E80FDC356.quest_desc: ["Complete the Deep Dark expedition by returning safely with your findings."]
	quest.27DDEBE769354FED.title: "The Floor Is Listening"
	quest.27DDEBE769354FED.quest_desc: ["Collect Sculk with Silk Touch and learn how it stores experience."]
	quest.228E5EDBEB613B0A.title: "Wireless Redstone, but Spooky"
	quest.228E5EDBEB613B0A.quest_desc: ["Collect a Sculk Sensor and observe how vibrations activate it."]
	quest.27F9DA0D6A958B3D.title: "Please Do Not Press the Alarm"
	quest.27F9DA0D6A958B3D.quest_desc: ["Collect a Sculk Shrieker with Silk Touch; placed shriekers cannot summon Wardens."]
	quest.28F84E0C8F487635.title: "Wool Has Entered the Chat"
	quest.28F84E0C8F487635.quest_desc: ["Wool blocks and carpet block or dampen many vibrations around sensors."]
	quest.27FB23EDF4A4FF37.title: "One Hundred Seconds of Patience"
	quest.27FB23EDF4A4FF37.quest_desc: ["Spend a total of one hundred seconds sneaking."]
	quest.21B2A3A587E3CF59.title: "Bring Your Own Silence"
	quest.21B2A3A587E3CF59.quest_desc: ["Prepare at least thirty-two wool blocks before entering the city."]
	quest.211E52854DA90DA7.title: "Swift Sneak Lottery"
	quest.211E52854DA90DA7.quest_desc: ["Optional: find an enchanted book in the city and check whether it carries Swift Sneak."]
	quest.28B58871792FA331.title: "Track Five, Part One"
	quest.28B58871792FA331.quest_desc: ["Collect a Disc Fragment 5 from Ancient City chests."]
	quest.2D00C541551763BD.title: "Now Playing: Five"
	quest.2D00C541551763BD.quest_desc: ["Combine nine fragments to craft Music Disc 5."]
	quest.2AC30C39C6F2A053.title: "Three Strikes and You Are Heard"
	quest.2AC30C39C6F2A053.quest_desc: ["Shriekers raise a hidden warning level. Leave the area before repeated warnings summon a Warden."]
	quest.2750274BD6574992.title: "Look Over There"
	quest.2750274BD6574992.quest_desc: ["Carry snowballs or arrows to create vibrations away from your route."]
	quest.2D38DE80A2571C0D.title: "If the Darkness Breathes"
	quest.2D38DE80A2571C0D.quest_desc: ["If a Warden emerges, stop making noise, create distance and retreat. Killing it is never required."]

quest.24039B1AB38B5053.title: "A Boss You Build Yourself"
	quest.24039B1AB38B5053.quest_desc: ["This optional route summons a destructive boss. Prepare the arena before placing the final skull."]
	quest.238047173D35A699.title: "Four Blocks of Bad Intentions"
	quest.238047173D35A699.quest_desc: ["Collect four Soul Sand or Soul Soil blocks for the Wither's body."]
	quest.295056F543D97C20.title: "Tall, Dark and Armed"
	quest.295056F543D97C20.quest_desc: ["Defeat Wither Skeletons in a Nether Fortress."]
	quest.22032DAD07AC602F.title: "One in Many"
	quest.22032DAD07AC602F.quest_desc: ["Obtain your first Wither Skeleton Skull."]
	quest.2CF21FABD33EDF0A.title: "Three Heads Are Worse Than One"
	quest.2CF21FABD33EDF0A.quest_desc: ["Collect all three skulls required to summon the Wither."]
	quest.24BC1FF5AB8AE97C.title: "This Seems Like a Bad Idea"
	quest.24BC1FF5AB8AE97C.quest_desc: ["Build the T-shaped body in your prepared arena and place the third skull last."]
	quest.2DBF0129446819C9.title: "Management Would Like a Word"
	quest.2DBF0129446819C9.quest_desc: ["Defeat the Wither and survive its Wither effect."]
	quest.2183D57AAFC8A7A8.title: "A Star Is Born"
	quest.2183D57AAFC8A7A8.quest_desc: ["Recover the Nether Star dropped by the Wither."]
	quest.23F2794CB6E0444E.title: "Light at the End of the Grind"
	quest.23F2794CB6E0444E.quest_desc: ["Craft a Beacon from glass, obsidian and the Nether Star."]
	quest.246F7468C9CFB9B1.title: "Benefits Package Activated"
	quest.246F7468C9CFB9B1.quest_desc: ["Build a mineral pyramid, place the Beacon on top and select an effect."]
	quest.24375E7F0F1F4684.title: "Postgame Has Benefits"
	quest.24375E7F0F1F4684.quest_desc: ["Complete the Wither route with a functioning Beacon."]
	quest.216FB4B87786641C.title: "Smite Makes Right"
	quest.216FB4B87786641C.quest_desc: ["Optional: prepare a strong sword or axe; Smite is especially effective against the undead Wither."]
	quest.27369B22C0A6CC65.title: "Emergency Dairy Supply"
	quest.27369B22C0A6CC65.quest_desc: ["Bring milk to clear the Wither effect, but remember that it also removes beneficial effects."]
	quest.2E210D1406F05126.title: "Location, Location, Explosion"
	quest.2E210D1406F05126.quest_desc: ["Choose an isolated underground arena made from durable blocks and protect anything valuable nearby."]
	quest.2645AD58B01D63FE.title: "Opening Ceremony"
	quest.2645AD58B01D63FE.quest_desc: ["Back away during the Wither's charging phase; its initial explosion is enormous."]
	quest.2C97C43BF3F3686E.title: "No More Ranged Support"
	quest.2C97C43BF3F3686E.quest_desc: ["Below half health the Wither gains armor against projectiles. Finish the fight in melee."]
	quest.2375A682DEA63545.title: "The Pyramid Scheme That Works"
	quest.2375A682DEA63545.quest_desc: ["Optional: build a full four-layer Beacon pyramid."]
	quest.209664B16DC537C8.title: "Choose Your Benefits"
	quest.209664B16DC537C8.quest_desc: ["Optional: experiment with the Beacon's primary and secondary effects."]
}
