{
	chapter.1A6B9C2D4E7F8051.title: "환영합니다"
	chapter.1F13D457ABCA8E5A.title: "튜토리얼"
	chapter.5A0E000000000001.title: "석기 시대"
	chapter.5A0E000000000002.title: "안산암 합금 시대"
	chapter.5A0E000000000003.title: "황동 시대"
	chapter.5A0E000000000004.title: "산업 시대"
	chapter.5A0E000000000005.title: "원자력 시대"
	chapter.7A1B2C3D4E5F6001.title: "꿀팁과 노하우"
	chapter_group.4D41494E51554553.title: "기술 시대"
	file.0000000000000001.title: "MoonScenty Presents Minecraft"
	quest.2004FC52B8DAE583.quest_desc: ["구리와 자수정 조각으로 망원경을 만드세요. 멀리 있는 구조물과 위험 요소를 먼저 확인해 불필요한 이동을 줄일 수 있습니다."]
	quest.2004FC52B8DAE583.quest_subtitle: "망원경 제작"
	quest.2004FC52B8DAE583.title: "멀리서 보면 희극"
	quest.202C90D93C50325D.quest_desc: ["도구 등급이 낮으면 블록을 부숴도 아이템이 나오지 않을 수 있습니다."]
	quest.202C90D93C50325D.quest_subtitle: "채굴 등급 설명"
	quest.202C90D93C50325D.title: "급이 다릅니다"
	quest.203FD34AD0697ACD.quest_desc: ["바닐라 메인 여정은 끝났으며 Deep Dark와 위더 분기는 선택 진행입니다."]
	quest.203FD34AD0697ACD.quest_subtitle: "에필로그 완료 및 포스트게임 분기 안내"
	quest.203FD34AD0697ACD.title: "끝난 줄 알았지?"
	quest.2047E917AA9C6508.quest_desc: ["동굴 거미를 처치하고 생성기 주변을 안전하게 통제하세요."]
	quest.2047E917AA9C6508.quest_subtitle: "동굴 거미 주의"
	quest.2047E917AA9C6508.title: "작다고 얕보지 마라"
	quest.205DAB6369C76AC6.quest_desc: ["위험한 추락에서 복귀할 엔더 진주를 챙기세요."]
	quest.205DAB6369C76AC6.quest_subtitle: "엔더 진주 준비"
	quest.205DAB6369C76AC6.title: "떨어질 때 쓰는 보험"
	quest.2069A8472126117D.quest_desc: ["성체 피글린에게 금 주괴를 주고 물물교환 결과를 받으세요. 물물교환은 엔더 진주, 화염 저항 물약과 우는 흑요석을 얻는 대체 경로입니다."]
	quest.2069A8472126117D.quest_subtitle: "피글린 물물교환"
	quest.2069A8472126117D.title: "금으로 대화합시다"
	quest.207692C488E36AC5.quest_desc: ["엔더의 눈이 아래로 향하는 지점에서 근거지를 찾으세요. 근거지 안의 차원문만이 엔더 드래곤이 있는 엔드로 연결됩니다."]
	quest.207692C488E36AC5.quest_subtitle: "근거지 발견"
	quest.207692C488E36AC5.title: "찾았다 요새... 맞겠지?"
	quest.209664B16DC537C8.quest_desc: ["신호기의 주 효과와 보조 효과를 바꿔 사용해 보세요. 작업 목적에 맞춰 성급함, 속도나 저항 등을 바꾸면 같은 신호기를 여러 상황에 활용할 수 있습니다."]
	quest.209664B16DC537C8.quest_subtitle: "여러 신호기 효과 활용 안내"
	quest.209664B16DC537C8.title: "이 구역의 버프는 나야"
	quest.20A4AA9E260BD193.quest_desc: ["이 퀘스트북은 콘텐츠를 잠그지 않고 진행 순서와 핵심 시스템만 안내합니다. 길을 잃었을 때 다음 목표를 찾는 이정표로 사용하세요."]
	quest.20A4AA9E260BD193.quest_subtitle: "모드팩과 튜토리얼 퀘스트 소개"
	quest.20A4AA9E260BD193.title: "여기가 그 마인크래프트인가요"
	quest.20B5D3891DED4F1A.quest_desc: ["낙하 중 타이밍을 맞춰 공격하면 치명타가 발생합니다."]
	quest.20B5D3891DED4F1A.quest_subtitle: "치명타 안내"
	quest.20B5D3891DED4F1A.title: "떨어지면서 때리면 더 아프다"
	quest.20DA9946A9EA27AC.quest_desc: ["무직 주민은 근무 시간에 가까운 작업대를 직업으로 선택합니다."]
	quest.20DA9946A9EA27AC.quest_subtitle: "직업 블록 설명"
	quest.20DA9946A9EA27AC.title: "직업에는 귀천이 없지만 작업대는 있다"
	quest.20DD84B712A72F16.quest_desc: ["정지 스위치가 있는 간단한 레드스톤 시계를 만드세요. 반복 신호는 자동 농장과 주기적으로 작동하는 장치의 기반입니다."]
	quest.20DD84B712A72F16.quest_subtitle: "레드스톤 시계"
	quest.20DD84B712A72F16.title: "시간은 돌고 돈다"
	quest.211E52854DA90DA7.quest_desc: ["고대 도시에서 신속한 잠행 마법책을 찾아보세요. 레깅스에 적용하면 웅크린 채로도 빠르게 움직여 잠입과 탈출이 쉬워집니다."]
	quest.211E52854DA90DA7.quest_subtitle: "신속한 잠행 마법책 획득"
	quest.211E52854DA90DA7.title: "조용하지만 빠르게"
	quest.212E128CD01ECBC6.quest_desc: ["행운은 드롭량을 늘리고 섬세한 손길은 블록 자체를 보존하며 둘은 함께 붙지 않습니다."]
	quest.212E128CD01ECBC6.quest_subtitle: "행운과 섬세한 손길 비교"
	quest.212E128CD01ECBC6.title: "행운이냐 섬세함이냐"
	quest.2132FA6E4DCC8228.quest_desc: ["사막 피라미드의 압력판을 먼저 제거한 뒤 전리품을 챙기세요. 함정을 해제하면 폭발로 희귀 전리품과 자신을 잃는 일을 막을 수 있습니다."]
	quest.2132FA6E4DCC8228.quest_subtitle: "사막 피라미드를 찾고 압력판을 해제한 뒤 전리품 획득"
	quest.2132FA6E4DCC8228.title: "사막에서 보물 찾기"
	quest.213FAB5695AACB9D.quest_desc: ["네더 요새를 찾고 차원문까지 돌아가는 길을 표시하세요. 블레이즈 막대와 네더 사마귀는 양조와 엔더의 눈 제작에 모두 필요합니다."]
	quest.213FAB5695AACB9D.quest_subtitle: "네더 요새 발견"
	quest.213FAB5695AACB9D.title: "요새가 안 보여요"
	quest.21438F602D0CA906.quest_desc: ["WASD로 이동하고 마우스로 시점을 돌리며 Space로 점프하세요. 탐험과 전투 모두 정확한 이동이 기본입니다."]
	quest.21438F602D0CA906.quest_subtitle: "이동, 시점 전환과 점프 안내"
	quest.21438F602D0CA906.title: "고개를 들어 주위를 보라"
	quest.214BC51A55318E70.quest_desc: ["침대에서 자거나 안전하게 첫날밤을 보내세요. 밤에는 적대적 몬스터가 나타나므로 준비 없는 야외 활동은 피하는 편이 좋습니다."]
	quest.214BC51A55318E70.quest_subtitle: "밤을 보내거나 침대에서 자기"
	quest.214BC51A55318E70.title: "오늘 밤 주인공은 나야 나"
	quest.2162A265A74861B3.quest_desc: ["마그마 크림으로 화염 저항의 물약을 양조하세요. 용암과 화염 피해를 무시할 수 있어 네더 탐사와 블레이즈 전투가 안전해집니다."]
	quest.2162A265A74861B3.quest_subtitle: "화염 저항 물약"
	quest.2162A265A74861B3.title: "불 속성 면역"
	quest.216D61608B2F3189.quest_desc: ["감자와 당근을 재배하고 수확물 일부를 다시 심으세요."]
	quest.216D61608B2F3189.quest_subtitle: "감자와 당근 재배"
	quest.216D61608B2F3189.title: "감자합니다"
	quest.216FB4B87786641C.quest_desc: ["강타가 붙은 강한 검이나 도끼는 언데드인 위더에게 특히 효과적입니다."]
	quest.216FB4B87786641C.quest_subtitle: "강타 마법이 위더에게 유효함을 안내"
	quest.216FB4B87786641C.title: "언데드 특효약"
	quest.2170D74C4D3986AE.quest_desc: ["폐광을 찾고 무너진 바닥과 동굴 거미를 조심하세요. 폐광은 레일, 거미줄과 상자 전리품을 한곳에서 확보할 수 있는 구조물입니다."]
	quest.2170D74C4D3986AE.quest_subtitle: "폐광 발견"
	quest.2170D74C4D3986AE.title: "폐광인데 사람이 많다"
	quest.2174D20E9E35FDBD.quest_desc: ["스컬크 비명체를 자극하지 않으며 고대 도시를 찾으세요. 고대 도시에는 메아리 조각과 신속한 잠행처럼 이곳에서만 얻는 전리품이 있습니다."]
	quest.2174D20E9E35FDBD.quest_subtitle: "고대 도시 발견"
	quest.2174D20E9E35FDBD.title: "사람이 없는데 도시가 있다"
	quest.217F6E6E0699E7AA.quest_desc: ["자갈과 모래는 받침이 없으면 떨어지므로 안전한 각도에서 캐세요."]
	quest.217F6E6E0699E7AA.quest_subtitle: "자갈과 모래 낙하 위험"
	quest.217F6E6E0699E7AA.title: "위를 보세요"
	quest.2183D57AAFC8A7A8.quest_desc: ["위더가 떨어뜨린 네더의 별을 회수하세요. 네더의 별은 신호기를 만들 수 있는 유일한 재료이며 폭발에도 사라지지 않습니다."]
	quest.2183D57AAFC8A7A8.quest_subtitle: "네더의 별 획득"
	quest.2183D57AAFC8A7A8.title: "별이 빛나는 밤에"
	quest.21B2A3A587E3CF59.quest_desc: ["도시에 들어가기 전 양털 블록을 32개 이상 준비하세요. 양털은 발걸음과 블록 설치 진동을 차단해 안전한 이동로를 만들 수 있습니다."]
	quest.21B2A3A587E3CF59.quest_subtitle: "양털과 괭이 준비 권장"
	quest.21B2A3A587E3CF59.title: "발소리도 포장해 드립니다"
	quest.21BAC370613B26D5.quest_desc: ["유효한 침대와 충분한 음식을 제공해 주민을 번식시키세요. 주민 수를 늘려야 필요한 직업과 거래를 동시에 운영할 수 있습니다."]
	quest.21BAC370613B26D5.quest_subtitle: "주민 번식"
	quest.21BAC370613B26D5.title: "마을 인구 정상화"
	quest.21C9C5409FFB45FA.quest_desc: ["양에게 가위를 사용해 해치지 않고 양털을 얻으세요."]
	quest.21C9C5409FFB45FA.quest_subtitle: "가위 사용"
	quest.21C9C5409FFB45FA.title: "양털 깎는 노인...은 아닙니다"
	quest.21CF78563D572C07.quest_desc: ["드래곤 처치 뒤 생성된 엔드 관문을 찾으세요. 관문을 이용해야 겉날개와 셜커가 있는 외곽 엔드에 빠르게 도달할 수 있습니다."]
	quest.21CF78563D572C07.quest_subtitle: "엔드 관문 이용"
	quest.21CF78563D572C07.title: "문 너머 또 다른 문"
	quest.22032DAD07AC602F.quest_desc: ["첫 위더 스켈레톤 해골을 얻으세요. 해골은 위더 소환에만 쓰이는 희귀 재료이므로 총 세 개를 확보해야 합니다."]
	quest.22032DAD07AC602F.quest_subtitle: "위더 스켈레톤 해골 획득"
	quest.22032DAD07AC602F.title: "머리 하나 주웠습니다"
	quest.2231512688E7D895.quest_desc: ["이 분기는 잠입과 생환이 목표이며 워든은 처치 대상이 아닙니다."]
	quest.2231512688E7D895.quest_subtitle: "Deep Dark 분기와 비전투 원칙 소개"
	quest.2231512688E7D895.title: "들어는 봤나, Deep Dark"
	quest.225607A20E1F38D8.quest_desc: ["겉날개로 10미터 이상 활강하세요. 안전한 낮은 곳에서 이륙과 착륙을 익혀야 장거리 비행 중 추락을 피할 수 있습니다."]
	quest.225607A20E1F38D8.quest_subtitle: "겉날개 비행"
	quest.225607A20E1F38D8.title: "날아라 슈퍼보드...는 아니고"
	quest.2261DE13E8ECCEC6.quest_desc: ["선택 목표로 부활한 엔더 드래곤을 다시 처치하세요."]
	quest.2261DE13E8ECCEC6.quest_subtitle: "부활한 드래곤 처치"
	quest.2261DE13E8ECCEC6.title: "끝... 다시"
	quest.226CB1D23CE3AC5F.quest_desc: ["다이아몬드 곡괭이 이상으로 고대 잔해를 채굴하세요. 고대 잔해를 가공하면 불에 타지 않는 최상급 네더라이트 장비로 강화할 수 있습니다."]
	quest.226CB1D23CE3AC5F.quest_subtitle: "고대 잔해 획득"
	quest.226CB1D23CE3AC5F.title: "오래된 것이 강하다"
	quest.2283ECD69DC3610E.quest_desc: ["네더에는 일반 물을 놓을 수 없으며 가마솥만 제한적으로 사용할 수 있습니다."]
	quest.2283ECD69DC3610E.quest_subtitle: "네더에서 물을 놓을 수 없음"
	quest.2283ECD69DC3610E.title: "물이 안 나와요"
	quest.228E5EDBEB613B0A.quest_desc: ["스컬크 감지기를 채집하고 진동에 반응하는 방식을 관찰하세요."]
	quest.228E5EDBEB613B0A.quest_subtitle: "스컬크 감지기와 진동 설명"
	quest.228E5EDBEB613B0A.title: "다 듣고 있습니다"
	quest.22950F6504A97B79.quest_desc: ["철 곡괭이 이상으로 레드스톤 가루를 채굴하세요. 레드스톤은 장치 제어와 자동화를 시작하는 신호 재료입니다."]
	quest.22950F6504A97B79.quest_subtitle: "레드스톤 획득"
	quest.22950F6504A97B79.title: "빨간 가루의 비밀"
	quest.229D7172C2C1D7ED.quest_desc: ["빈 틀을 엔더의 눈으로 채워 엔드 차원문을 활성화하세요. 활성화 뒤에는 엔드에서 바로 돌아올 수 없으므로 먼저 전투 준비를 마치세요."]
	quest.229D7172C2C1D7ED.quest_subtitle: "엔드 차원문 활성화"
	quest.229D7172C2C1D7ED.title: "열두 눈이 지켜보고 있다"
	quest.22A3B5DF4D7A6DD6.quest_desc: ["음식, 횃불, 나무, 블록과 예비 도구를 빠짐없이 챙기세요."]
	quest.22A3B5DF4D7A6DD6.quest_subtitle: "음식, 횃불, 나무 준비"
	quest.22A3B5DF4D7A6DD6.title: "준비된 광부에게 사고는 없다"
	quest.22A5D7A1985AA779.quest_desc: ["사탕수수로 종이를 만드세요. 종이는 책, 지도와 폭죽 로켓으로 이어지는 기반 재료입니다."]
	quest.22A5D7A1985AA779.quest_subtitle: "종이 제작"
	quest.22A5D7A1985AA779.title: "종이 한 장 차이"
	quest.22B0838FF51C4311.quest_desc: ["빈 지도를 만들고 기록할 지역에서 사용하세요. 지도는 탐험한 지형과 구조물 위치를 공유하고 다시 찾는 데 유용합니다."]
	quest.22B0838FF51C4311.quest_subtitle: "지도 제작"
	quest.22B0838FF51C4311.title: "세상은 넓고 지도는 작다"
	quest.22B5455EE6BFD457.quest_desc: ["관찰자는 얼굴 쪽의 변화를 감지해 뒤쪽으로 짧은 신호를 냅니다."]
	quest.22B5455EE6BFD457.quest_subtitle: "관측기"
	quest.22B5455EE6BFD457.title: "다 보고 있습니다"
	quest.22EF3880460138CE.quest_desc: ["흑요석 10개 이상으로 직사각형 네더 차원문 틀을 만드세요. 네더에는 양조와 엔드 진행에 필요한 재료가 있어 반드시 거쳐야 합니다."]
	quest.22EF3880460138CE.quest_subtitle: "네더 차원문 제작"
	quest.22EF3880460138CE.title: "이세계 전생 준비 완료"
	quest.22EF93EA655A2A86.quest_desc: ["끈끈이 피스톤은 밀었던 블록을 다시 당길 수 있습니다."]
	quest.22EF93EA655A2A86.quest_subtitle: "끈끈이 피스톤"
	quest.22EF93EA655A2A86.title: "밀고 당기기"
	quest.23223152350FFF50.quest_desc: ["나무를 맨손으로 부숴 아무 원목이나 하나 얻으세요. 원목은 작업대와 첫 도구를 만드는 모든 초반 제작의 출발점입니다."]
	quest.23223152350FFF50.quest_subtitle: "아무 원목 1개 획득"
	quest.23223152350FFF50.title: "나무를 캐라고? 맨손으로?"
	quest.23288AD59515CF31.quest_desc: ["엄폐물이나 방패를 이용해 스켈레톤을 처치하세요. 원거리 적을 상대하는 법을 익히고 뼈와 화살도 확보할 수 있습니다."]
	quest.23288AD59515CF31.quest_subtitle: "스켈레톤 처치"
	quest.23288AD59515CF31.title: "뼈 때리는 한 발"
	quest.2343A2F304005C7E.quest_desc: ["워든과 싸우지 말고 전리품을 지닌 채 도시에서 탈출하세요."]
	quest.2343A2F304005C7E.quest_subtitle: "워든을 공격하지 않고 고대 도시에서 생환"
	quest.2343A2F304005C7E.title: "튀어!"
	quest.234FA47BF87CD9E5.quest_desc: ["오버월드에서 엔더의 눈을 던지고 날아가는 방향을 따라가세요."]
	quest.234FA47BF87CD9E5.quest_subtitle: "엔더의 눈 던지기"
	quest.234FA47BF87CD9E5.title: "눈을 던져 길을 묻다"
	quest.2350D6F6680B35CD.quest_desc: ["부숴도 내용물이 유지되는 셜커 상자를 만드세요."]
	quest.2350D6F6680B35CD.quest_subtitle: "셜커 상자 제작"
	quest.2350D6F6680B35CD.title: "상자째 들고 갑니다"
	quest.2358BCD118403516.quest_desc: ["부싯돌과 부시로 차원문 틀 안쪽에 불을 붙이세요."]
	quest.2358BCD118403516.quest_subtitle: "차원문 점화"
	quest.2358BCD118403516.title: "문은 열렸습니다"
	quest.2359FA621F618BAB.quest_desc: ["안전하게 가둔 좀비 주민에게 나약함과 황금 사과를 사용하세요. 치료한 주민에게서는 큰 거래 할인을 받을 수 있습니다."]
	quest.2359FA621F618BAB.quest_subtitle: "좀비 주민 치료"
	quest.2359FA621F618BAB.title: "치료가 필요합니다"
	quest.235BA25F1595D62F.quest_desc: ["낚싯대를 만들고 탁 트인 물가를 찾으세요. 낚시는 농장 없이도 음식과 희귀 전리품을 얻는 선택지입니다."]
	quest.235BA25F1595D62F.quest_subtitle: "낚싯대 제작"
	quest.235BA25F1595D62F.title: "물고기를 낚는다는 믿음"
	quest.2362E2130A0AA510.quest_desc: ["철 검이나 철 도끼 중 하나를 준비하세요. 지하의 적은 더 위협적이므로 돌 무기보다 안정적인 화력이 필요합니다."]
	quest.2362E2130A0AA510.quest_subtitle: "철 검 또는 철 도끼 제작"
	quest.2362E2130A0AA510.title: "강철은 아니지만 강하다"
	quest.2368BEE635B9841E.quest_desc: ["청금석을 채굴하세요. 마법 부여대에서 장비에 마법을 붙일 때 경험치와 함께 소비됩니다."]
	quest.2368BEE635B9841E.quest_subtitle: "청금석 획득"
	quest.2368BEE635B9841E.title: "파란 돌이 마법을 부린다"
	quest.236DE6C0D99A80C8.quest_desc: ["X와 Z는 수평 위치, Y는 높이를 나타냅니다."]
	quest.236DE6C0D99A80C8.quest_subtitle: "좌표 안내"
	quest.236DE6C0D99A80C8.title: "숫자는 거짓말하지 않는다"
	quest.2375A682DEA63545.quest_desc: ["선택 목표로 4단계 광물 피라미드를 완성하세요. 최대 단계에서 신호기 범위가 가장 넓어지고 보조 효과까지 선택할 수 있습니다."]
	quest.2375A682DEA63545.quest_subtitle: "최대 단계 신호기 완성"
	quest.2375A682DEA63545.title: "피라미드 사업 완공"
	quest.238047173D35A699.quest_desc: ["위더 몸체에 쓸 영혼 모래나 영혼 흙을 4개 모으세요."]
	quest.238047173D35A699.quest_subtitle: "영혼 모래 또는 영혼 흙 4개 준비"
	quest.238047173D35A699.title: "영혼까지 끌어모았습니다"
	quest.2391E50928ECF945.quest_desc: ["차원문 근처 상자에 예비 장비와 음식을 보관하세요."]
	quest.2391E50928ECF945.quest_subtitle: "예비 장비 보관"
	quest.2391E50928ECF945.title: "플랜 B는 상자 안에"
	quest.23A2306BA3721F9E.quest_desc: ["금 방어구를 입어도 피글린 앞에서 상자를 열면 공격받을 수 있습니다."]
	quest.23A2306BA3721F9E.quest_subtitle: "피글린 중립 조건"
	quest.23A2306BA3721F9E.title: "금을 입으면 친구인 척"
	quest.23C71F33BF655C03.quest_desc: ["수중 호흡, 우유와 좋은 장비를 준비해 해저 유적을 탐색하세요."]
	quest.23C71F33BF655C03.quest_subtitle: "해저 유적 안내"
	quest.23C71F33BF655C03.title: "바다의 주인은 누구인가"
	quest.23C8FD0BE2812004.quest_desc: ["사망하면 Corpse가 아이템을 보관하므로 준비해서 시체를 회수하세요."]
	quest.23C8FD0BE2812004.quest_subtitle: "사망과 아이템 회수 설명"
	quest.23C8FD0BE2812004.title: "죽어도 다시 한 번"
	quest.23C9E89B45435A41.quest_desc: ["양조와 엔더의 눈에 쓸 블레이즈 막대를 여러 개 확보하세요."]
	quest.23C9E89B45435A41.quest_subtitle: "블레이즈 막대 획득"
	quest.23C9E89B45435A41.title: "불막대기 획득"
	quest.23CF33578CCDEC88.quest_desc: ["피스톤이나 횃불을 이용해 드래곤 알을 아이템으로 얻으세요. 첫 드래곤 처치에서만 생기는 고유한 기념품이므로 잃어버리지 않게 보관하세요."]
	quest.23CF33578CCDEC88.quest_subtitle: "드래곤 알 획득"
	quest.23CF33578CCDEC88.title: "알은 건드리면 도망갑니다"
	quest.23E97717160E9740.quest_desc: ["외곽 섬에서 엔드 도시를 찾으세요. 엔드 도시는 셜커 껍데기, 고급 장비와 겉날개로 이어지는 핵심 구조물입니다."]
	quest.23E97717160E9740.quest_subtitle: "엔드 도시 발견"
	quest.23E97717160E9740.title: "게임 끝에 도시가 있었다"
	quest.23F2794CB6E0444E.quest_desc: ["유리, 흑요석과 네더의 별로 신호기를 만드세요. 광물 피라미드와 함께 설치하면 넓은 범위에 지속적인 강화 효과를 제공합니다."]
	quest.23F2794CB6E0444E.quest_subtitle: "신호기 제작"
	quest.23F2794CB6E0444E.title: "빛이 있으라 2"
	quest.24039B1AB38B5053.quest_desc: ["위더는 지형을 크게 파괴하므로 마지막 해골을 놓기 전에 전장을 준비하세요."]
	quest.24039B1AB38B5053.quest_subtitle: "위더 소환과 지형 파괴 위험 소개"
	quest.24039B1AB38B5053.title: "내가 만든 보스에 내가 당한다"
	quest.240F2D33718F37EA.quest_desc: ["숫돌로 저주를 제외한 대부분의 마법을 제거하세요."]
	quest.240F2D33718F37EA.quest_subtitle: "숫돌 사용"
	quest.240F2D33718F37EA.title: "없던 마법으로 하겠습니다"
	quest.241233BC1ACE1C04.quest_desc: ["화약은 마시는 물약을 투척용 물약으로 바꿉니다."]
	quest.241233BC1ACE1C04.quest_subtitle: "투척용 물약"
	quest.241233BC1ACE1C04.title: "마시는 것보다 던지는 게 빠르다"
	quest.24126090A651A73F.quest_desc: ["용암 처리와 추락 대비를 위해 물 양동이를 준비하세요."]
	quest.24126090A651A73F.quest_subtitle: "물 양동이 획득"
	quest.24126090A651A73F.title: "물은 답을 알고 있다 2"
	quest.242DB03DB309BF1B.quest_desc: ["농부와 작물을 거래해 에메랄드를 확보하세요. 자동화하기 쉬운 작물을 에메랄드로 바꾸면 다른 주민 거래의 비용을 마련할 수 있습니다."]
	quest.242DB03DB309BF1B.quest_subtitle: "농부 거래"
	quest.242DB03DB309BF1B.title: "농부는 모든 것을 알고 있다"
	quest.24375E7F0F1F4684.quest_desc: ["작동하는 신호기를 완성해 위더 분기를 마치세요."]
	quest.24375E7F0F1F4684.quest_subtitle: "위더 분기 완료"
	quest.24375E7F0F1F4684.title: "보스도 잡고 별도 따고"
	quest.2437A17A242F5910.quest_desc: ["밀림 피라미드의 실과 발사기 함정을 확인하며 탐색하세요."]
	quest.2437A17A242F5910.quest_subtitle: "밀림 피라미드를 찾고 발사기와 실 함정을 조심하며 탐색"
	quest.2437A17A242F5910.title: "밀림의 함정"
	quest.243B6C84F095ED17.quest_desc: ["물, 용암과 우유를 담을 양동이를 만드세요."]
	quest.243B6C84F095ED17.quest_subtitle: "양동이 제작"
	quest.243B6C84F095ED17.title: "무엇이든 담아드립니다"
	quest.243E44363E4506BD.quest_desc: ["원목을 판자 4개 이상으로 가공하세요. 판자는 작업대, 막대기와 거처에 두루 쓰이는 기본 재료입니다."]
	quest.243E44363E4506BD.quest_subtitle: "판자 제작"
	quest.243E44363E4506BD.title: "원목의 정상화"
	quest.24422C192DBE3B20.quest_desc: ["네더에 진입한 뒤 지형이 로드될 때까지 움직이지 마세요. 주변 용암과 낭떠러지를 확인한 뒤 차원문을 보호해야 귀환 경로를 잃지 않습니다."]
	quest.24422C192DBE3B20.quest_subtitle: "네더 진입"
	quest.24422C192DBE3B20.title: "여기가 어디요"
	quest.246F7468C9CFB9B1.quest_desc: ["광물 피라미드 위에 신호기를 놓고 효과를 선택하세요. 활성화된 신호기는 채굴, 이동과 전투 효율을 영구적으로 높여 대형 작업에 유용합니다."]
	quest.246F7468C9CFB9B1.quest_subtitle: "신호기 활성화"
	quest.246F7468C9CFB9B1.title: "저 높은 곳을 향하여"
	quest.247BF94E4EAD98F8.quest_desc: ["연료와 횃불 재료로 쓸 석탄이나 숯을 얻으세요."]
	quest.247BF94E4EAD98F8.quest_subtitle: "석탄 또는 숯 획득"
	quest.247BF94E4EAD98F8.title: "검은 것이 연료로다"
	quest.248B0FAD159182E9.quest_desc: ["생성기와 전리품 상자가 있는 몬스터 방을 찾으세요. 생성기는 경험치와 몬스터 전리품을 반복 생산하는 시설로 활용할 수 있습니다."]
	quest.248B0FAD159182E9.quest_subtitle: "몬스터 방 발견"
	quest.248B0FAD159182E9.title: "방은 방인데 주인이 많다"
	quest.24996CB1BB5861FC.quest_desc: ["돌 곡괭이 이상으로 철 원석을 채굴하세요. 철은 더 높은 등급의 채굴, 방어구와 여러 기능성 블록에 필요한 첫 핵심 광물입니다."]
	quest.24996CB1BB5861FC.quest_subtitle: "철 원석 획득"
	quest.24996CB1BB5861FC.title: "철이 들어버렸다"
	quest.24A49531A3B800D3.quest_desc: ["물가에 사탕수수를 길러 종이와 폭죽 재료를 준비하세요."]
	quest.24A49531A3B800D3.quest_subtitle: "사탕수수 재배"
	quest.24A49531A3B800D3.title: "달콤한 미래"
	quest.24B94048DAF82D77.quest_desc: ["철 원석을 화로에서 제련해 철 주괴를 만드세요. 원석은 그대로 제작에 쓸 수 없으므로 먼저 주괴로 가공해야 합니다."]
	quest.24B94048DAF82D77.quest_subtitle: "철 주괴 제련"
	quest.24B94048DAF82D77.title: "뜨거운 것이 좋아"
	quest.24BC1FF5AB8AE97C.quest_desc: ["준비한 전장에 T자 몸체를 만들고 세 번째 해골을 마지막에 놓으세요."]
	quest.24BC1FF5AB8AE97C.quest_subtitle: "위더 소환"
	quest.24BC1FF5AB8AE97C.title: "해골 세 개면 충분해"
	quest.24BD4D58549E2AB9.quest_desc: ["퀘스트는 목표를 안내할 뿐이며 레시피와 기술 시대는 별도 시스템으로 관리됩니다."]
	quest.24BD4D58549E2AB9.quest_subtitle: "퀘스트가 콘텐츠를 잠그지 않음을 안내"
	quest.24BD4D58549E2AB9.title: "퀘스트는 거들 뿐"
	quest.24CEDEA6921DB89F.quest_desc: ["돌 검이나 돌 도끼 중 하나를 준비하세요. 나무 무기보다 피해량과 내구도가 높아 야간 생존이 훨씬 안정됩니다."]
	quest.24CEDEA6921DB89F.quest_subtitle: "돌 검 또는 돌 도끼 제작"
	quest.24CEDEA6921DB89F.title: "이제 말로 해결할 단계는 지났다"
	quest.24FBDB0B19577067.quest_desc: ["같은 종류의 동물 두 마리에게 번식 먹이를 주세요. 사육 개체를 늘리면 음식과 가죽, 양털 같은 자원을 반복해서 얻을 수 있습니다."]
	quest.24FBDB0B19577067.quest_subtitle: "동물 번식"
	quest.24FBDB0B19577067.title: "둘이 만나 하나가 되는"
	quest.25125955795DC581.quest_desc: ["일반 피글린의 공격을 피하려면 금 방어구를 한 부위 이상 착용하세요."]
	quest.25125955795DC581.quest_subtitle: "금 방어구 한 부위 착용"
	quest.25125955795DC581.title: "금수저 생존법"
	quest.2521BC6F34305CB4.quest_desc: ["크리퍼가 폭발하기 전에 거리를 조절해 처치하세요. 폭발을 막으면 지형과 보관품을 지키면서 화약을 얻을 수 있습니다."]
	quest.2521BC6F34305CB4.quest_subtitle: "크리퍼 처치"
	quest.2521BC6F34305CB4.title: "가까이 오면 터지는 사이"
	quest.253986523F8632C9.quest_desc: ["밤을 넘기고 리스폰 지점을 정할 침대를 만드세요."]
	quest.253986523F8632C9.quest_subtitle: "침대 제작"
	quest.253986523F8632C9.title: "누울 자리부터 보고 눕자"
	quest.254E86B7542E4BA1.quest_desc: ["양조기 연료 칸에 블레이즈 가루를 넣으세요."]
	quest.254E86B7542E4BA1.quest_subtitle: "블레이즈 가루 투입"
	quest.254E86B7542E4BA1.title: "불맛을 더했습니다"
	quest.25643C8D1C65D677.quest_desc: ["흑요석을 캘 수 있는 다이아몬드 곡괭이를 만드세요."]
	quest.25643C8D1C65D677.quest_subtitle: "다이아몬드 곡괭이 제작"
	quest.25643C8D1C65D677.title: "이 곡괭이는 이제 제 겁니다"
	quest.25656C93E2338354.quest_desc: ["구리 원석을 채굴하세요. 구리는 망원경, 피뢰침과 여러 Create 계열 제작에 폭넓게 쓰입니다."]
	quest.25656C93E2338354.quest_subtitle: "구리 원석 획득"
	quest.25656C93E2338354.title: "구리구리하네"
	quest.256971872A1E56B7.quest_desc: ["비교기와 관찰자 제작에 쓸 네더 석영을 채굴하세요."]
	quest.256971872A1E56B7.quest_subtitle: "네더 석영 획득"
	quest.256971872A1E56B7.title: "하얀 돌도 쓸모가 있다"
	quest.257C737E46060DAA.quest_desc: ["지나온 길과 작업 공간을 밝혀 뒤에서 몬스터가 생기지 않게 하세요."]
	quest.257C737E46060DAA.quest_subtitle: "조명과 몬스터 생성 설명"
	quest.257C737E46060DAA.title: "어둠은 몬스터를 낳고"
	quest.25C82B207FAFE817.quest_desc: ["흔적 폐허의 수상한 자갈을 솔로 조심스럽게 발굴하세요. 일반 도구로 부수면 내부 유물이 사라지므로 솔질이 필요합니다."]
	quest.25C82B207FAFE817.quest_subtitle: "고고학 안내"
	quest.25C82B207FAFE817.title: "솔질 한 번 하시죠"
	quest.25D50AE10F56F9F3.quest_desc: ["다 자란 밀을 수확하고 일부 씨앗은 다시 심으세요. 다음 파종분을 남겨야 식량 생산이 끊기지 않습니다."]
	quest.25D50AE10F56F9F3.quest_subtitle: "밀 수확"
	quest.25D50AE10F56F9F3.title: "내가 키운 밀"
	quest.25DB3CB1BB52DB62.quest_desc: ["최고 단계 마법 부여에는 유효한 책장 15개와 30레벨이 필요합니다."]
	quest.25DB3CB1BB52DB62.quest_subtitle: "최대 단계 조건 안내"
	quest.25DB3CB1BB52DB62.title: "30레벨의 품격"
	quest.25E74183A8B96E75.quest_desc: ["더 좋은 재료를 얻기 전 사용할 나무 검을 만드세요."]
	quest.25E74183A8B96E75.quest_subtitle: "나무 검 제작"
	quest.25E74183A8B96E75.title: "호신용입니다"
	quest.25FEE6AE3F6725C0.quest_desc: ["보물 지도의 X 표시가 있는 청크 주변을 파세요. 매장된 보물은 바다의 심장 등 다른 곳에서 얻기 어려운 재료를 제공합니다."]
	quest.25FEE6AE3F6725C0.quest_subtitle: "보물 지도를 따라 표시된 지역의 매장된 보물 발견"
	quest.25FEE6AE3F6725C0.title: "보물은 X 아래에 있다"
	quest.2609D1E1916E037F.quest_desc: ["근거지 도서관에서 책과 거미줄 등 유용한 물자를 챙기세요. 많은 책을 한꺼번에 확보해 마법 부여 시설과 장식에 활용할 수 있습니다."]
	quest.2609D1E1916E037F.quest_subtitle: "근거지 도서관 발견"
	quest.2609D1E1916E037F.title: "지하 도서관에 오신 것을 환영합니다"
	quest.260F77B06A848314.quest_desc: ["방어구도 내구도가 닳으므로 착용 후에도 주변을 살피세요."]
	quest.260F77B06A848314.quest_subtitle: "방어구 설명"
	quest.260F77B06A848314.title: "맞기 전에 입자"
	quest.261C3E67E4E6AE43.quest_desc: ["레드스톤 신호는 15에서 시작해 블록마다 1씩 약해집니다."]
	quest.261C3E67E4E6AE43.quest_subtitle: "신호 세기"
	quest.261C3E67E4E6AE43.title: "멀어지면 희미해지는 사이"
	quest.2627CC14E83E02BC.quest_desc: ["선택 목표로 빈 유리병에 드래곤의 숨결을 담으세요. 드래곤의 숨결은 일정 지역에 효과를 남기는 잔류형 물약의 핵심 재료입니다."]
	quest.2627CC14E83E02BC.quest_subtitle: "드래곤의 숨결 획득"
	quest.2627CC14E83E02BC.title: "숨결까지 알뜰하게"
	quest.2645AD58B01D63FE.quest_desc: ["소환 충전이 끝날 때 큰 폭발이 일어나므로 미리 거리를 벌리세요."]
	quest.2645AD58B01D63FE.quest_subtitle: "생성 직후 폭발과 거리 확보 안내"
	quest.2645AD58B01D63FE.title: "폭발은 예고되었습니다"
	quest.26492CCC83A0441F.quest_desc: ["엔드 수정은 드래곤을 회복시키므로 가장 먼저 처리해야 합니다."]
	quest.26492CCC83A0441F.quest_subtitle: "엔드 수정의 회복 기능 설명"
	quest.26492CCC83A0441F.title: "저 수정이 범인입니다"
	quest.264FB21F62CC57A3.quest_desc: ["수선은 손에 들거나 착용한 장비의 내구도를 획득 경험치로 복구합니다."]
	quest.264FB21F62CC57A3.quest_subtitle: "수선 작동 방식과 획득처 안내"
	quest.264FB21F62CC57A3.title: "고쳐 쓰는 것이 미덕"
	quest.2656558113183F41.quest_desc: ["갑옷 제조인, 도구 대장장이 또는 무기 대장장이와 거래하세요. 충분히 성장시킨 주민은 채굴 없이도 강한 장비를 공급합니다."]
	quest.2656558113183F41.quest_subtitle: "대장장이 계열 거래"
	quest.2656558113183F41.title: "장비는 주민에게"
	quest.266EA9A8485ED99A.quest_desc: ["좀벌레가 늘어나기 전에 생성기 주변을 통제하세요."]
	quest.266EA9A8485ED99A.quest_subtitle: "좀벌레 생성기 처리 안내"
	quest.266EA9A8485ED99A.title: "돌에서 벌레가 왜 나와"
	quest.26742BC73BBEE275.quest_desc: ["수리, 이름 변경과 마법 결합에 사용할 모루를 만드세요."]
	quest.26742BC73BBEE275.quest_subtitle: "모루 제작"
	quest.26742BC73BBEE275.title: "모루겠으면 외우세요"
	quest.2683A9B7D4981410.quest_desc: ["최소 크기 네더 차원문에 필요한 흑요석 10개를 캐세요."]
	quest.2683A9B7D4981410.quest_subtitle: "흑요석 획득"
	quest.2683A9B7D4981410.title: "검고 단단한 그것"
	quest.26ACDF5E4D0DBBB0.quest_desc: ["JEI에서 아이템을 검색하고 제작법과 사용처 확인 키를 익히세요. 레시피가 많은 모드팩에서는 JEI가 가장 중요한 참고서입니다."]
	quest.26ACDF5E4D0DBBB0.quest_subtitle: "레시피 북, JEI 검색과 사용처 확인법"
	quest.26ACDF5E4D0DBBB0.title: "모르면 JEI에게 물어봐"
	quest.26ADAD408D6777B0.quest_desc: ["피스톤에 신호를 주어 움직일 수 있는 블록을 미세요."]
	quest.26ADAD408D6777B0.quest_subtitle: "피스톤"
	quest.26ADAD408D6777B0.title: "밀어드립니다"
	quest.26AFB3538EBB1ABB.quest_desc: ["흙, 모래와 자갈을 빠르게 파는 나무 삽을 만드세요."]
	quest.26AFB3538EBB1ABB.quest_subtitle: "나무 삽 제작"
	quest.26AFB3538EBB1ABB.title: "삽질도 기술이다"
	quest.270A46992DCED9E2.quest_desc: ["요새 농장이나 보루 전리품에서 네더 사마귀를 얻으세요. 대부분의 효과 물약은 네더 사마귀로 만든 어색한 물약에서 시작합니다."]
	quest.270A46992DCED9E2.quest_subtitle: "네더 사마귀 획득"
	quest.270A46992DCED9E2.title: "빨간 혹 같은 그것"
	quest.271398FBD71A64FF.quest_desc: ["양털, 나뭇잎, 덩굴과 거미줄에 사용할 가위를 만드세요."]
	quest.271398FBD71A64FF.quest_subtitle: "가위 제작"
	quest.271398FBD71A64FF.title: "깎아 주세요"
	quest.272150786C755A60.quest_desc: ["갈림길 표시를 통일하고 탐색이 끝난 막다른 길은 구분하세요."]
	quest.272150786C755A60.quest_subtitle: "길 표시"
	quest.272150786C755A60.title: "왔던 길도 다시 보자"
	quest.2722B782024D7FA3.quest_desc: ["엔더 진주와 블레이즈 가루로 엔더의 눈을 만드세요. 엔더의 눈은 근거지를 추적하고 엔드 차원문을 완성하는 열쇠입니다."]
	quest.2722B782024D7FA3.quest_subtitle: "엔더의 눈 제작"
	quest.2722B782024D7FA3.title: "눈에는 눈, 진주에는 가루"
	quest.2723F8E14746A659.quest_desc: ["마법이 부여된 책을 얻으세요. 원하는 마법을 보관했다가 모루로 적합한 장비에 옮길 수 있습니다."]
	quest.2723F8E14746A659.quest_subtitle: "마법이 부여된 책 획득"
	quest.2723F8E14746A659.title: "책으로 배웠습니다"
	quest.27369B22C0A6CC65.quest_desc: ["우유는 위더 효과와 이로운 효과를 모두 제거하므로 필요할 때만 마시세요."]
	quest.27369B22C0A6CC65.quest_subtitle: "위더 상태 효과 제거용 우유 준비"
	quest.27369B22C0A6CC65.title: "우유는 답을 알고 있다"
	quest.2745E1F6DCD67D4D.quest_desc: ["탈출 경로를 먼저 정한 뒤 고대 도시 상자를 여세요."]
	quest.2745E1F6DCD67D4D.quest_subtitle: "고대 도시 상자 전리품 획득"
	quest.2745E1F6DCD67D4D.title: "조용히 챙기고 조용히 나갑시다"
	quest.274EC933EFDB9616.quest_desc: ["사서에게서 책장, 유리나 유용한 마법책을 거래하세요. 특히 수선처럼 제작할 수 없는 마법을 안정적으로 확보할 수 있습니다."]
	quest.274EC933EFDB9616.quest_subtitle: "사서 거래"
	quest.274EC933EFDB9616.title: "책 좀 읽으셨네요"
	quest.2750274BD6574992.quest_desc: ["눈덩이나 화살로 이동 경로 반대편에 진동을 만드세요."]
	quest.2750274BD6574992.quest_subtitle: "눈덩이 또는 화살로 진동 유도"
	quest.2750274BD6574992.title: "소리는 저쪽에서 났습니다"
	quest.2753315078FF303B.quest_desc: ["싹 틔우는 자수정을 남겨 두고 자수정 조각만 채집하세요. 싹 틔우는 자수정은 옮길 수 없는 재생 자원이므로 보존해야 계속 수확할 수 있습니다."]
	quest.2753315078FF303B.quest_subtitle: "자수정 정동 발견"
	quest.2753315078FF303B.title: "반짝반짝 작은 정동"
	quest.276210F28C8CD376.quest_desc: ["출입구를 안전하게 닫을 문을 만드세요."]
	quest.276210F28C8CD376.quest_subtitle: "문 제작"
	quest.276210F28C8CD376.title: "문단속은 철저하게"
	quest.2776ED94E843D970.quest_desc: ["좀비를 처치하고 주변에서 증원 좀비가 나타나는지 살피세요. 흔한 적부터 상대하며 공격 간격과 거리 조절을 익힐 수 있습니다."]
	quest.2776ED94E843D970.quest_subtitle: "좀비 처치"
	quest.2776ED94E843D970.title: "걸어 다니는 유통기한"
	quest.278293B9205CDD1B.quest_desc: ["전투가 끝날 때까지 먹을 좋은 음식을 충분히 챙기세요."]
	quest.278293B9205CDD1B.quest_subtitle: "음식 준비"
	quest.278293B9205CDD1B.title: "싸움도 식후경"
	quest.2782CA9338D0A483.quest_desc: ["레버로 레드스톤 가루와 레드스톤 조명을 작동시키세요. 입력과 출력의 관계를 익히면 문과 조명 같은 장치를 직접 제어할 수 있습니다."]
	quest.2782CA9338D0A483.quest_subtitle: "레버와 레드스톤 램프"
	quest.2782CA9338D0A483.title: "빨간 맛 전력"
	quest.278FD162EC9890DE.quest_desc: ["네더에서 침대는 폭발하므로 차원문과 시설 근처에서 사용하지 마세요."]
	quest.278FD162EC9890DE.quest_subtitle: "침대 폭발 경고"
	quest.278FD162EC9890DE.title: "누우면 큰일 납니다"
	quest.27922FE1A280A8C4.quest_desc: ["피격 전에 방패를 들고, 도끼가 방패를 잠시 무력화할 수 있음을 기억하세요."]
	quest.27922FE1A280A8C4.quest_subtitle: "방패 사용"
	quest.27922FE1A280A8C4.title: "방패로 막았다고 합니다"
	quest.27C76242FD357969.quest_desc: ["비교기는 신호를 비교하고 보관함의 채움 정도를 읽습니다."]
	quest.27C76242FD357969.quest_subtitle: "비교기"
	quest.27C76242FD357969.title: "비교를 거부할 수 없다"
	quest.27DDEBE769354FED.quest_desc: ["섬세한 손길로 스컬크를 채집하고 경험치 저장 방식을 확인하세요."]
	quest.27DDEBE769354FED.quest_subtitle: "스컬크 블록 획득 또는 관찰"
	quest.27DDEBE769354FED.title: "이끼인 줄 알았는데 듣고 있습니다"
	quest.27E94D31418A7BE8.quest_desc: ["주민과 거래를 한 번 완료하세요. 거래를 반복하면 주민 등급이 올라 더 좋은 품목이 열립니다."]
	quest.27E94D31418A7BE8.quest_subtitle: "첫 거래"
	quest.27E94D31418A7BE8.title: "흥정은 없습니다"
	quest.27F9DA0D6A958B3D.quest_desc: ["섬세한 손길로 스컬크 비명체를 채집하세요. 설치한 비명체는 워든을 소환하지 않습니다."]
	quest.27F9DA0D6A958B3D.quest_subtitle: "스컬크 비명체의 경고 단계 설명"
	quest.27F9DA0D6A958B3D.title: "소리 지르지 마"
	quest.27FB23EDF4A4FF37.quest_desc: ["누적 100초 동안 웅크리세요. 웅크린 이동은 대부분의 발걸음 진동을 만들지 않아 감지기와 워든을 피하는 기본 행동입니다."]
	quest.27FB23EDF4A4FF37.quest_subtitle: "스컬크 감지기 근처에서 웅크리고 이동"
	quest.27FB23EDF4A4FF37.title: "쉿, 조용히 해"
	quest.28223A99A5DD3016.quest_desc: ["셜커 껍데기 2개를 모으세요. 껍데기 두 개로 내용물을 유지한 채 운반할 수 있는 셜커 상자를 만들 수 있습니다."]
	quest.28223A99A5DD3016.quest_subtitle: "셜커 껍데기 획득"
	quest.28223A99A5DD3016.title: "껍데기는 남는다"
	quest.282D4717D7E2BE05.quest_desc: ["밀 3개로 빵을 만드세요. 빵은 별도 조리 없이 만들 수 있어 초반의 꾸준한 휴대 식량이 됩니다."]
	quest.282D4717D7E2BE05.quest_subtitle: "빵 제작"
	quest.282D4717D7E2BE05.title: "빵이 없으면 밀을 먹...지는 맙시다"
	quest.2843C8BB0B6A8C51.quest_desc: ["탐험 중 부족하지 않도록 익힌 음식을 여유 있게 챙기세요."]
	quest.2843C8BB0B6A8C51.quest_subtitle: "익힌 음식 준비"
	quest.2843C8BB0B6A8C51.title: "익혀야 제맛"
	quest.2848CD423C444B56.quest_desc: ["E 키로 인벤토리를 열어 방어구 슬롯, 제작 칸과 JEI 목록을 확인하세요. 아이템 제작과 장비 관리는 대부분 이 화면에서 시작됩니다."]
	quest.2848CD423C444B56.quest_subtitle: "인벤토리 열기"
	quest.2848CD423C444B56.title: "주머니 사정부터 확인합시다"
	quest.2857C49A2D0D7EEB.quest_desc: ["벽을 오를 수 있는 거미를 처치하세요. 거미가 주는 실은 활, 낚싯대와 양털 제작에 쓰입니다."]
	quest.2857C49A2D0D7EEB.quest_subtitle: "거미 처치"
	quest.2857C49A2D0D7EEB.title: "거미가 줄을 타고"
	quest.28714DC98AC69692.quest_desc: ["철광석을 캘 수 있는 돌 곡괭이를 만드세요."]
	quest.28714DC98AC69692.quest_subtitle: "돌 곡괭이 제작"
	quest.28714DC98AC69692.title: "돌고 돌아 돌곡괭이"
	quest.287DB19021C0B223.quest_desc: ["엔드 관문에 엔더 진주를 던져 외곽 섬으로 이동하세요."]
	quest.287DB19021C0B223.quest_subtitle: "외곽 엔드 섬 도달"
	quest.287DB19021C0B223.title: "끝의 바깥쪽"
	quest.2894465774576B89.quest_desc: ["엔드 수정과 비행 중인 드래곤을 공격할 활이나 쇠뇌를 준비하세요."]
	quest.2894465774576B89.quest_subtitle: "활 또는 쇠뇌 준비"
	quest.2894465774576B89.title: "거리는 곧 생명이다"
	quest.28969B87B3D90E53.quest_desc: ["유도 탄환을 엄폐물로 피하며 셜커를 처치하세요. 셜커가 주는 껍데기는 내용물을 보존하는 셜커 상자의 재료입니다."]
	quest.28969B87B3D90E53.quest_subtitle: "셜커 처치"
	quest.28969B87B3D90E53.title: "열리면 맞고 맞으면 뜹니다"
	quest.289AA3B5E7DC9007.quest_desc: ["호글린은 금 방어구와 무관하게 공격하며 뒤틀린 균을 피합니다."]
	quest.289AA3B5E7DC9007.quest_subtitle: "호글린 주의"
	quest.289AA3B5E7DC9007.title: "쟤는 금을 몰라요"
	quest.289C47C1AAA8FE2E.quest_desc: ["주민은 근무 시간에 작업대에 접근할 수 있어야 거래를 보충합니다."]
	quest.289C47C1AAA8FE2E.quest_subtitle: "재입고 조건 안내"
	quest.289C47C1AAA8FE2E.title: "재고가 돌아왔다"
	quest.28A69A83D01944B2.quest_desc: ["엔더맨, 추락과 탑 하강에 대비해 물 양동이를 챙기세요."]
	quest.28A69A83D01944B2.quest_subtitle: "물 양동이 준비"
	quest.28A69A83D01944B2.title: "물 한 바가지의 기적"
	quest.28A9066994CC950D.quest_desc: ["네더라이트 주괴를 만들고 강화 형판으로 장비를 업그레이드하세요."]
	quest.28A9066994CC950D.quest_subtitle: "네더라이트 장비 제작"
	quest.28A9066994CC950D.title: "업그레이드는 못 참지"
	quest.28AA7B0C8DAB164A.quest_desc: ["용암과 추락을 피하려면 계단식이나 두 칸 확인 방식으로 내려가세요."]
	quest.28AA7B0C8DAB164A.quest_subtitle: "수직 채굴 위험 안내"
	quest.28AA7B0C8DAB164A.title: "내 발밑이 낭떠러지"
	quest.28AE2D2D8046D748.quest_desc: ["벌목과 초반 전투에 쓸 나무 도끼를 만드세요."]
	quest.28AE2D2D8046D748.quest_subtitle: "나무 도끼 제작"
	quest.28AE2D2D8046D748.title: "나무꾼의 자격"
	quest.28B58871792FA331.quest_desc: ["고대 도시 상자에서 음반 파편 5를 얻으세요. 파편 9개를 모으면 고대 도시의 이야기를 담은 음반 5를 복원할 수 있습니다."]
	quest.28B58871792FA331.quest_subtitle: "음반 파편 획득"
	quest.28B58871792FA331.title: "조각난 음악의 기억"
	quest.28C0D79B888A8041.quest_desc: ["전투 전체에 쓸 화살을 넉넉하게 준비하세요."]
	quest.28C0D79B888A8041.quest_subtitle: "충분한 화살 준비"
	quest.28C0D79B888A8041.title: "화살은 많을수록 좋다"
	quest.28F84E0C8F487635.quest_desc: ["양털 블록과 양탄자는 감지기 주변의 여러 진동을 막거나 줄입니다."]
	quest.28F84E0C8F487635.quest_subtitle: "양털로 진동을 차단하는 방법 안내"
	quest.28F84E0C8F487635.title: "양털은 생각보다 조용하다"
	quest.28F9EF64615A116B.quest_desc: ["철 방어구 한 부위 이상을 만들어 착용하세요. 방어구는 실수 한 번이 사망으로 이어지는 상황을 줄여 줍니다."]
	quest.28F9EF64615A116B.quest_subtitle: "철 방어구 한 부위 제작"
	quest.28F9EF64615A116B.title: "입으면 단단해집니다"
	quest.28FF9EEBA1168340.quest_desc: ["두 칸 높이 공간을 이용해 안전하게 엔더맨을 처치하세요. 엔더 진주는 근거지를 찾고 엔드로 진행하는 데 필요합니다."]
	quest.28FF9EEBA1168340.quest_subtitle: "엔더맨 처치와 시선 판정 설명"
	quest.28FF9EEBA1168340.title: "눈을 마주치지 말아요"
	quest.294EB5CFB6162D85.quest_desc: ["책, 다이아몬드와 흑요석으로 마법 부여대를 만드세요."]
	quest.294EB5CFB6162D85.quest_subtitle: "마법 부여대 제작"
	quest.294EB5CFB6162D85.title: "마법은 장비빨"
	quest.295056F543D97C20.quest_desc: ["네더 요새에서 위더 스켈레톤을 처치하세요. 위더를 소환하려면 이들이 낮은 확률로 떨어뜨리는 해골 세 개가 필요합니다."]
	quest.295056F543D97C20.quest_subtitle: "위더 스켈레톤 처치"
	quest.295056F543D97C20.title: "뼈대 있는 집안"
	quest.29525BE6E014E9E8.quest_desc: ["조약돌을 3개 이상 채굴하세요. 조약돌로 만든 도구부터 철광석을 채굴할 수 있습니다."]
	quest.29525BE6E014E9E8.quest_subtitle: "조약돌 3개 획득"
	quest.29525BE6E014E9E8.title: "돌을 돌려드립니다"
	quest.29638C6B24B2BDC3.quest_desc: ["물약이나 물물교환 등으로 화염 저항 효과를 준비하세요."]
	quest.29638C6B24B2BDC3.quest_subtitle: "화염 저항 획득"
	quest.29638C6B24B2BDC3.title: "뜨거운 형제들"
	quest.29904C30882B35A7.quest_desc: ["다이아몬드를 찾아 채굴하세요. 다이아몬드 도구는 흑요석을 채굴하고 네더로 진입하기 위한 핵심 장비입니다."]
	quest.29904C30882B35A7.quest_subtitle: "다이아몬드 획득"
	quest.29904C30882B35A7.title: "다이아몬드는 영원하다"
	quest.299073A0221D05B5.quest_desc: ["엔드 도시에 연결된 엔드 함선을 찾아 안전하게 올라가세요. 엔드 함선은 바닐라에서 겉날개를 얻을 수 있는 유일한 장소입니다."]
	quest.299073A0221D05B5.quest_subtitle: "엔드 함선 발견"
	quest.299073A0221D05B5.title: "배는 있는데 바다는 없다"
	quest.29A05C6E6619C14A.quest_desc: ["용암 근처에서는 물 양동이를 즉시 꺼낼 수 있게 준비하세요."]
	quest.29A05C6E6619C14A.quest_subtitle: "용암과 물 양동이 사용법"
	quest.29A05C6E6619C14A.title: "뜨거우니 조심하세요"
	quest.29A696583A463B4F.quest_desc: ["공격 표시기가 다시 찬 뒤 때려야 근접 공격이 최대 피해를 냅니다."]
	quest.29A696583A463B4F.quest_subtitle: "Java Edition 공격 충전 설명"
	quest.29A696583A463B4F.title: "때에도 때가 있다"
	quest.29AEAD149607137A.quest_desc: ["모든 깔때기의 출구 방향을 확인하며 물류선을 연결하세요. 방향을 이해해야 상자와 기계 사이에서 아이템을 자동으로 옮길 수 있습니다."]
	quest.29AEAD149607137A.quest_subtitle: "호퍼 연결"
	quest.29AEAD149607137A.title: "물류가 흐르는 방향"
	quest.29C6D3A5C0AAACAF.quest_desc: ["보루 잔해를 찾고 금 방어구가 피글린 야수에게는 통하지 않음을 기억하세요. 보루에서는 네더라이트 강화 형판과 희귀 전리품을 확보할 수 있습니다."]
	quest.29C6D3A5C0AAACAF.quest_subtitle: "보루 잔해 발견"
	quest.29C6D3A5C0AAACAF.title: "그 시절 우리는 보루에 있었다"
	quest.29DA17247C728116.quest_desc: ["네더의 수평 1블록은 오버월드의 수평 8블록에 해당합니다."]
	quest.29DA17247C728116.quest_subtitle: "네더 좌표 비율"
	quest.29DA17247C728116.title: "8배 빠른 길"
	quest.29E0F676B8EDF5D4.quest_desc: ["자연 회복은 허기와 포만도를 소비하므로 음식을 충분히 먹어야 합니다."]
	quest.29E0F676B8EDF5D4.quest_subtitle: "자연 회복 조건 설명"
	quest.29E0F676B8EDF5D4.title: "밥이 보약이다"
	quest.29EE7D960C576326.quest_desc: ["화염 저항과 건축 블록을 챙기고 발밑을 바로 파지 마세요."]
	quest.29EE7D960C576326.quest_subtitle: "용암 지형 안전"
	quest.29EE7D960C576326.title: "발밑이 뜨겁습니다"
	quest.2A06ACA38C008EA7.quest_desc: ["기계 동력과 자동화는 별도의 Create 기술 퀘스트라인에서 이어집니다."]
	quest.2A06ACA38C008EA7.quest_subtitle: "Create 기술 시대 퀘스트라인 안내"
	quest.2A06ACA38C008EA7.title: "톱니바퀴를 돌릴 시간"
	quest.2A5750050800C247.quest_desc: ["청금석과 경험치 레벨을 사용해 장비 하나에 마법을 부여하세요."]
	quest.2A5750050800C247.quest_subtitle: "첫 마법 부여"
	quest.2A5750050800C247.title: "주문하신 마법 나왔습니다"
	quest.2A6B9C2D4E7F8051.quest_desc: [
		"이 퀘스트북은 콘텐츠를 잠그거나 플레이를 강제하지 않습니다. 모드팩의 핵심 시스템과 추천 진행 순서를 알려주는 안내서로 사용하세요."
		"체크 표시가 목표인 안내 퀘스트는 내용을 확인한 뒤 직접 완료하면 됩니다."
	]
	quest.2A6B9C2D4E7F8051.quest_subtitle: "모드팩과 퀘스트북 소개"
	quest.2A6B9C2D4E7F8051.title: "먼저 읽어주세요"
	quest.2A6B9C2D4E7F8052.quest_desc: [
		"인벤토리 왼쪽 위의 파란 지도 아이콘이나 기본 M 키로 FTB Chunks 지도를 여세요."
		"보호할 청크를 왼쪽 클릭하면 점유되고, 드래그하면 여러 청크를 한 번에 점유할 수 있습니다. 오른쪽 클릭은 점유를 해제합니다."
		"점유한 청크는 다른 플레이어의 블록 파괴·설치와 상호작용으로부터 기지를 보호합니다. Shift 클릭의 강제 로딩은 보호와 별개의 기능입니다."
	]
	quest.2A6B9C2D4E7F8052.quest_subtitle: "FTB Chunks로 청크 점유와 보호"
	quest.2A6B9C2D4E7F8052.title: "여긴 이제 제 땅입니다"
	quest.2A77350D551791D2.quest_desc: ["내구도를 수리한 완전한 방어구 세트를 준비하세요."]
	quest.2A77350D551791D2.quest_subtitle: "방어구 준비"
	quest.2A77350D551791D2.title: "갑옷은 배신하지 않는다"
	quest.2A7B892355827F39.quest_desc: ["안전한 겉날개 추진용으로 폭발 탄두 없는 폭죽 로켓을 만드세요."]
	quest.2A7B892355827F39.quest_subtitle: "폭죽 로켓 제작"
	quest.2A7B892355827F39.title: "추진력을 얻기 위함이었다"
	quest.2AAAA6367C6F6333.quest_desc: ["탐험 전 귀중품을 보관할 상자를 만드세요."]
	quest.2AAAA6367C6F6333.quest_subtitle: "상자 제작"
	quest.2AAAA6367C6F6333.title: "넣을 곳이 필요해"
	quest.2AC0124A99F9493D.quest_desc: ["뼈로 늑대를 길들이고 목줄이 생겼는지 확인하세요. 길들인 늑대는 주인을 따라다니며 전투를 돕습니다."]
	quest.2AC0124A99F9493D.quest_subtitle: "늑대 길들이기"
	quest.2AC0124A99F9493D.title: "오늘부터 1일"
	quest.2AC30C39C6F2A053.quest_desc: ["비명체 경고가 반복되면 워든이 나오므로 경고 단계가 오르기 전에 벗어나세요."]
	quest.2AC30C39C6F2A053.quest_subtitle: "워든의 목적, 높은 공격력과 회피 원칙 설명"
	quest.2AC30C39C6F2A053.title: "잡는 거 아닙니다"
	quest.2AD72E75FF8F6967.quest_desc: ["철 방어구 네 부위를 모두 준비하세요. 전신을 보호해야 깊은 동굴과 네더 탐사의 위험을 안정적으로 감당할 수 있습니다."]
	quest.2AD72E75FF8F6967.quest_subtitle: "철 방어구 전체 착용"
	quest.2AD72E75FF8F6967.title: "철통 방어"
	quest.2AED3403409C973C.quest_desc: ["준비가 되면 귀환 차원문으로 들어가 오버월드로 돌아오세요. 엔드의 시를 본 뒤에도 같은 월드에서 외곽 엔드와 포스트게임을 계속 진행할 수 있습니다."]
	quest.2AED3403409C973C.quest_subtitle: "귀환 차원문 진입"
	quest.2AED3403409C973C.title: "집으로 가는 길"
	quest.2AEE5B8FF0F8FF8B.quest_desc: ["가까이 가기 위험한 적을 상대할 활을 만드세요. 원거리 공격은 크리퍼, 블레이즈와 엔드 수정처럼 접근이 위험한 목표에 필요합니다."]
	quest.2AEE5B8FF0F8FF8B.quest_subtitle: "활 제작"
	quest.2AEE5B8FF0F8FF8B.title: "가까이 오지 마세요"
	quest.2B067B1F677E454B.quest_desc: ["공격 버튼을 누른 채 블록 하나를 끝까지 파괴하세요. 자원 채집은 도구와 거처를 마련하는 첫 단계입니다."]
	quest.2B067B1F677E454B.quest_subtitle: "블록 파괴 방법 안내"
	quest.2B067B1F677E454B.title: "일단 때려 봅시다"
	quest.2B1867CE61AF1D8B.quest_desc: ["천천히 다가가 생대구나 생연어로 고양이를 길들이세요. 고양이는 크리퍼와 팬텀을 쫓아내 기지 안전에 도움을 줍니다."]
	quest.2B1867CE61AF1D8B.quest_subtitle: "고양이 길들이기"
	quest.2B1867CE61AF1D8B.title: "집사 간택 완료"
	quest.2B1ED371A9BBD195.quest_desc: ["블레이즈 막대를 분해해 블레이즈 가루를 만드세요. 가루는 양조기의 연료이자 엔더의 눈 제작 재료입니다."]
	quest.2B1ED371A9BBD195.quest_subtitle: "블레이즈 가루 제작"
	quest.2B1ED371A9BBD195.title: "곱게 갈아드립니다"
	quest.2B1F6B8CE7BC3902.quest_desc: ["엔더맨, 피글린 물물교환 등으로 엔더 진주를 확보하세요. 진주는 순간이동 수단이자 근거지를 찾는 엔더의 눈 재료입니다."]
	quest.2B1F6B8CE7BC3902.quest_subtitle: "엔더 진주 획득"
	quest.2B1F6B8CE7BC3902.title: "눈물은 아니고 진주입니다"
	quest.2B2542E435DBE263.quest_desc: ["음식을 굽고 광석을 제련할 화로를 만드세요."]
	quest.2B2542E435DBE263.quest_subtitle: "화로 제작"
	quest.2B2542E435DBE263.title: "불 좀 빌립시다"
	quest.2B2A7A64850EC6B2.quest_desc: ["공중 부양이 끝나기 전에 지붕 아래로 이동해 추락을 피하세요."]
	quest.2B2A7A64850EC6B2.quest_subtitle: "공중 부양 대응 안내"
	quest.2B2A7A64850EC6B2.title: "하늘을 나는 기분은 이런 걸까"
	quest.2B671527AF5A73CB.quest_desc: ["귀환 차원문 네 면에 엔드 수정 4개를 놓아 드래곤을 부활시키세요. 추가 처치는 새로운 엔드 관문을 열어 외곽 섬 탐색 경로를 늘립니다."]
	quest.2B671527AF5A73CB.quest_subtitle: "엔드 수정으로 드래곤 부활"
	quest.2B671527AF5A73CB.title: "한 번 더 하시겠습니까"
	quest.2B8D6AF946E6A047.quest_desc: ["벽, 지붕과 조명이 있는 작은 거처를 마련하세요. 안전한 작업 공간과 물자 보관 장소가 있어야 다음 탐험을 준비할 수 있습니다."]
	quest.2B8D6AF946E6A047.quest_subtitle: "벽, 지붕과 조명이 있는 거처 안내"
	quest.2B8D6AF946E6A047.title: "내 집 마련의 꿈"
	quest.2B8F4A77FC29123F.quest_desc: ["전투가 불리하면 거리를 벌리고 입구를 막은 뒤 회복하세요."]
	quest.2B8F4A77FC29123F.quest_subtitle: "불리한 전투에서 이탈"
	quest.2B8F4A77FC29123F.title: "도망친 곳에 낙원이 있다"
	quest.2B9FCC1CCBA7FE65.quest_desc: ["레드스톤 가루는 여러 물약의 지속 시간을 늘립니다."]
	quest.2B9FCC1CCBA7FE65.quest_subtitle: "레드스톤으로 지속시간 증가"
	quest.2B9FCC1CCBA7FE65.title: "오래오래 갑니다"
	quest.2BACB4531F23C29D.quest_desc: ["중계기는 신호를 15로 복구하고 지연과 방향을 설정합니다."]
	quest.2BACB4531F23C29D.quest_subtitle: "중계기"
	quest.2BACB4531F23C29D.title: "다시 한 번 말씀드립니다"
	quest.2BC365D93204FE70.quest_desc: ["방패를 만들고 공격이 닿기 전에 들어 올려 막으세요."]
	quest.2BC365D93204FE70.quest_subtitle: "방패 제작과 막기 안내"
	quest.2BC365D93204FE70.title: "응, 안 돼"
	quest.2BCD814B11C9795E.quest_desc: ["엄폐물을 이용해 화염구를 피하며 블레이즈를 처치하세요. 블레이즈가 주는 막대는 양조기와 엔더의 눈을 만드는 핵심 재료입니다."]
	quest.2BCD814B11C9795E.quest_subtitle: "블레이즈 처치"
	quest.2BCD814B11C9795E.title: "불 좀 꺼 줄래"
	quest.2BE0706CBF280953.quest_desc: ["금 원석을 채굴하세요. 금은 주요 제작뿐 아니라 네더에서 피글린과 안전하게 거래하는 데 필요합니다."]
	quest.2BE0706CBF280953.quest_subtitle: "금 원석 획득"
	quest.2BE0706CBF280953.title: "금 나와라 뚝딱"
	quest.2BF79498183370C6.quest_desc: ["호환되는 상자 두 개를 나란히 놓아 큰 상자를 만드세요. 저장 공간을 넉넉히 확보하면 필요한 재료를 버리지 않고 모아 둘 수 있습니다."]
	quest.2BF79498183370C6.quest_subtitle: "큰 상자 만들기"
	quest.2BF79498183370C6.title: "두 배로 모시겠습니다"
	quest.2BF93C6AFE19E58C.quest_desc: ["약탈자 전초기지를 찾고 불길한 병 사용에 주의하세요."]
	quest.2BF93C6AFE19E58C.quest_subtitle: "약탈자 전초기지를 찾고 불길한 병을 주의하며 탐색"
	quest.2BF93C6AFE19E58C.title: "저기 깃발이 보인다"
	quest.2BFC92150F5DF38C.quest_desc: ["블레이즈 막대와 돌로 양조기를 만드세요. 물약은 네더, 보스전과 수중 탐험의 위험을 장비만으로 버티지 않아도 되게 합니다."]
	quest.2BFC92150F5DF38C.quest_subtitle: "양조기 제작"
	quest.2BFC92150F5DF38C.title: "오늘은 내가 연금술사"
	quest.2C053EE4B2ADEA38.quest_desc: ["괭이로 흙이나 잔디를 갈아 경작지를 만드세요. 작물은 경작지에 심어야 자라므로 농장의 기반부터 마련해야 합니다."]
	quest.2C053EE4B2ADEA38.quest_subtitle: "경작지 만들기"
	quest.2C053EE4B2ADEA38.title: "땅부터 갈아엎자"
	quest.2C1D7FBBA08584DA.quest_desc: ["집 위치에 Xaero 웨이포인트를 만들고 알아보기 쉽게 이름을 붙이세요."]
	quest.2C1D7FBBA08584DA.quest_subtitle: "웨이포인트 사용"
	quest.2C1D7FBBA08584DA.title: "길 잃을 자유를 드립니다"
	quest.2C20759677319158.quest_desc: ["종이와 가죽으로 책을 만드세요. 책은 마법 부여대와 책장을 만들어 장비를 강화하는 데 필요합니다."]
	quest.2C20759677319158.quest_subtitle: "책 제작"
	quest.2C20759677319158.title: "사람은 책을 만들고 책은 장비를 만든다"
	quest.2C23B6617E2E2977.quest_desc: ["탐험 전 네더 쪽 차원문 좌표를 기록하세요."]
	quest.2C23B6617E2E2977.quest_subtitle: "차원문 좌표 기록 안내"
	quest.2C23B6617E2E2977.title: "돌아갈 좌표는 적으셨습니까"
	quest.2C376CB348F22EEF.quest_desc: ["낚싯대로 물고기 한 마리를 낚으세요. 물고기는 식량이 되며 고양이를 길들이는 데에도 쓰입니다."]
	quest.2C376CB348F22EEF.quest_subtitle: "물고기 낚기"
	quest.2C376CB348F22EEF.title: "월척이다"
	quest.2C389C7A2762CD20.quest_desc: ["엔드 함선 내부 아이템 액자에서 겉날개를 얻으세요. 겉날개와 폭죽을 함께 사용하면 장거리 탐험 시간이 크게 줄어듭니다."]
	quest.2C389C7A2762CD20.quest_subtitle: "겉날개 획득"
	quest.2C389C7A2762CD20.title: "날개를 펼쳐라"
	quest.2C455DE030CB7353.quest_desc: ["장비와 리스폰 지점을 마지막으로 확인한 뒤 엔드에 진입하세요."]
	quest.2C455DE030CB7353.quest_subtitle: "엔드 진입"
	quest.2C455DE030CB7353.title: "돌아올 수 없는 강을 건넜다"
	quest.2C4AECE8B3560B0D.quest_desc: ["거처와 광산을 밝힐 횃불을 만드세요."]
	quest.2C4AECE8B3560B0D.quest_subtitle: "횃불 제작"
	quest.2C4AECE8B3560B0D.title: "빛이 있으라"
	quest.2C58BD6BC3CA0781.quest_desc: ["물은 수평 4블록 안의 경작지를 촉촉하게 유지합니다."]
	quest.2C58BD6BC3CA0781.quest_subtitle: "농지 수분 공급 설명"
	quest.2C58BD6BC3CA0781.title: "물은 답을 알고 있다"
	quest.2C68BC2D558E0EF4.quest_desc: ["경작지를 만들 수 있는 나무 괭이를 만드세요."]
	quest.2C68BC2D558E0EF4.quest_subtitle: "나무 괭이 제작"
	quest.2C68BC2D558E0EF4.title: "농사 준비 완료"
	quest.2C77C6A1BBD32107.quest_desc: ["남는 식물을 퇴비통에 넣어 뼛가루로 바꾸세요."]
	quest.2C77C6A1BBD32107.quest_subtitle: "퇴비통과 뼛가루 안내"
	quest.2C77C6A1BBD32107.title: "남김없이 넣어드립니다"
	quest.2C95D7D3C915C4DE.quest_desc: ["허기가 낮으면 달리기와 자연 회복이 제한되므로 음식을 핫바에 두세요."]
	quest.2C95D7D3C915C4DE.quest_subtitle: "허기와 포만도 설명"
	quest.2C95D7D3C915C4DE.title: "배고파서 현기증 나요"
	quest.2C97C43BF3F3686E.quest_desc: ["체력이 절반 이하가 되면 원거리 공격이 막히므로 근접전으로 마무리하세요."]
	quest.2C97C43BF3F3686E.quest_subtitle: "체력 절반 이하의 위더 갑옷과 근접전 설명"
	quest.2C97C43BF3F3686E.title: "화살이 안 통한다고요?"
	quest.2CAEAF1A82769DD1.quest_desc: ["장비와 방어 시설을 준비한 뒤 습격에서 마을을 지키세요."]
	quest.2CAEAF1A82769DD1.quest_subtitle: "습격 발생 조건과 방어"
	quest.2CAEAF1A82769DD1.title: "마을을 지켜라"
	quest.2CAFFF7AA4EEA2D1.quest_desc: ["메아리 조각과 나침반으로 복구 나침반을 만드세요. 사망한 차원에서 잃은 시체와 아이템을 다시 찾는 데 도움을 줍니다."]
	quest.2CAFFF7AA4EEA2D1.quest_subtitle: "복구 나침반 제작"
	quest.2CAFFF7AA4EEA2D1.title: "잃어버린 나를 찾아서"
	quest.2CD0E7DBD00FCBA6.quest_desc: ["산악 지형 아래에서 Deep Dark 생물군계를 찾으세요. 이곳의 스컬크 지형은 고대 도시가 가까이 있을 가능성을 알려 줍니다."]
	quest.2CD0E7DBD00FCBA6.quest_subtitle: "Deep Dark 생물군계 발견"
	quest.2CD0E7DBD00FCBA6.title: "더 깊고 더 어둡게"
	quest.2CEF9C2C322EF548.quest_desc: ["엔드에서 침대는 폭발하므로 침대 전술은 숙련자만 시도하세요."]
	quest.2CEF9C2C322EF548.quest_subtitle: "침대 폭발 전술과 위험성 설명"
	quest.2CEF9C2C322EF548.title: "엔드에서 숙면 금지"
	quest.2CF21FABD33EDF0A.quest_desc: ["위더 소환에 필요한 해골 3개를 모두 모으세요."]
	quest.2CF21FABD33EDF0A.quest_subtitle: "해골 3개 준비"
	quest.2CF21FABD33EDF0A.title: "삼두정치의 시작"
	quest.2CF9DF9E80FDC356.quest_desc: ["확보한 전리품을 가지고 안전한 곳으로 귀환하세요."]
	quest.2CF9DF9E80FDC356.quest_subtitle: "주요 전리품을 확보하고 오버월드로 귀환"
	quest.2CF9DF9E80FDC356.title: "들어갈 때보다 조용히 나왔다"
	quest.2D00C541551763BD.quest_desc: ["파편 9개를 조합해 음반 5를 만드세요. 고대 도시에서 발견한 파편을 완성해 이곳의 이야기를 소리로 확인할 수 있습니다."]
	quest.2D00C541551763BD.quest_subtitle: "음반 5 제작"
	quest.2D00C541551763BD.title: "5번 트랙에는 사연이 있다"
	quest.2D1F854A134D5D8B.quest_desc: ["침대에서 다시 자며 리스폰 지점 설정 방식을 확인하세요. 리스폰 지점을 정해 두면 사망 후 먼 월드 스폰부터 돌아올 필요가 없습니다."]
	quest.2D1F854A134D5D8B.quest_subtitle: "침대로 리스폰 지점 설정"
	quest.2D1F854A134D5D8B.title: "집에 가고 싶다"
	quest.2D2897D8C814E32D.quest_desc: ["엔더맨과 눈을 마주치지 말고 공격받으면 물이나 낮은 지붕을 이용하세요."]
	quest.2D2897D8C814E32D.quest_subtitle: "엔더맨 대응 안내"
	quest.2D2897D8C814E32D.title: "눈을 마주치지 말아요 2"
	quest.2D38DE80A2571C0D.quest_desc: ["워든이 나타나면 소음을 멈추고 거리를 벌려 후퇴하세요. 처치는 필요 없습니다."]
	quest.2D38DE80A2571C0D.quest_subtitle: "워든 출현 시 싸우지 말고 거리 확보"
	quest.2D38DE80A2571C0D.title: "올 것이 왔다"
	quest.2D5DC1F047F7FC82.quest_desc: ["블레이즈 가루로 힘의 물약을 양조하세요. 근접 피해가 크게 올라 보스전과 강한 적을 빠르게 끝낼 수 있습니다."]
	quest.2D5DC1F047F7FC82.quest_subtitle: "힘의 물약"
	quest.2D5DC1F047F7FC82.title: "힘이 장사다"
	quest.2D6274C3059DF1F6.quest_desc: ["핫바의 블록을 선택하고 단단한 면을 향해 사용해 설치하세요. 블록 설치는 거처, 다리와 기계를 만드는 기본 조작입니다."]
	quest.2D6274C3059DF1F6.quest_subtitle: "블록 설치 방법 안내"
	quest.2D6274C3059DF1F6.title: "파괴했으면 책임지고 놓기"
	quest.2D7ED308AB1B6F9F.quest_desc: ["깔때기를 만들고 좁은 출구가 향하는 방향을 확인하세요."]
	quest.2D7ED308AB1B6F9F.quest_subtitle: "호퍼 제작과 이동 방향 설명"
	quest.2D7ED308AB1B6F9F.title: "들어올 때는 마음대로지만"
	quest.2D84BC10F51093E9.quest_desc: ["노출된 엔드 수정을 원거리로 파괴하고 폭발 범위에서 물러나세요."]
	quest.2D84BC10F51093E9.quest_subtitle: "엔드 수정 파괴"
	quest.2D84BC10F51093E9.title: "연결을 끊겠습니다"
	quest.2D8AFCE4D8F7A60F.quest_desc: ["철창 틈으로 쏘거나 탑에 올라 철창 속 수정을 파괴하세요."]
	quest.2D8AFCE4D8F7A60F.quest_subtitle: "철창 수정 처리"
	quest.2D8AFCE4D8F7A60F.title: "철창 안의 수정"
	quest.2D8BC747D4EE1B8F.quest_desc: ["원정이 끝날 때까지 쓸 화살을 넉넉히 챙기세요."]
	quest.2D8BC747D4EE1B8F.quest_subtitle: "화살 제작"
	quest.2D8BC747D4EE1B8F.title: "화살은 넉넉하게"
	quest.2D959C6A688B2451.quest_desc: ["모루에서 호환되는 장비나 마법책을 결합하세요."]
	quest.2D959C6A688B2451.quest_subtitle: "모루 사용"
	quest.2D959C6A688B2451.title: "합치면 더 강해진다"
	quest.2D967FE90D2E9C7A.quest_desc: ["팬텀 막으로 느린 낙하의 물약을 양조하세요. 엔더 드래곤의 공중 띄우기와 높은 구조물에서의 추락사를 막아 줍니다."]
	quest.2D967FE90D2E9C7A.quest_subtitle: "느린 낙하 물약"
	quest.2D967FE90D2E9C7A.title: "천천히 떨어져도 괜찮아"
	quest.2DBF0129446819C9.quest_desc: ["위더를 처치하고 위더 상태 효과에서 살아남으세요. 처치 보상인 네더의 별은 광범위한 강화 효과를 주는 신호기의 핵심입니다."]
	quest.2DBF0129446819C9.quest_subtitle: "위더 처치"
	quest.2DBF0129446819C9.title: "내가 소환하고 내가 잡는다"
	quest.2DD9C2FBCAD2FB64.quest_desc: ["3×3 제작을 사용할 수 있도록 작업대를 만드세요."]
	quest.2DD9C2FBCAD2FB64.quest_subtitle: "작업대 제작"
	quest.2DD9C2FBCAD2FB64.title: "장인은 작업대부터 만든다"
	quest.2DDC0F516A0532CF.quest_desc: ["삼림 대저택을 방마다 안전하게 정리하며 탐색하세요."]
	quest.2DDC0F516A0532CF.quest_subtitle: "삼림 대저택을 찾고 방마다 안전하게 탐색"
	quest.2DDC0F516A0532CF.title: "큰 집에는 사연이 있다"
	quest.2DE6A40EE28846B2.quest_desc: ["부싯돌과 부시를 만들고 목조 건물 근처에서는 사용하지 마세요."]
	quest.2DE6A40EE28846B2.quest_subtitle: "부싯돌과 부시 제작"
	quest.2DE6A40EE28846B2.title: "불장난은 네더에서"
	quest.2DEB7AC25A6BAE43.quest_desc: ["내구도를 수리한 강한 근접 무기를 준비하세요."]
	quest.2DEB7AC25A6BAE43.quest_subtitle: "다이아몬드 무기 권장"
	quest.2DEB7AC25A6BAE43.title: "믿을 만한 한 자루"
	quest.2DFA570C709DACC6.quest_desc: ["집 좌표를 기록하거나 Xaero 웨이포인트를 만드세요. 귀환 지점을 남겨 두면 먼 탐험에서도 기지와 보관품을 잃지 않습니다."]
	quest.2DFA570C709DACC6.quest_subtitle: "좌표 또는 웨이포인트 기록 안내"
	quest.2DFA570C709DACC6.title: "집 나가면 좌표 고생"
	quest.2E210D1406F05126.quest_desc: ["중요 시설에서 멀리 떨어진 단단한 지하 공간을 전장으로 고르세요."]
	quest.2E210D1406F05126.quest_subtitle: "기지와 중요 시설에서 멀리 떨어진 전장 권장"
	quest.2E210D1406F05126.title: "장소 협찬은 지하에서"
	quest.2E32E40B77AEBA19.quest_desc: ["반짝이는 수박 조각으로 즉시 치유의 물약을 양조하세요. 음식으로 회복할 시간이 없는 전투 중 체력을 즉시 되돌릴 수 있습니다."]
	quest.2E32E40B77AEBA19.quest_subtitle: "즉시 치유 물약"
	quest.2E32E40B77AEBA19.title: "원샷 원회복"
	quest.2E4A07D835841C3D.quest_desc: ["드래곤의 숨결 구름은 오래 남으므로 보이면 즉시 벗어나세요."]
	quest.2E4A07D835841C3D.quest_subtitle: "드래곤의 숨결 회피"
	quest.2E4A07D835841C3D.title: "보라색 바닥은 밟는 게 아닙니다"
	quest.2E62538D25B2BA1A.quest_desc: ["첫 드래곤전에는 느린 낙하의 물약을 강력히 권장합니다."]
	quest.2E62538D25B2BA1A.quest_subtitle: "느린 낙하 물약 권장"
	quest.2E62538D25B2BA1A.title: "낙하산 없는 낙하"
	quest.2E62B60378C29777.quest_desc: ["고대 도시 상자에서 메아리 조각을 얻으세요. 메아리 조각은 마지막 사망 위치를 가리키는 복구 나침반의 핵심 재료입니다."]
	quest.2E62B60378C29777.quest_subtitle: "메아리 조각 획득"
	quest.2E62B60378C29777.title: "메아리만 남았습니다"
	quest.2E6961D7675948D1.quest_desc: ["방패, 지형과 원거리 공격을 이용해 피글린 야수를 상대하세요."]
	quest.2E6961D7675948D1.quest_subtitle: "피글린 야수 주의"
	quest.2E6961D7675948D1.title: "말이 통하지 않는 친구"
	quest.2E7D5645B6FFD030.quest_desc: ["동력 레일을 만들고 켜진 구간과 꺼진 구간을 시험하세요. 레드스톤 신호에 따른 가속과 제동을 이해하면 자동 운송선을 설계할 수 있습니다."]
	quest.2E7D5645B6FFD030.quest_subtitle: "전동 레일"
	quest.2E7D5645B6FFD030.title: "다음 역은 자동화역입니다"
	quest.2E9207295388974C.quest_desc: ["진입 발판이 섬과 떨어져 있다면 웅크리고 안전하게 다리를 놓으세요."]
	quest.2E9207295388974C.quest_subtitle: "중앙 섬으로 이동"
	quest.2E9207295388974C.title: "섬까지 안전배송"
	quest.2E9EEB3C8E75E9F1.quest_desc: ["드래곤이 중앙에 앉으면 머리를 공격하고 정면에는 서지 마세요."]
	quest.2E9EEB3C8E75E9F1.quest_subtitle: "드래곤 착지 중 근접 공격 안내"
	quest.2E9EEB3C8E75E9F1.title: "중앙으로 와라"
	quest.2E9F0C91454CA38D.quest_desc: ["바다 폐허를 찾고 산소와 드라운드를 조심하세요."]
	quest.2E9F0C91454CA38D.quest_subtitle: "바다 폐허를 찾고 익사와 드라운드를 조심하며 탐색"
	quest.2E9F0C91454CA38D.title: "물속의 옛날 옛적에"
	quest.2EB38E8623FD1AC3.quest_desc: ["눈은 깨질 수 있고 차원문 틀이 비어 있을 수 있으니 여분을 챙기세요."]
	quest.2EB38E8623FD1AC3.quest_subtitle: "파괴 가능성과 여분 준비 안내"
	quest.2EB38E8623FD1AC3.title: "여분은 배신하지 않는다"
	quest.2EB85E962D885638.quest_desc: ["마법 부여대와 한 칸 띄워 책장 15개를 배치하세요."]
	quest.2EB85E962D885638.quest_subtitle: "책장 배치"
	quest.2EB85E962D885638.title: "지식이 힘이다"
	quest.2EC0EDF6A91A18E4.quest_desc: ["지도 제작대나 제작 칸으로 채워진 지도의 범위를 넓히세요. 넓은 범위를 한 장에 담으면 장거리 탐험 경로를 파악하기 쉽습니다."]
	quest.2EC0EDF6A91A18E4.quest_subtitle: "지도 확장"
	quest.2EC0EDF6A91A18E4.title: "크게 보겠습니다"
	quest.2EC3C2890801629B.quest_desc: ["첫 돌을 캐기 위해 나무 곡괭이를 만드세요."]
	quest.2EC3C2890801629B.quest_subtitle: "나무 곡괭이 제작"
	quest.2EC3C2890801629B.title: "장인은 도구를 탓하지 않는다"
	quest.2EC71B725222CD97.quest_desc: ["난파선의 서로 다른 구역에 있는 상자를 찾아보세요. 보급품과 보물 지도를 얻어 다음 해양 탐험으로 이어갈 수 있습니다."]
	quest.2EC71B725222CD97.quest_subtitle: "난파선을 찾고 구역별 상자를 탐색"
	quest.2EC71B725222CD97.title: "배가 산으로...이 아니라 바다 밑으로"
	quest.2ED272F9C13587AB.quest_desc: ["차원문 방 안이 아닌 가까운 안전한 곳에 리스폰 지점을 설정하세요."]
	quest.2ED272F9C13587AB.quest_subtitle: "근거지에 리스폰 지점 설정"
	quest.2ED272F9C13587AB.title: "죽어도 문 앞에서"
	quest.2ED76AED88E4D480.quest_desc: ["모래를 제련해 안전한 창문에 쓸 유리를 만드세요."]
	quest.2ED76AED88E4D480.quest_subtitle: "유리 제작"
	quest.2ED76AED88E4D480.title: "전망 좋은 집"
	quest.2EEFE6DBCB6451A7.quest_desc: ["엔드 차원문 방을 찾아 안전하게 확보하세요. 주변 몬스터와 용암을 정리해야 장비 점검과 재도전이 가능한 전진 기지가 됩니다."]
	quest.2EEFE6DBCB6451A7.quest_subtitle: "엔드 차원문 방 발견"
	quest.2EEFE6DBCB6451A7.title: "드디어 문 앞입니다"
	quest.2F02AB8F15F0A9B9.quest_desc: ["검은 빠르고 휩쓸기 공격이 있으며 도끼는 느리지만 한 방이 강합니다."]
	quest.2F02AB8F15F0A9B9.quest_subtitle: "무기 차이"
	quest.2F02AB8F15F0A9B9.title: "칼이냐 도끼냐 그것이 문제로다"
	quest.2F0C3875995B9CB2.quest_desc: ["물병에 네더 사마귀를 양조해 어색한 물약을 만드세요. 어색한 물약은 대부분의 유용한 효과 물약이 갈라져 나오는 공통 기반입니다."]
	quest.2F0C3875995B9CB2.quest_subtitle: "어색한 물약 제작"
	quest.2F0C3875995B9CB2.title: "어색한 물약이 시작입니다"
	quest.2F3D4CEF6F117BCF.quest_desc: ["발광석 가루는 여러 효과를 강화하지만 지속 시간을 줄입니다."]
	quest.2F3D4CEF6F117BCF.quest_subtitle: "발광석으로 효과 강화"
	quest.2F3D4CEF6F117BCF.title: "진하게 부탁드립니다"
	quest.2F44CF391D9858AF.quest_desc: ["일반 나침반은 침대가 아니라 월드 스폰을 가리킵니다."]
	quest.2F44CF391D9858AF.quest_subtitle: "나침반이 월드 스폰을 가리킨다는 설명"
	quest.2F44CF391D9858AF.title: "집은 가리키지 않습니다"
	quest.2F4B0C83900ACB1B.quest_desc: ["다이아몬드, 레드스톤과 금을 캘 철 곡괭이를 만드세요."]
	quest.2F4B0C83900ACB1B.quest_subtitle: "철 곡괭이 제작"
	quest.2F4B0C83900ACB1B.title: "철든 곡괭이"
	quest.2F679B2A0765D2ED.quest_desc: ["풀을 부수거나 익은 밀을 수확해 밀 씨앗을 얻으세요. 씨앗 하나가 반복 수확 가능한 안정적인 식량 생산의 시작입니다."]
	quest.2F679B2A0765D2ED.quest_subtitle: "씨앗 획득"
	quest.2F679B2A0765D2ED.title: "작은 씨앗 큰 수확"
	quest.2F8BD40FB53BF0AD.quest_desc: ["다리와 엄폐물에 쓸 단단한 블록을 여러 묶음 챙기세요."]
	quest.2F8BD40FB53BF0AD.quest_subtitle: "건축 블록 준비"
	quest.2F8BD40FB53BF0AD.title: "쌓을 것은 많고 시간은 없다"
	quest.2FA9650FD1A71516.quest_desc: ["먹으면 가까운 곳으로 순간이동하는 후렴과를 채집하세요. 후렴과는 외곽 엔드의 비상식량이며 건축 재료인 퍼퍼 블록으로도 가공됩니다."]
	quest.2FA9650FD1A71516.quest_subtitle: "후렴과 열매 획득"
	quest.2FA9650FD1A71516.title: "먹으면 어디로 갈지 모릅니다"
	quest.2FB23CA24FE081C9.quest_desc: ["마을을 찾고 주민과 작업대를 함부로 공격하거나 부수지 마세요. 주민 거래는 희귀 자원과 원하는 마법책을 안정적으로 얻는 수단입니다."]
	quest.2FB23CA24FE081C9.quest_subtitle: "마을 발견"
	quest.2FB23CA24FE081C9.title: "사람 사는 곳을 찾았다"
	quest.2FB316E5CA0968CA.quest_desc: ["긴 탐험에 나서기 전 익힌 음식을 준비하세요."]
	quest.2FB316E5CA0968CA.quest_subtitle: "익힌 음식 획득"
	quest.2FB316E5CA0968CA.title: "금강산도 식후경"
	quest.2FC0FBEB5C3B3E55.quest_desc: ["엔더 드래곤을 처치하세요. 처치하면 귀환 차원문과 외곽 엔드로 향하는 관문이 열려 바닐라 메인 여정이 완성됩니다."]
	quest.2FC0FBEB5C3B3E55.quest_subtitle: "엔더 드래곤 처치"
	quest.2FC0FBEB5C3B3E55.title: "내가 왕이 될 상인가"
	quest.2FC5F85EF66E9EA5.quest_desc: ["음식, 나무, 블록과 조명을 챙겨 심층암 지대로 내려가세요. 깊은 지하에는 다이아몬드와 레드스톤 같은 다음 단계 자원이 분포합니다."]
	quest.2FC5F85EF66E9EA5.quest_subtitle: "깊은 동굴 진입"
	quest.2FC5F85EF66E9EA5.title: "내려갈 사람은 내려갑니다"
	quest.2FCCC58DED59D45D.quest_desc: ["닭은 씨앗을 따라오며 시간이 지나면 달걀을 낳습니다."]
	quest.2FCCC58DED59D45D.quest_subtitle: "닭과 달걀 안내"
	quest.2FCCC58DED59D45D.title: "닭이 먼저냐 달걀이 먼저냐"
	quest.2FE081C7B890AA53.quest_desc: ["물물교환, 무너진 차원문이나 보루에서 우는 흑요석을 얻으세요. 우는 흑요석은 네더에서 귀환 거점 역할을 하는 리스폰 정박기 재료입니다."]
	quest.2FE081C7B890AA53.quest_subtitle: "우는 흑요석"
	quest.2FE081C7B890AA53.title: "흑요석도 웁니다"
	quest.2FF3AB0A5AD0A84A.quest_desc: ["주민을 돕거나 해치면 평판과 거래 가격이 달라집니다."]
	quest.2FF3AB0A5AD0A84A.quest_subtitle: "평판 설명"
	quest.2FF3AB0A5AD0A84A.title: "소문은 빠릅니다"
	quest.5A0E100000000001.quest_desc: ["Create가 추가하는 아연은 지하 중간 높이에서 철과 비슷한 빈도로 나옵니다. 석기 시대의 거의 모든 공정이 아연에서 출발합니다."]
	quest.5A0E100000000001.quest_subtitle: "원시 아연 1개 획득"
	quest.5A0E100000000001.title: "처음 뵙겠습니다, 아연입니다"
	quest.5A0E100000000002.quest_desc: [
		"원시 아연을 화로에 넣어 아연 주괴로 만드세요."
		"버너, 제조된 철 블록, 손 크랭크까지 이 시대의 주요 제작이 모두 부스러기가 아닌 주괴를 요구합니다."
	]
	quest.5A0E100000000002.quest_subtitle: "아연 주괴 제련"
	quest.5A0E100000000002.title: "구워야 값을 한다"
	quest.5A0E100000000003.quest_desc: ["뼈와 그릇으로 막자사발을 만드세요. 내구도가 16이라 갈수록 닳으며 다 쓰면 다시 만들어야 합니다."]
	quest.5A0E100000000003.quest_subtitle: "막자사발 제작"
	quest.5A0E100000000003.title: "절구가 있어야 절구질을 하지"
	quest.5A0E100000000004.quest_desc: [
		"작업대에 원시 아연과 막자사발을 함께 놓아 아연 부스러기를 만드세요."
		"부스러기는 기계 없이 원광을 가공하는 수단이며 용해로에 바로 넣을 수 있습니다."
	]
	quest.5A0E100000000004.quest_subtitle: "아연 부스러기 제작"
	quest.5A0E100000000004.title: "갈면 갈수록 고와진다"
	quest.5A0E100000000005.quest_desc: [
		"철, 구리, 금 원광도 같은 방식으로 갈 수 있습니다. 울프라마이트는 더 깊은 곳에서 나옵니다."
		"진행에 필수는 아니지만 용해로를 갖춘 뒤 각 금속의 쇳물을 뽑는 데 쓸 수 있습니다."
	]
	quest.5A0E100000000005.quest_subtitle: "철, 구리, 금 부스러기 제작"
	quest.5A0E100000000005.title: "갈 수 있는 건 다 갈아봅시다"
	quest.5A0E100000000006.quest_desc: [
		"모래 4개, 물 양동이 1개와 점토 덩어리 4개로 내화 모르타르를 만드세요. 양동이는 제작 후 돌려받습니다."
		"용해로 대야에 들어가는 내열 재료입니다."
	]
	quest.5A0E100000000006.quest_subtitle: "내화 모르타르 제작"
	quest.5A0E100000000006.title: "불에 강한 반죽"
	quest.5A0E100000000007.quest_desc: [
		"기계식 혼합기를 갖추면 모래 2개, 점토 덩어리 1개와 물 100mb만으로 같은 것을 만들 수 있습니다."
		"손 제작은 기계가 없는 지금을 위한 임시 경로입니다."
	]
	quest.5A0E100000000007.quest_subtitle: "혼합 제작법 안내"
	quest.5A0E100000000007.title: "기계가 있으면 편하긴 하죠"
	quest.5A0E100000000008.quest_desc: ["석재 절단기를 만드세요. 철 블록 가공과 거푸집 변환에 계속 사용합니다."]
	quest.5A0E100000000008.quest_subtitle: "석재 절단기 제작"
	quest.5A0E100000000008.title: "자를 건 자르고 갑시다"
	quest.5A0E100000000009.quest_desc: [
		"석재 절단기에 철 주괴를 넣으면 산업용 철 블록이 2개씩 나옵니다."
		"제조된 철 블록의 재료이며 그 자체로는 건축용입니다."
	]
	quest.5A0E100000000009.quest_subtitle: "산업용 철 블록 4개 획득"
	quest.5A0E100000000009.title: "철도 각을 잡아야 쓴다"
	quest.5A0E10000000000A.quest_desc: [
		"산업용 철 블록을 설치한 뒤 아연 주괴를 들고 우클릭하세요. 제조된 철 블록으로 바뀝니다."
		"야금 기계 다섯 종이 모두 이 블록을 요구합니다."
	]
	quest.5A0E10000000000A.quest_subtitle: "제조된 철 블록 4개 획득"
	quest.5A0E10000000000A.title: "아연 한 스푼의 차이"
	quest.5A0E10000000000B.quest_desc: [
		"아이템을 들고 우클릭하는 이 방식은 Create의 배치기로 그대로 자동화할 수 있습니다."
		"지금은 손으로 하지만 동력이 갖춰지면 벨트 위에서 대량으로 처리하게 됩니다."
		"이 방식은 앞으로 계속 쓰입니다. 케이싱은 아래 등급에 금속을 대서 한 단계씩 올리는데, 그것도 같은 우클릭입니다."
	]
	quest.5A0E10000000000B.quest_subtitle: "아이템 적용 자동화 안내"
	quest.5A0E10000000000B.title: "나중엔 기계가 대신합니다"
	quest.5A0E10000000000C.quest_desc: ["제조된 철 블록 8개와 내화 모르타르 1개로 용해로 대야를 만드세요. 쇳물을 담는 본체입니다."]
	quest.5A0E10000000000C.quest_subtitle: "용해로 대야 제작"
	quest.5A0E10000000000C.title: "쇳물 받을 그릇부터"
	quest.5A0E10000000000D.quest_desc: ["제조된 철 블록 5개로 용해로 뚜껑을 만드세요. 대야 위에 덮어야 제련이 시작됩니다."]
	quest.5A0E10000000000D.quest_subtitle: "용해로 뚜껑 제작"
	quest.5A0E10000000000D.title: "뚜껑을 덮어야 끓는다"
	quest.5A0E10000000000E.quest_desc: [
		"아연 주괴 3개로 기초 버너를 만드세요. 연료를 넣고 부싯돌로 불을 붙여 사용합니다."
		"용해로 대야 아래에 놓아 저온 가열 등급의 열을 공급합니다."
	]
	quest.5A0E10000000000E.quest_subtitle: "기초 버너 제작"
	quest.5A0E10000000000E.title: "불씨는 아래에서부터"
	quest.5A0E10000000000F.quest_desc: [
		"이 모드팩의 제련은 저온 가열과 일반 가열로 나뉩니다. 기초 버너는 저온 가열까지만 공급합니다."
		"석기 시대의 제련과 합금은 모두 저온 가열이면 충분하며, 더 높은 열은 다음 시대에서 다룹니다."
	]
	quest.5A0E10000000000F.quest_subtitle: "열 등급 설명"
	quest.5A0E10000000000F.title: "이 정도 불이면 충분합니다"
	quest.5A0E100000000010.quest_desc: ["제조된 철 블록 5개로 주조 대야를 만드세요. 블록 단위의 큰 주조에 사용합니다."]
	quest.5A0E100000000010.quest_subtitle: "주조 대야 제작"
	quest.5A0E100000000010.title: "굳히기 들어갑니다"
	quest.5A0E100000000011.quest_desc: ["제조된 철 블록 7개로 주조 테이블을 만드세요. 위에 거푸집을 올려 주괴나 판을 뽑습니다."]
	quest.5A0E100000000011.quest_subtitle: "주조 테이블 제작"
	quest.5A0E100000000011.title: "판을 깔아드립니다"
	quest.5A0E100000000014.quest_desc: [
		"내화 모르타르 3블록으로 거푸집을 만드세요. 쇳물을 담아야 하므로 불에 견디는 재료로 만듭니다."
		"이 거푸집이 있어야 쇳물을 다시 아이템으로 되돌릴 수 있습니다."
	]
	quest.5A0E100000000014.quest_subtitle: "내화 모르타르 거푸집 제작"
	quest.5A0E100000000014.title: "쇳물 담을 틀부터"
	quest.5A0E100000000015.quest_desc: [
		"이 거푸집은 주조 한 번마다 사라집니다. 주괴를 뽑을 때마다 새로 만들어야 합니다."
		"내화 모르타르 소비가 커지므로 혼합기를 갖춰 모르타르를 싸게 만드는 편이 결국 이득입니다."
	]
	quest.5A0E100000000015.quest_subtitle: "소모형 거푸집 안내"
	quest.5A0E100000000015.title: "한 번 쓰면 끝입니다"
	quest.5A0E100000000016.quest_desc: ["제조된 철 블록 4개와 아연 주괴 2개로 튼튼한 거품기를 만드세요. 용해로 믹서의 핵심 부품입니다."]
	quest.5A0E100000000016.quest_subtitle: "튼튼한 거품기 제작"
	quest.5A0E100000000016.title: "튼튼해야 오래 젓는다"
	quest.5A0E100000000017.quest_desc: [
		"판자, 아연 주괴, 구리 블록, 껍질 벗긴 원목과 거품기로 용해로 믹서를 만드세요."
		"용해로 대야 위에 설치하고 회전력을 넣으면 합금을 만들 수 있습니다."
	]
	quest.5A0E100000000017.quest_subtitle: "용해로 믹서 제작"
	quest.5A0E100000000017.title: "저어야 섞인다"
	quest.5A0E100000000018.quest_desc: ["판자 3개와 아연 주괴 1개로 손 크랭크를 만드세요. 우클릭으로 잡고 있는 동안만 회전력이 나옵니다."]
	quest.5A0E100000000018.quest_subtitle: "손 크랭크 제작"
	quest.5A0E100000000018.title: "손이 고생할 시간"
	quest.5A0E100000000019.quest_desc: [
		"손 크랭크와 판자로 손 톱니바퀴를 만드세요."
		"손 크랭크는 붙인 면으로만 회전을 내보내지만, 손 톱니바퀴는 톱니처럼 옆으로 물려 방향을 꺾고 여러 기계에 나눠줄 수 있습니다."
	]
	quest.5A0E100000000019.quest_subtitle: "손 톱니바퀴 제작"
	quest.5A0E100000000019.title: "조금 더 편해졌습니다"
	quest.5A0E10000000001A.quest_desc: [
		"크랭크는 사람이 붙어 있어야 하는 임시 동력입니다."
		"이 모드팩에는 물레방아와 풍차가 없습니다. 공짜로 도는 동력은 존재하지 않습니다."
		"안산암 합금 시대에 들어서면 러닝머신으로 동물에게 일을 시키고, 그 뒤에는 화로 엔진으로 연료를 태워 힘을 얻게 됩니다."
	]
	quest.5A0E10000000001A.quest_subtitle: "다음 시대의 동력 안내"
	quest.5A0E10000000001A.title: "언젠간 손을 놓게 됩니다"
	quest.5A0E10000000001B.quest_desc: [
		"용해로 대야에 안산암을 넣고 버너로 가열하면 90mb의 용융 안산암이 나옵니다."
		"합금 한 번에 180mb가 필요하므로 안산암 2개분을 녹여두세요."
	]
	quest.5A0E10000000001B.quest_subtitle: "용융 안산암 확보"
	quest.5A0E10000000001B.title: "돌도 녹으면 흐른다"
	quest.5A0E10000000001C.quest_desc: [
		"아연 부스러기를 녹이면 45mb의 용융 아연이 나옵니다. 합금 한 번에 40mb가 필요합니다."
		"부스러기를 만들어 둔 이유가 여기에 있습니다."
	]
	quest.5A0E10000000001C.quest_subtitle: "용융 아연 확보"
	quest.5A0E10000000001C.title: "부스러기의 쓸모"
	quest.5A0E10000000001D.quest_desc: ["용해로 대야에 믹서를 얹고 회전력을 넣으세요. 용융 안산암 180mb와 용융 아연 40mb가 합쳐져 용융 안산암 합금 180mb가 됩니다."]
	quest.5A0E10000000001D.quest_subtitle: "용융 안산암 합금 생산"
	quest.5A0E10000000001D.title: "섞어야 단단해진다"
	quest.5A0E10000000001E.quest_desc: [
		"주조 테이블에 내화 모르타르 거푸집을 올리고 용융 안산암 합금을 90mb 부으면 안산암 합금이 나옵니다."
		"석기 시대의 목표 지점이며 Create 기계 대부분의 기본 재료입니다."
	]
	quest.5A0E10000000001E.quest_subtitle: "안산암 합금 획득"
	quest.5A0E10000000001E.title: "드디어 안산암 합금"
	quest.5A0E10000000001F.quest_desc: [
		"안산암 합금을 자력으로 만들 수 있게 되었습니다. 이제 손으로 돌리던 공정을 기계에 넘길 차례입니다."
		"안산암 합금 시대 퀘스트라인에서 자동 동력원과 기본 Create 기계를 다룹니다."
	]
	quest.5A0E10000000001F.quest_subtitle: "안산암 합금 시대 안내"
	quest.5A0E10000000001F.title: "다음 시대로 가는 문"
	quest.5A0E100000000020.quest_desc: [
		"내화 모르타르 블록을 석재 절단기에 넣어 곡괭이 거푸집을 만드세요."
		"거푸집은 모양만 정하므로, 같은 거푸집으로 어느 금속이든 뽑을 수 있습니다."
	]
	quest.5A0E100000000020.quest_subtitle: "내화 모르타르 곡괭이 거푸집 제작"
	quest.5A0E100000000020.title: "곡괭이 모양으로 파내기"
	quest.5A0E100000000021.quest_desc: [
		"주조 테이블에 거푸집을 올리고 용융 안산암 합금 270mb를 부으세요. 주괴 세 개분입니다."
		"내화 모르타르 거푸집은 이 한 번으로 소모됩니다. 흑연 거푸집은 소모되지 않지만 아직 만들 수 없습니다."
	]
	quest.5A0E100000000021.quest_subtitle: "안산암 합금 곡괭이 머리 주조"
	quest.5A0E100000000021.title: "머리부터 뽑는다"
	quest.5A0E100000000022.quest_desc: [
		"머리에 막대 두 개를 이어 곡괭이를 완성하세요."
		"제련된 도구는 내구도가 다해도 사라지지 않고 부서진 상태로 남습니다. 모루에 해당 광물 하나를 넣으면 완전히 되살아납니다."
	]
	quest.5A0E100000000022.quest_subtitle: "제련된 안산암 합금 곡괭이 제작"
	quest.5A0E100000000022.title: "손잡이만 꽂으면 완성"
	quest.5A0E100000000023.quest_desc: [
		"제련된 도구는 쓸수록 숙련도가 붙습니다. 최대 3단계까지 오르며 성능과 최대 내구도가 함께 늘어납니다."
		"티어가 높을수록 익는 데 오래 걸립니다. 안산암 합금은 100회, 네더라이트는 500회를 써야 첫 단계에 도달합니다."
	]
	quest.5A0E100000000023.quest_subtitle: "숙련도 안내"
	quest.5A0E100000000023.title: "쓸수록 손에 익는다"
	quest.5A0E100000000024.quest_desc: [
		"껍질 벗긴 원목에 안산암 합금을 대면 안산암 케이싱이 됩니다."
		"모든 케이싱의 시작점입니다. 구리 케이싱은 여기에 구리를, 황동 케이싱은 다시 구리 케이싱에 황동을 대서 올립니다."
		"앞으로 만들 기계 대부분이 케이싱을 요구합니다. 안산암 합금을 손에 넣었다는 것은 그 사슬이 열렸다는 뜻입니다."
	]
	quest.5A0E100000000024.quest_subtitle: "안산암 케이싱 제작"
	quest.5A0E100000000024.title: "모든 기계의 껍데기"
	quest.5A0E110000000001.quest_desc: [
		"안산암 합금을 세로로 세 칸 놓으면 축 6개가 나옵니다. 석재 절단기에 안산암 합금을 넣어도 됩니다."
		"축은 회전을 직선으로 나르기만 합니다. 방향을 꺾거나 속도를 바꾸려면 톱니바퀴가 필요합니다."
		"이 시대의 모든 기계가 축 아니면 톱니바퀴로 물립니다. 넉넉히 만들어 두세요."
	]
	quest.5A0E110000000001.quest_subtitle: "축 8개 제작"
	quest.5A0E110000000001.title: "일단 막대기부터"
	quest.5A0E110000000002.quest_desc: [
		"축 하나에 판자 넷을 둘러 톱니바퀴를 만듭니다."
		"톱니바퀴는 옆으로 맞물려 회전을 90도 꺾고, 여러 갈래로 나눠 줍니다. 같은 크기끼리 맞물리면 속도가 그대로입니다."
	]
	quest.5A0E110000000002.quest_subtitle: "톱니바퀴 8개 제작"
	quest.5A0E110000000002.title: "이빨을 맞춰봅시다"
	quest.5A0E110000000003.quest_desc: [
		"톱니바퀴에 판자를 더 둘러 큰 톱니바퀴를 만듭니다."
		"작은 톱니와 큰 톱니를 맞물리면 속도가 절반으로 떨어지고, 반대로 걸면 두 배가 됩니다. 속도가 변하면 응력 소모도 함께 변합니다."
		"Crude 티어의 상한은 32 RPM입니다. 이 시대에는 속도를 올리는 쪽보다 낮춰서 응력을 아끼는 쪽이 자주 쓰입니다."
	]
	quest.5A0E110000000003.quest_subtitle: "큰 톱니바퀴 2개 제작"
	quest.5A0E110000000003.title: "덩치가 클수록 느긋합니다"
	quest.5A0E110000000004.quest_desc: [
		"안산암 케이싱을 톱니바퀴로 감싸 기어박스를 만듭니다."
		"축을 네 방향 어디로든 꺾어 보낼 수 있습니다. 톱니바퀴를 늘어놓는 것보다 자리를 훨씬 덜 먹습니다."
	]
	quest.5A0E110000000004.quest_subtitle: "기어박스 제작"
	quest.5A0E110000000004.title: "모퉁이를 도는 법"
	quest.5A0E110000000005.quest_desc: [
		"클러치는 레드스톤 신호를 받으면 회전을 끊고, 기어시프트는 회전 방향을 뒤집습니다."
		"동력이 귀한 시대입니다. 쓰지 않는 기계를 클러치로 끊어 두면 그만큼 응력이 남습니다."
	]
	quest.5A0E110000000005.quest_subtitle: "클러치와 기어시프트 제작"
	quest.5A0E110000000005.title: "끄고 켜고 되감고"
	quest.5A0E110000000006.quest_desc: [
		"말린 켈프 두 개로 벨트를 만듭니다. 축 두 개를 차례로 우클릭하면 그 사이에 벨트가 깔립니다."
		"벨트는 물건을 나르는 동시에 회전도 함께 전달합니다."
		"고무 시트로 만드는 벨트 제작법도 있지만, 지금은 켈프 쪽이 훨씬 쌉니다."
	]
	quest.5A0E110000000006.quest_subtitle: "기계식 벨트 제작"
	quest.5A0E110000000006.title: "말린 켈프의 재발견"
	quest.5A0E110000000007.quest_desc: [
		"안산암 케이싱과 벨트, 축으로 러닝머신을 만듭니다."
		"위에 동물을 올려두면 회전이 나옵니다. 앞쪽에 먹이를 든 채로 서 있거나 유인용 아이템을 놓아두면 계속 걷습니다."
		"물레방아와 풍차는 이 모드팩에 없습니다. 손 크랭크에서 벗어나는 첫 걸음이 이것입니다."
	]
	quest.5A0E110000000007.quest_subtitle: "러닝머신 제작"
	quest.5A0E110000000007.title: "누군가는 뛰어야 합니다"
	quest.5A0E110000000009.quest_desc: [
		"러닝머신은 동물이 멈추면 회전도 멈춥니다. 울타리로 가두고 유인 아이템을 앞에 두면 오래 갑니다."
		"동물 한 마리가 내는 응력에는 한계가 있습니다. 부족하면 러닝머신을 여러 대 놓고 톱니바퀴로 합치세요."
		"이 시대의 동력은 모두 32 RPM을 넘지 못합니다. 속도가 아니라 응력을 늘리는 방향으로 설계해야 합니다."
	]
	quest.5A0E110000000009.quest_subtitle: "동력 유지 요령"
	quest.5A0E110000000009.title: "월급 대신 사료"
	quest.5A0E11000000000A.quest_desc: [
		"손 톱니바퀴와 안산암 케이싱, 돌로 RPM 맷돌을 만듭니다."
		"원래의 맷돌 제작법은 막혀 있습니다. 이 모드팩의 가공 기계는 전부 RPM을 보는 기계로 바뀌었습니다."
		"맷돌은 위에서 아이템을 넣고 아래에서 꺼냅니다. 원광을 갈아 분쇄 원광으로 만드는 것이 주된 용도입니다."
	]
	quest.5A0E11000000000A.quest_subtitle: "RPM 맷돌 제작"
	quest.5A0E11000000000A.title: "손으로 갈던 시절이여 안녕"
	quest.5A0E11000000000B.quest_desc: [
		"RPM 기계는 레시피마다 최소 회전 속도가 정해져 있습니다. 이 모드팩의 기본값은 32 RPM입니다."
		"그보다 느리면 처리가 되다 마는 것이 아니라 아예 시작조차 하지 않습니다. 응력이 남아돌아도 속도가 모자라면 소용없습니다."
		"같은 재료에 최소 RPM이 다른 레시피가 여러 개 걸려 있을 수 있습니다. 이때는 현재 속도를 넘지 않는 것 중 가장 높은 쪽이 선택됩니다. 빠를수록 좋은 결과가 나온다는 뜻입니다."
	]
	quest.5A0E11000000000B.quest_subtitle: "최소 RPM 개념"
	quest.5A0E11000000000B.title: "느리면 아예 안 돕니다"
	quest.5A0E11000000000C.quest_desc: [
		"축과 안산암 케이싱에 철 블록을 더해 RPM 압착기를 만듭니다."
		"압착기는 아래에 벨트나 디포를 두고 그 위에 매답니다. 대야 위에 두면 압축 레시피도 처리합니다."
		"구리 판이 여기서 나옵니다. 구리 판은 구리 케이싱으로, 구리 케이싱은 이 시대의 나머지 전부로 이어집니다."
	]
	quest.5A0E11000000000C.quest_subtitle: "RPM 압착기 제작"
	quest.5A0E11000000000C.title: "납작하게 만들어 드립니다"
	quest.5A0E11000000000D.quest_desc: [
		"철 판 두 장과 안산암 합금으로 프로펠러를 만듭니다. 철 판은 압착기로 뽑습니다."
		"프로펠러 하나만으로는 아무것도 못 합니다. 케이싱에 넣어야 합니다."
	]
	quest.5A0E11000000000D.quest_subtitle: "프로펠러 제작"
	quest.5A0E11000000000D.title: "바람을 만들 준비"
	quest.5A0E11000000000E.quest_desc: [
		"안산암 케이싱에 프로펠러와 축을 붙여 인케이스드 팬을 만듭니다."
		"팬 앞에 물, 용암, 불, 얼음을 두면 그 성질이 바람에 실려 앞쪽 아이템에 적용됩니다. 세척, 제련, 훈연, 응고가 전부 이 하나로 처리됩니다."
		"팬은 RPM 기계가 아니라 원래 Create 방식 그대로 돕니다."
	]
	quest.5A0E11000000000E.quest_subtitle: "인케이스드 팬 제작"
	quest.5A0E11000000000E.title: "선풍기가 아닙니다"
	quest.5A0E11000000000F.quest_desc: [
		"팬 아래에 물을 두고 그 앞으로 아이템을 흘리면 세척이 됩니다."
		"분쇄 원광을 세척하면 조각이 나오고, 확률로 부산물이 따라옵니다. 철에서는 레드스톤, 금에서는 석영, 아연에서는 화약, 구리에서는 점토가 나옵니다."
		"자갈에서 부싯돌, 붉은 모래에서 금 조각도 세척으로 얻습니다. 초반 자원난을 푸는 가장 싼 수단입니다."
	]
	quest.5A0E11000000000F.quest_subtitle: "세척 공정 이해"
	quest.5A0E11000000000F.title: "물로 씻으면 뭐가 나옵니다"
	quest.5A0E110000000010.quest_desc: [
		"맷돌에 원광을 넣으면 분쇄 원광이 나옵니다. 이것을 제련하면 주괴 하나, 세척하면 조각 여러 개와 부산물이 나옵니다."
		"분쇄 후 세척이 원광을 그냥 제련하는 것보다 이득입니다. 대신 기계와 동력이 필요합니다."
		"막자사발로 만드는 부스러기와는 다른 물건입니다. 부스러기는 초반용이고 광물 손해가 납니다."
	]
	quest.5A0E110000000010.quest_subtitle: "분쇄 원광 8개 확보"
	quest.5A0E110000000010.title: "광석은 두 번 일합니다"
	quest.5A0E110000000011.quest_desc: [
		"이 모드팩의 분쇄 레시피에는 다른 금속의 부스러기가 낮은 확률로 섞여 나옵니다."
		"철에서 아연이, 구리에서 금이, 금에서 구리가, 아연에서 철이 나옵니다. 텅스텐 원광에서는 철이 나옵니다."
		"한 종류만 캐고 있어도 다른 금속이 조금씩 쌓입니다. 부스러기는 용해로에 넣어 녹이면 됩니다."
	]
	quest.5A0E110000000011.quest_subtitle: "교차 부산물 안내"
	quest.5A0E110000000011.title: "덤으로 딸려오는 것들"
	quest.5A0E110000000012.quest_desc: [
		"구리 주괴를 압착기에 넣으면 구리 판이 나옵니다."
		"구리 판은 케이싱, 유체 파이프, 유체 탱크, 수액 채취기에 전부 들어갑니다. 이 시대에 가장 많이 쓰는 중간재입니다."
		"주조 테이블에 흑연 판 거푸집을 올리고 용융 구리를 부어도 같은 것이 나옵니다."
	]
	quest.5A0E110000000012.quest_subtitle: "구리 판 8개 제작"
	quest.5A0E110000000012.title: "구리를 얇게 펴는 시간"
	quest.5A0E110000000013.quest_desc: [
		"원목에 구리를 대는 원래 제작법은 막혀 있습니다. 안산암 케이싱에 구리 주괴를 대야 구리 케이싱이 됩니다."
		"전개기로 대거나, 주조 대야에 안산암 케이싱을 놓고 용융 구리 90mb를 부어도 됩니다. 두 경로 모두 같은 순서를 따릅니다."
		"케이싱은 이 모드팩의 시대 관문입니다. 안산암, 구리, 황동 순서를 건너뛸 방법은 없습니다."
	]
	quest.5A0E110000000013.quest_subtitle: "구리 케이싱 제작"
	quest.5A0E110000000013.title: "껍데기 한 단계 위로"
	quest.5A0E110000000014.quest_desc: ["철 판과 안산암 합금으로 휘스크를 만듭니다. 혼합기의 회전 날입니다."]
	quest.5A0E110000000014.quest_subtitle: "휘스크 제작"
	quest.5A0E110000000014.title: "거품기 아닙니다"
	quest.5A0E110000000015.quest_desc: [
		"톱니바퀴와 구리 케이싱, 휘스크로 RPM 혼합기를 만듭니다. 대야 위에 매달아야 작동합니다."
		"구리 케이싱을 요구하므로 압착기와 케이싱 사슬을 모두 지난 뒤에야 손에 들어옵니다. 이 시대의 후반부 관문입니다."
		"혼합기가 생기면 안산암 합금을 직접 섞어 만들 수 있게 되어 용해로 왕복이 줄어듭니다."
	]
	quest.5A0E110000000015.quest_subtitle: "RPM 혼합기 제작"
	quest.5A0E110000000015.title: "이제 섞을 수 있습니다"
	quest.5A0E110000000016.quest_desc: [
		"안산암 케이싱과 톱니바퀴, 구리 판 세 장으로 수액 채취기를 만듭니다."
		"나무 줄기 옆에 붙이고 톱니바퀴로 돌리면 수지가 나옵니다. 잎이 붙어 있는 살아 있는 나무여야 합니다."
		"손으로 심어 놓은 잎은 인정되지 않습니다. 자연 생성 나무나 묘목이 자란 나무만 됩니다. 채취기를 너무 붙여 놓으면 서로 효율을 깎아먹습니다."
	]
	quest.5A0E110000000016.quest_subtitle: "수액 채취기 제작"
	quest.5A0E110000000016.title: "나무한테 빨대를 꽂읍시다"
	quest.5A0E110000000017.quest_desc: [
		"채취기 뒤쪽에서 수지를 뽑아냅니다. 유체 파이프와 기계식 펌프로 옮기거나, 양동이로 직접 퍼도 됩니다."
		"유체 파이프는 구리 주괴와 구리 판, 펌프는 톱니바퀴와 파이프면 됩니다. 구리 케이싱은 필요 없습니다."
	]
	quest.5A0E110000000017.quest_subtitle: "수지 확보"
	quest.5A0E110000000017.title: "끈적한 수확"
	quest.5A0E110000000018.quest_desc: [
		"인더스트리얼 아이언 블록과 안산암 합금 블록, 축으로 압축기를 만듭니다. 인더스트리얼 아이언 블록은 철 주괴를 석재 절단기에 넣으면 두 개씩 나옵니다."
		"옆에서 축으로 돌리되 오른쪽에서 봤을 때 시계 방향이어야 합니다. 거꾸로 돌면 아무 일도 일어나지 않습니다."
		"유체는 뒤에서 넣고 결과물은 앞의 디포나 벨트, 대야로 받습니다."
	]
	quest.5A0E110000000018.quest_subtitle: "압축기 제작"
	quest.5A0E110000000018.title: "꾹 눌러 담기"
	quest.5A0E110000000019.quest_desc: [
		"압축기에 수지 500mb를 넣으면 고무가 나옵니다."
		"아래에 화로를 놓아 예열하면 같은 수지로 두 배가 나옵니다. 석기 시대에 만든 기본 버너면 충분합니다."
		"꽃을 압축해 만드는 경로도 있지만 64 RPM을 요구합니다. 이 시대의 32 RPM으로는 돌릴 수 없습니다."
	]
	quest.5A0E110000000019.quest_subtitle: "고무 8개 제작"
	quest.5A0E110000000019.title: "드디어 물렁한 것"
	quest.5A0E11000000001A.quest_desc: [
		"고무를 압착기에 넣으면 고무 시트가 됩니다."
		"화로 엔진의 몸통 여섯 자리가 전부 고무 시트입니다. 넉넉히 뽑아 두세요."
		"벨트, 안산암 깔때기, 안산암 터널도 고무 시트로 만들 수 있습니다."
	]
	quest.5A0E11000000001A.quest_subtitle: "고무 시트 8개 제작"
	quest.5A0E11000000001A.title: "펴야 쓸모가 생깁니다"
	quest.5A0E11000000001B.quest_desc: [
		"점토 한 덩이를 석탄 여덟 개로 둘러싸면 흑연이 됩니다."
		"흑연은 거푸집의 재료입니다. 석기 시대의 내화 모르타르 거푸집과 달리 소모되지 않고 계속 쓸 수 있습니다."
	]
	quest.5A0E11000000001B.quest_subtitle: "흑연 제작"
	quest.5A0E11000000001B.title: "석탄 여덟 개의 운명"
	quest.5A0E11000000001C.quest_desc: [
		"흑연을 압착기에 넣으면 빈 거푸집이 됩니다. 이것을 석재 절단기에 넣어 주괴, 판, 막대, 톱니, 조각 거푸집으로 바꿉니다."
		"석재 절단기로 서로 오갈 수 있으니 하나만 만들어 두고 필요할 때 모양을 바꾸면 됩니다."
	]
	quest.5A0E11000000001C.quest_subtitle: "흑연 주괴 거푸집 제작"
	quest.5A0E11000000001C.title: "모양을 정해드립니다"
	quest.5A0E11000000001D.quest_desc: [
		"석탄을 화로나 용광로에 넣으면 코크스가 나옵니다."
		"코크스는 강철 합금화의 재료이자 그 자체로 좋은 연료입니다. 아홉 개를 뭉쳐 블록으로 보관하면 자리를 덜 먹습니다."
	]
	quest.5A0E11000000001D.quest_subtitle: "코크스 16개 확보"
	quest.5A0E11000000001D.title: "석탄보다 뜨겁게"
	quest.5A0E11000000001E.quest_desc: [
		"용해로에 철을 녹여 용융 철을 만들고, 예열 상태에서 코크스를 더해 합금화하면 용융 강철이 나옵니다. 철 270mb에 코크스 하나입니다."
		"주조 테이블에 흑연 주괴 거푸집을 올리고 용융 강철 90mb를 부으면 강철 주괴가 됩니다."
		"화로 엔진의 심장 자리에 강철 주괴가 들어갑니다."
	]
	quest.5A0E11000000001E.quest_subtitle: "강철 주괴 4개 제작"
	quest.5A0E11000000001E.title: "철보다 강한 철"
	quest.5A0E11000000001F.quest_desc: ["고무 시트 여섯 장으로 몸통을 두르고 강철 주괴, 구리 케이싱, 피스톤을 넣습니다. 일반 제작대에서 만듭니다.", "엔진만으로는 동력이 나가지 않습니다. 강철 주괴 여덟 개로 축 하나를 감싸 플라이휠도 함께 만드세요. 원본은 황동을 요구하지만 이 모드팩은 강철로 바꿔 두었습니다.", "화로·용광로·훈연기의 옆면에만 붙습니다. 정면과 윗면은 안 되고, 화로 하나에 엔진 하나뿐입니다.", "엔진에서 바깥으로 두 칸 떨어진 자리에 플라이휠을 놓습니다. 사이 한 칸은 비워 둡니다. 플라이휠 축은 엔진이 뻗은 방향과 나란하면 안 되고 세로로도 놓을 수 없습니다.", "화로 옆에 구리 블록을 붙이면 방열판으로 인식합니다. 이때 32 RPM에 1024 SU가 나오며, Crude 티어의 상한과 정확히 같습니다.", "방열판이 없으면 40 RPM으로 돌아 Crude 티어의 32 RPM 상한을 넘깁니다. 구리 블록을 반드시 붙이세요."]
	quest.5A0E11000000001F.quest_subtitle: "화로 엔진 제작"
	quest.5A0E11000000001F.title: "불을 때서 돌립니다"
	quest.5A0E110000000020.quest_desc: ["엔진은 1 RPM으로 시동해 15틱마다 목표 속도의 12분의 1씩 올라갑니다. 기본 설정이라면 10초쯤 뒤에 목표 속도에 닿습니다.", "고글을 쓰면 엔진에 값 패널이 떠서 현재 RPM과 부하를 볼 수 있습니다. 응력계를 따로 달지 않아도 됩니다.", "더 필요하면 엔진을 늘려 톱니바퀴로 합치면 됩니다. 다만 속도는 여전히 32 RPM에서 막힙니다.", "황동 시대로 넘어가면 Rough 티어가 열려 64 RPM에 2048 SU까지 올라갑니다. 분쇄 바퀴와 증기 기관이 그때부터입니다."]
	quest.5A0E110000000020.quest_subtitle: "응력 한계 확인"
	quest.5A0E110000000020.title: "이 시대의 천장"
	quest.5A0E110000000021.quest_desc: [
		"안산암 케이싱과 안산암 합금, 철 주괴로 기계식 드릴을 만듭니다."
		"회전을 주면 앞의 블록을 계속 캡니다. 기계식 베어링이나 밧줄 도르래에 얹어 움직이는 채굴기를 만들 수 있습니다."
	]
	quest.5A0E110000000021.quest_subtitle: "기계식 드릴 제작 (선택)"
	quest.5A0E110000000021.title: "손목 보호 장비"
	quest.5A0E110000000022.quest_desc: [
		"안산암 케이싱과 철 판, 철 주괴로 기계식 톱을 만듭니다."
		"위를 보게 놓으면 통나무를 판자로 켜고, 옆을 보게 놓으면 앞의 나무를 벱니다. 아래에 벨트를 두면 자동 목재 농장이 됩니다."
	]
	quest.5A0E110000000022.quest_subtitle: "기계식 톱 제작 (선택)"
	quest.5A0E110000000022.title: "나무는 알아서 눕습니다"
	quest.5A0E110000000023.quest_desc: [
		"디포는 아이템 한 칸을 얹어 두는 받침대입니다. 압착기 아래에 두면 벨트 없이도 가공이 됩니다."
		"슈트는 아래위로 아이템을 떨구는 통로입니다. 상자와 벨트를 세로로 잇습니다."
	]
	quest.5A0E110000000023.quest_subtitle: "디포와 슈트 제작 (선택)"
	quest.5A0E110000000023.title: "물건을 놓아둘 자리"
	quest.5A0E110000000024.quest_desc: [
		"깔때기는 벨트와 보관함 사이에서 아이템을 옮깁니다. 렌치로 방향을 뒤집을 수 있습니다."
		"터널은 벨트 위에 씌워 아이템을 갈래로 나눕니다. 안산암 터널은 나누기만 하고 조건은 걸 수 없습니다."
	]
	quest.5A0E110000000024.quest_subtitle: "안산암 깔때기와 터널 제작 (선택)"
	quest.5A0E110000000024.title: "알아서 빨아들이게"
	quest.5A0E110000000025.quest_desc: [
		"안산암 케이싱과 철 판, 양털로 밧줄 도르래를 만듭니다."
		"회전을 주면 아래에 붙은 구조물을 통째로 올리고 내립니다. 드릴을 매달면 수직 채굴기가 됩니다."
	]
	quest.5A0E110000000025.quest_subtitle: "밧줄 도르래 제작 (선택)"
	quest.5A0E110000000025.title: "위아래로도 움직입니다"
	quest.5A0E110000000026.quest_desc: [
		"안산암 케이싱과 축, 나무 반 블록으로 기계식 베어링을 만듭니다."
		"붙인 구조물을 통째로 회전시킵니다. 접착제로 블록을 묶어 두면 함께 돕니다."
	]
	quest.5A0E110000000026.quest_subtitle: "기계식 베어링 제작 (선택)"
	quest.5A0E110000000026.title: "통째로 돌려버리기"
	quest.5A0E110000000027.quest_desc: [
		"안산암 케이싱과 유리, 축으로 기계식 압출기를 만듭니다."
		"양옆에 물과 용암을 두면 조약돌이 무한히 나옵니다. 촉매를 바꾸면 안산암, 화강암, 섬록암, 심층암, 흑요석까지 뽑을 수 있습니다."
		"맷돌과 압착기에 넣을 돌을 대는 가장 싼 방법입니다."
	]
	quest.5A0E110000000027.quest_subtitle: "기계식 압출기 제작 (선택)"
	quest.5A0E110000000027.title: "돌은 무한합니다"
	quest.5A0E110000000028.quest_desc: [
		"용해로에서 구리와 아연을 각각 녹인 뒤 예열 상태에서 합금하면 용융 황동이 나옵니다. 구리 10mb에 아연 10mb로 황동 20mb, 정확히 반반입니다."
		"예열이 필요합니다. 기본 버너는 저온 등급이라 그대로는 모자라니 최대 RPM 팬을 쏴서 강화하거나 블레이즈 버너를 쓰세요."
		"주조 테이블에 흑연 주괴 거푸집을 올리면 주괴가 나오고, 주조 대야에 810mb를 그냥 부으면 거푸집 없이 황동 블록이 나옵니다."
	]
	quest.5A0E110000000028.quest_subtitle: "야금 경로로 황동 만들기"
	quest.5A0E110000000028.title: "쇳물끼리 섞는 법"
	quest.5A0E110000000029.quest_desc: [
		"대야에 구리 주괴와 아연 주괴를 하나씩 넣고 RPM 혼합기를 돌리면 황동 주괴가 두 개 나옵니다."
		"이쪽도 예열이 필요하고 32 RPM을 채워야 합니다. 대신 쇳물을 거치지 않아 공정이 훨씬 짧습니다."
		"야금 경로와 결과는 같습니다. 갖춰 놓은 설비가 있는 쪽을 쓰면 됩니다."
	]
	quest.5A0E110000000029.quest_subtitle: "기계 경로로 황동 만들기"
	quest.5A0E110000000029.title: "믹서가 있으면 한 번에"
	quest.5A0E11000000002A.quest_desc: [
		"두 경로 중 어느 쪽이든 하나만 세우면 됩니다."
		"황동은 다음 시대의 기본 재료입니다. 황동 판, 황동 블록, 전자 튜브가 전부 여기서 나옵니다."
		"다만 황동 주괴를 손에 넣었다고 황동 시대가 열린 것은 아닙니다. 관문은 케이싱입니다."
	]
	quest.5A0E11000000002A.quest_subtitle: "황동 주괴 8개 확보"
	quest.5A0E11000000002A.title: "구리와 아연의 결혼"
	quest.5A0E11000000002B.quest_desc: ["구리 케이싱에 강철 주괴를 대면 강철 케이싱이 됩니다. 전개기로 대도 되고, 주조 대야에 구리 케이싱을 놓고 용융 강철 90mb를 부어도 됩니다.", "케이싱 사슬 한가운데에 강철이 끼어 있습니다. 야금 라인을 세우지 않으면 황동 케이싱에 닿을 수 없다는 뜻입니다.", "화로 엔진도 강철을 요구합니다. 이 시대의 마지막 두 목표가 같은 재료를 놓고 경쟁합니다."]
	quest.5A0E11000000002B.quest_subtitle: "강철 케이싱 제작"
	quest.5A0E11000000002B.title: "구리만으론 부족합니다"
	quest.5A0E11000000002C.quest_desc: ["강철 케이싱에 황동 주괴를 대면 황동 케이싱이 됩니다. 전개기로도, 주조 대야에 용융 황동 90mb를 부어도 됩니다.", "안산암 합금 시대의 결승선입니다. 석기 시대가 안산암 케이싱으로 끝났듯 이 시대는 황동 케이싱으로 끝납니다.", "분쇄 바퀴, 증기 기관, 기계식 팔 — 황동 시대의 실질 콘텐츠는 전부 이 블록 뒤에 있습니다. 케이싱 사슬을 여기까지 끌고 왔다면 준비가 끝난 것입니다."]
	quest.5A0E11000000002C.quest_subtitle: "황동 케이싱 제작"
	quest.5A0E11000000002C.title: "다음 시대의 껍데기"
	quest.7A1B100000000002.quest_desc: [
		"같은 음식만 먹으면 손해입니다. 처음 먹어보는 음식이 쌓일수록 최대 체력이 늘어납니다."
		"20단계로 나뉘어 있으며 400종에 도달하면 하트 20개가 더해져 최대 30개가 됩니다. 죽어도 사라지지 않습니다."
		"이 모드팩에는 요리가 800종이 넘습니다. 오래 두고 채우는 목표로 잡으세요."
	]
	quest.7A1B100000000002.quest_subtitle: "서로 다른 음식으로 최대 체력 늘리기"
	quest.7A1B100000000002.title: "골고루 먹어야 큽니다"
	quest.7A1B100000000003.quest_desc: [
		"반지, 부적, 벨트 같은 물건은 인벤토리가 아니라 전용 슬롯에 들어갑니다. 인벤토리 화면 옆의 버튼으로 엽니다."
		"장신구를 손에 들고 우클릭해도 빈 슬롯에 바로 착용됩니다."
	]
	quest.7A1B100000000003.quest_subtitle: "장신구 슬롯 열어보기"
	quest.7A1B100000000003.title: "반지는 어디에 끼우나요"
	quest.7A1B100000000004.quest_desc: [
		"던전에서 나오는 고대 서적을 쓰면 인챈트를 원래 최대 레벨보다 한 단계 더 올릴 수 있습니다."
		"효율 VI, 보호 V처럼 평소에는 볼 수 없는 등급이 나옵니다."
	]
	quest.7A1B100000000004.quest_subtitle: "고대 서적 알아두기"
	quest.7A1B100000000004.title: "최대 레벨이 최대가 아닙니다"
	quest.7A1B100000000005.quest_desc: [
		"죽으면 그 자리에 시체가 남고 소지품이 그대로 담깁니다. 돌아가서 우클릭하면 전부 돌려받습니다."
		"죽은 위치는 사망 기록 화면에서 다시 확인할 수 있습니다. 좌표를 적어두지 않아도 됩니다."
		"다만 시체가 용암에 빠지는 것까지 막아주지는 않습니다. 위험한 곳에서는 여전히 조심해야 합니다."
	]
	quest.7A1B100000000005.quest_subtitle: "Corpse로 소지품 되찾기"
	quest.7A1B100000000005.title: "죽어도 짐은 남습니다"
	quest.7A1B100000000006.quest_desc: [
		"JEI 검색창에서 접두어를 쓰면 원하는 것만 걸러낼 수 있습니다."
		"@ 는 모드 이름, # 은 태그, $ 는 툴팁을 찾습니다. 앞에 - 를 붙이면 제외하고, | 로 여러 조건을 묶습니다."
		"이 모드팩에서는 모드 이름과 태그 검색에 접두어가 반드시 필요합니다. 색상과 ID 검색은 꺼두었습니다."
	]
	quest.7A1B100000000006.quest_subtitle: "JEI 검색 접두어 익히기"
	quest.7A1B100000000006.title: "찾다가 지치셨나요"
	quest.7A1B100000000007.quest_desc: [
		"F7 을 누르면 몹이 생성될 수 있는 자리가 화면에 표시됩니다. 거점에 조명을 놓을 때 씁니다."
		"F9 는 청크 경계를 보여줍니다. 건축을 정렬하거나 청크 단위 장치를 놓을 때 유용합니다."
	]
	quest.7A1B100000000007.quest_subtitle: "밝기와 청크 경계 표시하기"
	quest.7A1B100000000007.title: "어디서 튀어나올지 미리 압니다"
	quest.7A1B100000000008.quest_desc: [
		"원, 구, 직선 같은 도형을 월드에 안내선으로 띄웁니다. 실제 블록이 아니라 표시일 뿐입니다."
		"손으로 곡면을 쌓을 때 눈대중으로 하던 작업이 훨씬 수월해집니다."
	]
	quest.7A1B100000000008.quest_subtitle: "Build Guide로 안내선 띄우기"
	quest.7A1B100000000008.title: "눈대중은 그만"
	quest.7A1B100000000009.quest_desc: [
		"시선을 돌리지 않아도 발밑이나 눈앞의 빈 자리에 블록이 이어서 놓입니다."
		"다리를 놓거나 벽을 따라갈 때 카메라를 계속 내리지 않아도 됩니다."
	]
	quest.7A1B100000000009.quest_subtitle: "이어 놓기 익히기"
	quest.7A1B100000000009.title: "안 보고도 놓습니다"
	quest.7A1B10000000000A.quest_desc: [
		"상자를 연 상태에서 아이템을 Shift 클릭하면 한 칸씩이 아니라 같은 종류가 통째로 넘어갑니다."
		"Ctrl 을 누른 채 좌클릭하면 한 개만 옮깁니다. Shift 좌클릭은 화면 밖으로 한 번에 버립니다."
		"Sophisticated 계열 상자에서는 [ 로 넣고 ] 로 꺼냅니다. 창고를 정리할 때 시간이 크게 줄어듭니다."
	]
	quest.7A1B10000000000A.quest_subtitle: "일괄 이동 단축키 익히기"
	quest.7A1B10000000000A.title: "정리는 한 방에"
	quest.7A1B10000000000B.quest_desc: [
		"방어구를 들고 우클릭하면 바로 입혀지고, 입고 있던 것과 자리가 바뀝니다."
		"단축바 구성 자체를 통째로 바꾸는 기능도 있습니다. 채굴용과 전투용을 나눠두면 편합니다."
	]
	quest.7A1B10000000000B.quest_subtitle: "빠른 착용과 단축바 전환"
	quest.7A1B10000000000B.title: "입는 데 3초도 아깝다"
	quest.7A1B10000000000C.quest_desc: [
		"다 자란 작물을 우클릭하면 수확과 재파종이 한 번에 끝납니다. 괭이를 들면 넓게 처리됩니다."
		"밭을 부수고 다시 심을 필요가 없습니다."
	]
	quest.7A1B10000000000C.quest_subtitle: "작물 거두고 다시 심기"
	quest.7A1B10000000000C.title: "부수지 말고 눌러요"
	quest.7A1B10000000000D.quest_desc: [
		"셜커 상자를 내용물이 든 채로 접을 수 있습니다."
		"반 블록 두 개를 온전한 블록으로 되돌리는 것도 됩니다. 남는 반 블록을 정리할 때 씁니다."
	]
	quest.7A1B10000000000D.quest_subtitle: "보관 블록 되돌리기"
	quest.7A1B10000000000D.title: "짐 쌀 땐 접어서"
	quest.7A1B10000000000E.quest_desc: [
		"사다리에서 웅크리면 빠르게 미끄러져 내려옵니다. 깊은 수직 갱도를 오르내릴 때 시간이 크게 줄어듭니다."
		"두 짝으로 된 문은 한쪽만 열어도 같이 열립니다."
	]
	quest.7A1B10000000000E.quest_subtitle: "사다리와 문 조작"
	quest.7A1B10000000000E.title: "내려갈 땐 미끄럼틀"
	quest.7A1B10000000000F.quest_desc: [
		"쓰던 도구가 부서지면 인벤토리에 있는 같은 도구가 자동으로 손에 들어옵니다."
		"제련된 도구는 부서져도 사라지지 않고 부서진 상태로 남으니, 모루에서 재료 하나로 되살리면 됩니다."
	]
	quest.7A1B10000000000F.quest_subtitle: "자동 도구 보충 확인하기"
	quest.7A1B10000000000F.title: "부서져도 손은 안 빕니다"
	quest.7A1B100000000018.quest_desc: [
		"지정한 키를 누른 채 블록을 캐면 붙어 있는 같은 종류가 함께 캐집니다."
		"나무를 벨 때와 광맥을 캘 때 특히 체감이 큽니다. 스킬 트리의 채굴 갈래에서 한 번에 캐는 개수를 늘릴 수 있습니다."
	]
	quest.7A1B100000000018.quest_subtitle: "일괄 채굴 단축키 익히기"
	quest.7A1B100000000018.title: "곡괭이 한 번에 광맥 하나"
	quest.7A1B100000000019.quest_desc: [
		"연결된 Create 부품을 한 번에 뜯고 다시 놓습니다."
		"배치를 갈아엎을 때 하나씩 부수던 시간이 사라집니다."
	]
	quest.7A1B100000000019.quest_subtitle: "Create 부품 일괄 해체"
	quest.7A1B100000000019.title: "뜯을 땐 통째로"
	quest.7A1B10000000001A.quest_desc: [
		"발견한 웨이스톤을 등록하면 목록에서 골라 그 자리로 이동합니다."
		"거점과 광산, 마을을 이어두면 먼 거리 왕복이 사라집니다."
	]
	quest.7A1B10000000001A.quest_subtitle: "웨이스톤 등록하고 이동하기"
	quest.7A1B10000000001A.title: "걸어 다니지 맙시다"
	quest.7A1B10000000001B.quest_desc: [
		"같은 축에 승강기 블록을 여러 개 놓으면 점프와 웅크리기로 층 사이를 오갑니다."
		"사다리 없이 높은 탑을 오르내릴 수 있습니다. 층마다 하나씩만 놓으면 됩니다."
	]
	quest.7A1B10000000001B.quest_subtitle: "승강기 블록 쌓기"
	quest.7A1B10000000001B.title: "층 사이는 순간이동"
	quest.7A1B10000000001C.quest_desc: [
		"침낭은 리스폰 지점을 바꾸지 않고 밤만 넘깁니다."
		"탐험 중에 거점을 옮기고 싶지 않을 때 씁니다. 죽으면 원래 침대로 돌아갑니다."
	]
	quest.7A1B10000000001C.quest_subtitle: "침낭과 해먹 써보기"
	quest.7A1B10000000001C.title: "오늘 밤은 여기서"
	quest.7A1B10000000001D.quest_desc: [
		"나침반으로 원하는 구조물이나 생물 군계의 위치를 검색할 수 있습니다."
		"특정 자원을 찾아 무작정 헤맬 필요가 없습니다."
	]
	quest.7A1B10000000001D.quest_subtitle: "구조물과 생물 군계 찾기"
	quest.7A1B10000000001D.title: "헤매지 말고 물어보세요"
	quest.7A1B10000000001E.quest_desc: [
		"넓은 면을 한 번에 채우고, 복사한 구조물을 그대로 붙여넣습니다."
		"설정 화면은 키를 누르고 있어야 열립니다. 눌렀다 떼면 닫힙니다."
	]
	quest.7A1B10000000001E.quest_subtitle: "Building Gadgets 다뤄보기"
	quest.7A1B10000000001E.title: "손으로 쌓는 시대는 갔다"
	quest.7A1B10000000001F.quest_desc: [
		"같은 평면의 블록을 이어서 확장합니다."
		"가젯보다 가볍고 초반부터 쓸 수 있어 바닥이나 벽을 넓힐 때 좋습니다."
	]
	quest.7A1B10000000001F.quest_subtitle: "Construction Sticks 써보기"
	quest.7A1B10000000001F.title: "쭉 밀면 됩니다"
	quest.7A1B100000000020.quest_desc: [
		"Chipped는 작업대 종류마다 다루는 재료가 다릅니다. 석공 작업대에서 돌 계열을 수십 가지 변형으로 바꿉니다."
		"목재는 목수 작업대, 유리와 양털은 각각 다른 작업대에서 다룹니다. 돌 하나로도 벽면 질감을 다양하게 쓸 수 있습니다."
	]
	quest.7A1B100000000020.quest_subtitle: "Chipped 작업대 만들기"
	quest.7A1B100000000020.title: "돌도 화장을 합니다"
	quest.7A1B100000000021.quest_desc: [
		"원하는 형태에 원하는 블록의 겉모습을 입힙니다."
		"게임에 없는 모양의 블록을 직접 만들어 쓸 수 있습니다. 계단 모양 황동 블록 같은 것도 됩니다."
	]
	quest.7A1B100000000021.quest_subtitle: "카피캣과 프레임 블록"
	quest.7A1B100000000021.title: "속은 몰라도 겉은 완벽"
	quest.7A1B100000000022.quest_desc: [
		"의자, 탁자, 식기, 커튼처럼 생활감을 주는 목제 가구를 만듭니다."
		"의자에는 실제로 앉을 수 있습니다."
	]
	quest.7A1B100000000022.quest_subtitle: "Handcrafted 가구 만들기"
	quest.7A1B100000000022.title: "빈 집에 살 순 없잖아요"
	quest.7A1B100000000023.quest_desc: [
		"소파, 주방 설비, 전자제품 같은 현대적 가구를 제공합니다."
		"일부는 실제로 동작합니다. 냉장고에 음식을 넣고 우편함으로 물건을 받을 수 있습니다."
	]
	quest.7A1B100000000023.quest_subtitle: "Refurbished Furniture 살펴보기"
	quest.7A1B100000000023.title: "우리 집에도 냉장고를"
	quest.7A1B100000000024.quest_desc: [
		"크기를 자유롭게 정해 그림을 겁니다. 바닐라 그림처럼 무작위로 정해지지 않습니다."
		"원하는 이미지를 직접 등록할 수도 있습니다."
	]
	quest.7A1B100000000024.quest_subtitle: "Immersive Paintings 써보기"
	quest.7A1B100000000024.title: "내 그림을 걸어봅시다"
	quest.7A1B100000000025.quest_desc: [
		"금고, 표지판 기둥, 선반, 수도꼭지와 항아리, 모래시계, 게시판까지 소품 대부분이 여기 있습니다."
		"비누로 밀랍과 염색을 지울 수 있다는 것도 알아두면 유용합니다."
	]
	quest.7A1B100000000025.quest_subtitle: "Supplementaries 둘러보기"
	quest.7A1B100000000025.title: "이것도 있고 저것도 있고"
	quest.7A1B100000000026.quest_desc: [
		"벽걸이 랜턴, 솥 상호작용, 머리 장식 배치, 기울어진 표지판처럼 바닐라 블록의 배치와 조작을 넓힙니다."
		"새 블록을 추가하는 것이 아니라 이미 있던 것을 더 쓸 수 있게 만듭니다."
	]
	quest.7A1B100000000026.quest_subtitle: "Amendments 변경점 확인하기"
	quest.7A1B100000000026.title: "있던 것을 더 쓰게"
	quest.7A1B100000000027.quest_desc: [
		"염료 16색 램프와 조명 블록을 제공합니다."
		"횃불과 광원 블록만으로는 안 나오는 실내 분위기를 색으로 맞출 수 있습니다."
	]
	quest.7A1B100000000027.quest_subtitle: "Simply Light 램프 만들기"
	quest.7A1B100000000027.title: "분위기 있는 집의 조건"
	quest.7A1B100000000028.quest_desc: [
		"원하는 음악을 담은 음반을 만들고 휴대용 재생기로 들고 다닙니다."
		"거점에 틀어둘 배경음을 직접 고를 수 있습니다."
	]
	quest.7A1B100000000028.quest_subtitle: "Etched 각인대 써보기"
	quest.7A1B100000000028.title: "내 노래 좀 들어볼래?"
	quest.7A1B100000000029.quest_desc: ["채팅에 콜론으로 감싼 이름을 넣으면 이모지가 나옵니다. 입력 중에 자동완성이 뜹니다."]
	quest.7A1B100000000029.quest_subtitle: "Emojiful 입력하기"
	quest.7A1B100000000029.title: "말보다 빠른 표정"
	quest.7A1B10000000002A.quest_desc: [
		"페일 가든과 크리킹, 반딧불 덤불, 낙엽, 말린 가스트처럼 상위 버전 콘텐츠를 이 버전에서 씁니다."
		"건축 재료가 그만큼 늘어납니다."
	]
	quest.7A1B10000000002A.quest_subtitle: "Vanilla Backport 콘텐츠 알아두기"
	quest.7A1B10000000002A.title: "미래에서 왔습니다"
	quest.7A1B10000000002B.quest_desc: [
		"아이템을 위쪽으로 밀어 올립니다."
		"깔때기는 아래로만 보내기 때문에 수직으로 올리려면 물길이나 기계가 필요했는데, 이걸로 해결됩니다."
	]
	quest.7A1B10000000002B.quest_subtitle: "Uppers 설치하기"
	quest.7A1B10000000002B.title: "중력을 거스르는 깔때기"
	quest.7A1B10000000002C.quest_desc: [
		"휴대용 자석은 주변에 떨어진 아이템을 인벤토리로 당깁니다. 채굴 중에 줍는 수고가 사라집니다."
		"설치형 자석은 한곳으로 모아주므로 간단한 수거 장치를 만들 수 있습니다."
	]
	quest.7A1B10000000002C.quest_subtitle: "Simple Magnets 써보기"
	quest.7A1B10000000002C.title: "줍는 건 이제 그만"
	quest.7A1B10000000002D.quest_desc: [
		"마켓에서 에메랄드로 씨앗과 가축을 삽니다. 없는 작물을 찾아 헤맬 필요가 없습니다."
		"비옥한 흙과 급수기로 농장 관리 부담도 줄어듭니다."
	]
	quest.7A1B10000000002D.quest_subtitle: "Farming for Blockheads 마켓 짓기"
	quest.7A1B10000000002D.title: "농사도 자본주의"
	quest.7A1B10000000002E.quest_desc: [
		"거슬리는 소리를 종류별로 음소거합니다. 기계 소음이나 몹 소리를 골라서 끌 수 있습니다."
		"차음 블록을 놓으면 특정 구역의 소리만 줄어듭니다."
	]
	quest.7A1B10000000002E.quest_subtitle: "Extreme Sound Muffler 설정하기"
	quest.7A1B10000000002E.title: "조용히 좀 합시다"
	quest.7A1B10000000002F.quest_desc: [
		"경험치를 블록에 넣어두었다가 필요할 때 꺼냅니다."
		"위험한 곳에 가기 전에 맡겨두면 죽어도 잃지 않습니다."
	]
	quest.7A1B10000000002F.quest_subtitle: "경험치 오벨리스크 세우기"
	quest.7A1B10000000002F.title: "경험치 적금"
	quest.7A1B100000000030.quest_desc: [
		"성능은 그대로 두고 겉모습만 다른 방어구로 보이게 합니다. 모자도 따로 씁니다."
		"장식용으로 입은 장비는 내구도가 닳지 않습니다."
	]
	quest.7A1B100000000030.quest_subtitle: "겉모습만 바꿔 입기"
	quest.7A1B100000000030.title: "성능은 그대로, 핏은 내 맘대로"
	quest.7A1B100000000031.quest_desc: [
		"찾는 아이템이 들어 있는 상자를 화면에 표시합니다."
		"창고가 커진 뒤에 진가를 발휘합니다. 상자를 하나씩 열어볼 필요가 없습니다."
	]
	quest.7A1B100000000031.quest_subtitle: "FindMe로 아이템 찾기"
	quest.7A1B100000000031.title: "분명 어딘가에 뒀는데"
	quest.7A1B100000000032.quest_desc: [
		"채굴, 전투, 생활, 탐험 네 갈래의 스킬 트리가 있습니다."
		"탭마다 포인트가 따로 쌓입니다. 캔 블록은 채굴에, 먹은 음식은 생활에 들어가므로 놀던 방식대로 성장합니다."
	]
	quest.7A1B100000000032.quest_subtitle: "스킬 트리 열어보기"
	quest.7A1B100000000032.title: "포인트가 쌓이고 있습니다"
	quest.7A1B100000000033.quest_desc: [
		"앉을 수 있는 의자입니다. 피스톤으로 밀어도 앉은 채로 따라갑니다."
		"위에 블록을 올리면 탁자로 바뀝니다. 의자 하나로 두 가지를 씁니다."
	]
	quest.7A1B100000000033.quest_subtitle: "Quark 의자 놓아보기"
	quest.7A1B100000000033.title: "잠깐 앉았다 가시죠"
	quest.7A1B100000000034.quest_desc: [
		"들어온 신호를 왼쪽이나 오른쪽으로 무작위하게 내보냅니다."
		"확률 장치나 무작위 선택이 필요한 회로에서 씁니다."
	]
	quest.7A1B100000000034.quest_subtitle: "레드스톤 무작위기 만들기"
	quest.7A1B100000000034.title: "운에 맡기는 회로"
	quest.7A1B100000000035.quest_desc: [
		"깔때기나 발사기가 넣어준 아이템을 바로 아래 땅으로 떨어뜨립니다."
		"아이템을 밖으로 내보내기만 하면 될 때 깔때기보다 간단합니다."
	]
	quest.7A1B100000000035.quest_subtitle: "슈트로 아이템 떨구기"
	quest.7A1B100000000035.title: "싸구려 깔때기"
	quest.7A1B100000000036.quest_desc: [
		"플레이어가 눈의 중심을 얼마나 정확히 바라보는지에 따라 레드스톤 신호를 냅니다."
		"시선으로 작동하는 비밀 문을 만들 수 있습니다."
	]
	quest.7A1B100000000036.quest_subtitle: "엔더 워쳐 설치하기"
	quest.7A1B100000000036.title: "쳐다보면 압니다"
	quest.7A1B100000000037.quest_desc: [
		"레드스톤 신호를 받아야 떨어지고, 옆에 붙은 것들까지 데려갑니다."
		"떨어질 곳이 없으면 오히려 위로 떠오릅니다. 비교기로 읽으면 항상 15를 냅니다."
	]
	quest.7A1B100000000037.quest_subtitle: "중력모래 다뤄보기"
	quest.7A1B100000000037.title: "거꾸로 떨어지는 모래"
	quest.7A1B100000000038.quest_desc: [
		"곡괭이 부메랑입니다. 던지면 맞은 것을 캐고 전리품까지 챙겨서 돌아옵니다."
		"인챈트도 걸립니다. 플레임랑은 화염 피해를 더합니다."
	]
	quest.7A1B100000000038.quest_subtitle: "픽카랑과 플레임랑 만들기"
	quest.7A1B100000000038.title: "던졌으면 돌아와야지"
	quest.7A1B100000000039.quest_desc: [
		"작은 슬라임에게 양동이를 쓰면 담깁니다."
		"슬라임 청크 안에 들어가면 양동이 속에서 뛰기 시작합니다. 청크를 찾는 도구인 셈입니다."
	]
	quest.7A1B100000000039.quest_subtitle: "슬라임 담아보기"
	quest.7A1B100000000039.title: "양동이 속 말랑이"
	quest.7A1B10000000003A.quest_desc: [
		"구름 높이까지 올라가서 유리병을 쓰면 담깁니다."
		"허공에 대고 우클릭하면 임시 블록이 생겨 그 위에 블록을 놓을 수 있습니다. 고공 작업의 발판입니다."
	]
	quest.7A1B10000000003A.quest_subtitle: "구름 병 얻기"
	quest.7A1B10000000003A.title: "착지는 부드럽게"
	quest.7A1B10000000003B.quest_desc: [
		"단축바에 있는 블록 중 하나를 무작위로 골라 놓습니다."
		"같은 블록을 여러 칸에 두면 그만큼 자주 나옵니다. 비율을 조절해 자연스러운 질감을 만듭니다."
	]
	quest.7A1B10000000003B.quest_subtitle: "모종삽 만들기"
	quest.7A1B10000000003B.title: "대충 깔아도 예쁘게"
	quest.7A1B10000000003C.quest_desc: [
		"한 종류의 씨앗이나 묘목을 잔뜩 담습니다. 우클릭으로 넣고 뺍니다."
		"들고만 있어도 떨어진 씨앗을 알아서 줍고, 블록에 쓰면 3x3으로 심습니다."
	]
	quest.7A1B10000000003C.quest_subtitle: "씨앗 주머니 만들기"
	quest.7A1B10000000003C.title: "씨앗은 한 칸이면 충분"
	quest.7A1B10000000003D.quest_desc: [
		"블록에 쓰고 다른 블록을 보면 두 지점 사이의 거리를 알려줍니다. 48블록까지 됩니다."
		"대칭 건축이나 일정 간격 배치에서 하나씩 세지 않아도 됩니다."
	]
	quest.7A1B10000000003D.quest_subtitle: "주판 만들기"
	quest.7A1B10000000003D.title: "세지 말고 재세요"
	quest.7A1B10000000003E.quest_desc: [
		"깃펜에 적힌 생물 군계를 찾아줍니다."
		"제작이 아니라 지도 제작자나 떠돌이 상인에게서 거래로 얻습니다."
	]
	quest.7A1B10000000003E.quest_subtitle: "개척자의 깃펜 구하기"
	quest.7A1B10000000003E.title: "어디로 가야 하죠"
	quest.7A1B10000000003F.quest_desc: [
		"소울 샌드 계곡의 망령이 떨굽니다."
		"쓰면 가장 가까운 네더 요새 쪽으로 날아갑니다. 요새를 헤매지 않아도 됩니다."
	]
	quest.7A1B10000000003F.quest_subtitle: "소울 구슬 얻기"
	quest.7A1B10000000003F.title: "요새로 가는 나침반"
	quest.7A1B100000000040.quest_desc: [
		"지하 깊은 곳의 잊혀진 자가 떨굽니다."
		"장비가 강하고 여러 방식으로 싸우니 조심하십시오. 모자는 그 증표입니다."
	]
	quest.7A1B100000000040.quest_subtitle: "잊혀진 자의 모자 얻기"
	quest.7A1B100000000040.title: "잊혀진 자의 유품"
	quest.7A1B100000000041.quest_desc: [
		"아이템을 넣으면 액자 테두리가 사라지고 아이템만 떠 있는 것처럼 보입니다."
		"액자를 뚫고 우클릭하면 뒤에 있는 상자가 그대로 열립니다. 창고 앞에 붙여 내용물을 표시해도 여닫는 데 지장이 없습니다."
		"깃발과 방패는 따로 처리되고, 바닥에 놓인 표지판과도 딱 맞게 붙습니다."
	]
	quest.7A1B100000000041.quest_subtitle: "유리 아이템 액자 만들기"
	quest.7A1B100000000041.title: "테두리는 거들 뿐"
	reward.6B00000000000000.title: "0장 루트 보상"
	reward.6B00000000000001.title: "1장 루트 보상"
	reward.6B00000000000002.title: "2장 루트 보상"
	reward.6B00000000000003.title: "3장 루트 보상"
	reward.6B00000000000004.title: "4장 루트 보상"
	reward.6B00000000000005.title: "5장 루트 보상"
	reward.6B00000000000006.title: "6장 루트 보상"
	reward.6B00000000000007.title: "7장 루트 보상"
	reward.6B00000000000008.title: "8장 루트 보상"
	reward.6B00000000000009.title: "9장 루트 보상"
	reward.6B0000000000000A.title: "10장 루트 보상"
	reward.6B0000000000000B.title: "11장 루트 보상"
